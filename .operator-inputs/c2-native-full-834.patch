+//! Owner-admitted startup authority and exact scoped publication authorization.
+use crate::contract::*;
+use serde::{Deserialize, Serialize};
+use std::collections::{BTreeMap, BTreeSet};
+use std::path::PathBuf;
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ModelBinding {
+    pub provider: String,
+    pub provider_kind: String,
+    pub model: String,
+    pub effort: String,
+}
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Scope {
+    pub schema: String,
+    pub owner: String,
+    pub recipe_id: String,
+    pub repo: PathBuf,
+    pub task_state: PathBuf,
+    pub repository_id: String,
+    pub source_commit: String,
+    pub source_content_digest: String,
+    pub repository: String,
+    pub destination_repository_id: u64,
+    pub actor_id: u64,
+    pub actor_login: String,
+    pub branch_prefix: String,
+    pub base: String,
+    #[serde(deserialize_with = "super::contract::unique")]
+    pub grants: BTreeSet<Grant>,
+    pub templates: BTreeMap<String, BTreeMap<String, ModelBinding>>,
+    pub limits: Limits,
+    pub max_repairs: u32,
+    pub expires_unix_ms: u64,
+}
+impl Scope {
+    pub fn validate(&self) -> Result<()> {
+        require(
+            self.schema == "af/implementation-startup-scope@2",
+            "Unsupported implementation startup scope",
+        )?;
+        name(&self.owner)?;
+        for value in [
+            &self.repository_id,
+            &self.repository,
+            &self.actor_login,
+            &self.base,
+        ] {
+            text(value)?;
+        }
+        require(
+            af_contracts::is_digest(&self.recipe_id)
+                && af_contracts::is_digest(&self.source_content_digest),
+            "Invalid startup identity",
+        )?;
+        require(
+            self.repo.is_absolute()
+                && self.repo.components().all(|c| {
+                    !matches!(
+                        c,
+                        std::path::Component::ParentDir | std::path::Component::CurDir
+                    )
+                }),
+            "Startup repository must be absolute and normalized",
+        )?;
+        require(
+            self.source_commit.len() == 40
+                && self.source_commit.bytes().all(|b| b.is_ascii_hexdigit()),
+            "Startup source must be an exact commit",
+        )?;
+        require(
+            self.destination_repository_id > 0
+                && self.actor_id > 0
+                && self.expires_unix_ms > 0
+                && self.expires_unix_ms <= af_contracts::json::SAFE_INTEGER_MAX as u64,
+            "Invalid startup actor or expiry",
+        )?;
+        require(
+            self.branch_prefix.ends_with('/')
+                && !self.branch_prefix.starts_with('/')
+                && !self.branch_prefix.contains("..")
+                && self
+                    .branch_prefix
+                    .bytes()
+                    .all(|b| b.is_ascii_alphanumeric() || b"/-_".contains(&b)),
+            "Invalid startup branch namespace",
+        )?;
+        require(
+            self.task_state.is_absolute()
+                && !self.task_state.starts_with(&self.repo)
+                && self.task_state.components().all(|c| {
+                    !matches!(
+                        c,
+                        std::path::Component::ParentDir | std::path::Component::CurDir
+                    )
+                }),
+            "Startup Task Store must be external and normalized",
+        )?;
+        self.limits.validate()?;
+        require(
+            self.max_repairs <= 16
+                && !self.templates.is_empty()
+                && self.templates.len() <= 256
+                && self.grants.len() <= 32,
+            "Invalid startup bounds",
+        )?;
+        for (id, bindings) in &self.templates {
+            require(
+                af_contracts::is_digest(id) && !bindings.is_empty() && bindings.len() <= 256,
+                "Invalid startup template pool",
+            )?;
+            for binding in bindings.values() {
+                require(
+                    binding.provider == "codex-personal" && binding.provider_kind == "codex",
+                    "Startup requires codex-personal",
+                )?;
+                text(&binding.model)?;
+                text(&binding.effort)?;
+            }
+        }
+        for grant in &self.grants {
+            require(
+                grant.destination == format!("github:{}", self.repository)
+                    && matches!(
+                        grant.operation,
+                        Operation::PrepareCandidateV1
+                            | Operation::PublishPr
+                            | Operation::PublishImplementationPrV1
+                            | Operation::Observe
+                            | Operation::CleanupWorkspaceV1
+                    ),
+                "Startup operation or destination is outside implementation scope",
+            )?;
+        }
+        Ok(())
+    }
+    pub fn admits(&self, bundle: &Bundle) -> Result<()> {
+        self.validate()?;
+        require(
+            self.recipe_id == hash(bundle)?,
+            "Startup recipe differs from the complete effective bundle",
+        )?;
+        let mut templates = BTreeSet::new();
+        let mut grants = BTreeSet::new();
+
+        for definition in bundle.definitions.values() {
+            require(
+                definition.limits.within(&self.limits),
+                "Startup recipe exceeds scope budgets",
+            )?;
+            grants.extend(definition.authority.grants.iter().cloned());
+            require(
+                definition.authority.task_plans.is_empty() && definition.admission.is_none(),
+                "Startup requires fresh implementation templates without roadmap admission",
+            )?;
+            for step in &definition.steps {
+                match &step.operation {
+                    Kind::Task { .. } => {
+                        return Err("Startup refuses pre-existing Task execution".into());
+                    }
+                    Kind::FreshTask { template, .. } => {
+                        require(
+                            template.state == self.task_state
+                                && template.repo == self.repo
+                                && template.repository_id == self.repository_id
+                                && template.authority_commit == self.source_commit
+                                && template.source_content_digest == self.source_content_digest,
+                            "Startup template source differs",
+                        )?;
+                        templates.insert(template.id()?);
+                    }
+                    _ => {}
+                }
+            }
+        }
+        fn count(bundle: &Bundle, name: &str, depth: u32) -> Result<u32> {
+            require(depth <= 16, "Startup recipe recursion refused")?;
+            let definition = bundle
+                .definitions
+                .get(name)
+                .ok_or("Startup child missing")?;
+            definition.steps.iter().try_fold(0_u32, |total, step| {
+                let n = match &step.operation {
+                    Kind::FreshTask { .. } => 1,
+                    Kind::Scenario { scenario } => count(bundle, scenario, depth + 1)?,
+                    _ => 0,
+                };
+                total
+                    .checked_add(
+                        n.checked_mul(u32::from(step.max_attempts))
+                            .ok_or("Startup repair count overflow")?,
+                    )
+                    .ok_or_else(|| "Startup repair count overflow".into())
+            })
+        }
+        let tasks = count(bundle, &bundle.root, 0)?;
+        require(
+            tasks > 0 && tasks <= self.limits.max_dispatches,
+            "Startup recipe exceeds total Task dispatch bound",
+        )?;
+        require(
+            templates == self.templates.keys().cloned().collect() && grants == self.grants,
+            "Startup template or operation pool differs",
+        )
+    }
+    pub fn live(&self, host: &dyn crate::Host) -> Result<()> {
+        require(
+            host.authorization_time()? < self.expires_unix_ms,
+            "Implementation startup scope expired",
+        )
+    }
+}
+
+/// Complete preflight is separate from replay: inspection validates retained identities without
+/// invoking credentials; live admission and every drive recheck native and machine prerequisites.
+pub fn preflight(host: &dyn crate::Host, pin: &Pin) -> Result<()> {
+    let Some(scope) = &pin.policy.implementation_startup else {
+        return Ok(());
+    };
+    scope.admits(&pin.bundle)?;
+    scope.live(host)?;
+    for definition in pin.bundle.definitions.values() {
+        for step in &definition.steps {
+            if let Kind::FreshTask { template, .. } = &step.operation {
+                host.preflight_implementation_template(
+                    template,
+                    &scope.templates[&template.id()?],
+                )?;
+            }
+        }
+    }
+    for adapter in scope
+        .grants
+        .iter()
+        .map(|g| &g.adapter)
+        .collect::<BTreeSet<_>>()
+    {
+        let installed = pin
+            .policy
+            .adapters
+            .get(adapter)
+            .ok_or("Startup adapter missing")?;
+        host.preflight_implementation_adapter(installed, scope)?;
+    }
+    scope.live(host)
+}
+
+/// A read-only live capability check. Only an intent in the retained owner-confirmed Run can
+/// supply authority; an adapter request, copied receipt or caller-selected scope cannot.
+pub fn authorize<'a>(
+    world: &'a crate::store::World,
+    request: &crate::adapter::Request,
+    now: u64,
+    live: bool,
+) -> Result<(&'a crate::state::Run, &'a Scope)> {
+    require(
+        request.schema == "af/scenario-adapter-request@6"
+            && request.operation == Operation::PublishImplementationPrV1
+            && matches!(
+                request.method,
+                crate::adapter::Method::Execute | crate::adapter::Method::Reconcile
+            ),
+        "Expected scoped implementation publication",
+    )?;
+    let mut found = None;
+    for run in world.runs.values() {
+        for (path, frame) in &run.frames {
+            let definition = &run.pin.bundle.definitions[&frame.scenario];
+            for progress in &frame.steps {
+                let Some(intent) = progress
+                    .intents
+                    .last()
+                    .filter(|i| i.id == request.intent_id)
+                else {
+                    continue;
+                };
+                require(found.is_none(), "Ambiguous scoped intent")?;
+                let scope = run
+                    .pin
+                    .policy
+                    .implementation_startup
+                    .as_ref()
+                    .ok_or("No admitted startup scope")?;
+                scope.admits(&run.pin.bundle)?;
+                let step = definition
+                    .steps
+                    .iter()
+                    .find(|s| s.id == progress.step)
+                    .ok_or("Missing scoped step")?;
+                let Kind::Action {
+                    grant,
+                    requires_decision: false,
+                    required_condition: None,
+                } = &step.operation
+                else {
+                    return Err("Not a scoped publication Action".into());
+                };
+                let inputs = step
+                    .inputs
+                    .iter()
+                    .map(|(k, b)| Ok((k.clone(), run.resolve(path, b)?)))
+                    .collect::<Result<BTreeMap<_, _>>>()?;
+                require(
+                    grant.operation == request.operation
+                        && grant.destination == request.destination
+                        && scope.grants.contains(grant)
+                        && inputs == request.inputs
+                        && hash(&(step, &inputs))? == request.input_digest
+                        && intent.input_digest == request.input_digest,
+                    "Scoped publication intent or input differs",
+                )?;
+                require(
+                    !live
+                        || (run.status.active()
+                            && run.cancellation.is_none()
+                            && progress.status.active()
+                            && matches!(
+                                intent.phase,
+                                crate::state::Phase::Prepared | crate::state::Phase::Uncertain
+                            )
+                            && now < scope.expires_unix_ms
+                            && now < progress.deadline_unix_ms
+                            && now < run.created_unix_ms.saturating_add(run.limits.max_wall_ms)),
+                    "Scoped publication expired, cancelled, fenced or inactive",
+                )?;
+                if live {
+                    for (ancestor, parent) in &run.frames {
+                        if path == ancestor || path.starts_with(&format!("{ancestor}/")) {
+                            let limits = &run.pin.bundle.definitions[&parent.scenario].limits;
+                            require(
+                                now < parent.started_unix_ms.saturating_add(limits.max_wall_ms),
+                                "Scoped parent frame deadline reached",
+                            )?;
+                            for invocation in &parent.steps {
+                                let full = format!("{ancestor}/{}", invocation.step);
+                                if path == &full || path.starts_with(&format!("{full}/")) {
+                                    require(
+                                        now < invocation.deadline_unix_ms,
+                                        "Scoped parent invocation expired",
+                                    )?;
+                                }
+                            }
+                        }
+                    }
+                }
+                for key in ["candidate", "verification"] {
+                    let Some(Datum::Task(receipt)) = inputs.get(key) else {
+                        return Err("Scoped native receipt absent".into());
+                    };
+                    require(
+                        run.fresh_tasks.values().any(|t| {
+                            t.task_id == receipt.task_id
+                                && t.revision_id == receipt.revision_id
+                                && t.plan_id == receipt.plan_id
+                                && t.repo == scope.repo
+                                && t.state == scope.task_state
+                        }),
+                        "Scoped receipt belongs to another Run or plan",
+                    )?;
+                }
+                found = Some((run, scope));
+            }
+        }
+    }
+    found.ok_or_else(|| "No retained scoped publication intent".into())
+}
