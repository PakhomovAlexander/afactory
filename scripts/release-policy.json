      "scripts/test-classes.py": "1b1b5c4226aebdab601f9222d86fcd58c414ac2bc840434f5dbd67c63423020d",
      ".config/test-classes.json": "d7217f5b13112f9e66fa87911ef1fbb0e3e85e46d6bb1f68fdf85afc5ce67ae5"
    }
  }
}
