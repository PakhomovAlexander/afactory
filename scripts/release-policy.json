      "implementation_startup"
    ],
    "schemas/implementation-startup-scope-v1.json": [
      "af/implementation-startup-scope@1"
    ]
  },
  "targets": [
    "aarch64-apple-darwin",
    "x86_64-unknown-linux-musl",
    "aarch64-unknown-linux-musl"
  ],
  "validation": [
    [
      "python3",
      "-I",
      "scripts/release-contract.py"
    ],
    [
      "python3",
      "-I",
      "scripts/performance/cli.py",
      "harness-digest",
      "--check"
    ]
  ],
  "pr_validation": {
    "workflow": "ci.yml",
    "source_files": {
