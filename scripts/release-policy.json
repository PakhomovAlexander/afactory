{
  "schema": "af.dev-release-policy/3",
  "compatibility": "Breaking persisted Scenario/Ant shapes: Scenario policy 6, pins/runs/list 7, Store 11; Ant pins/tick 8, state/list 9 and inspection 4. Scenario definitions/bundles remain 6, Ant definitions 7 and Task templates/pins 2. Optional implementation startup scope 1 binds the complete recipe and requires native preflight; it grants no publication permission. Finish or discard prior-release runs and state before upgrading; no migration or replay of retired shapes. Review committed authority and refresh its lock with the published release; pin adoption is a separate reviewed PR.",
  "required_features": {
    "crates/af-scenario/src/retention.rs": [
      "settlement",
      "capacity"
    ],
    "crates/af-scenario/src/roadmap.rs": [
      "roadmap"
    ],
    "crates/af-scenario/src/store.rs": [
      "af/scenario-store@11",
      "run_capacity"
    ],
    "schemas/scenario-store-v11.json": [
      "af/scenario-store@11"
    ],
    "schemas/scenario-v6.json": [
      "af/scenario@6"
    ],
    "schemas/scenario-bundle-v6.json": [
      "af/scenario-bundle@6"
    ],
    "schemas/scenario-pin-v7.json": [
      "af/scenario-pin@7"
    ],
    "schemas/scenario-run-v7.json": [
      "af/scenario-run@7"
    ],
    "schemas/scenario-list-v7.json": [
      "af/scenario-list@7"
    ],
    "schemas/ant-v7.json": [
      "af/ant@7"
    ],
    "schemas/ant-pin-v8.json": [
      "af/ant-pin@8"
    ],
    "schemas/ant-tick-v8.json": [
      "af/ant-tick@8"
    ],
    "schemas/ant-state-v9.json": [
      "af/ant-state@9"
    ],
    "schemas/ant-inspection-v4.json": [
      "af/ant-inspection@4"
    ],
    "schemas/ant-list-v9.json": [
      "af/ant-list@9"
    ],
    "schemas/scenario-task-template-v2.json": [
      "af/scenario-task-template@2",
      "\"authority_id\"",
      "\"bindings\""
    ],
    "schemas/scenario-template-pin-v2.json": [
      "af/scenario-template-pin@2"
    ],
    "crates/af-scenario/src/template.rs": [
      "af/scenario-task-template@2",
      "pub authority_id: String"
    ],
    "crates/af/src/task_commands/scenario_template.rs": [
      "validate_pin(&store, &cas, template)?",
      "restore_compiler(&cas, &authority, &settings)?",
      "recorded_bindings != template.bindings"
