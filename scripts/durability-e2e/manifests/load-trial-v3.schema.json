{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "af-durability/load-trial@3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "case",
    "profile",
    "engine",
    "inputs",
    "expectation",
    "fault_witnessed",
    "verdict",
    "violations",
    "metrics",
    "evidence",
    "reason",
    "workload_evidence_complete",
    "compute_evidence"
  ],
  "properties": {
    "schema": {
      "const": "af-durability/load-trial@3"
    },
    "case": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "build"
      ],
      "properties": {
        "name": {
          "const": "af-native"
        },
        "build": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workload_sha256",
        "fault_sha256",
        "placement_sha256",
        "clock",
        "seed"
      ],
      "properties": {
        "workload_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fault_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "placement_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "clock": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer"
        }
      }
    },
    "expectation": {
      "enum": [
        "control",
        "recover",
        "policy"
      ]
    },
    "fault_witnessed": {
      "type": "boolean"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "invalid",
        "unsupported"
      ]
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "additional_calls": {
          "type": "number",
          "minimum": 0
        },
        "cpu_s": {
          "type": "number",
          "minimum": 0
        },
        "first_progress_s": {
          "type": "number",
          "minimum": 0
        },
        "outage_s": {
          "type": "number",
          "minimum": 0
        },
        "provider_tokens": {
          "type": "number",
          "minimum": 0
        },
        "repeated_steps": {
          "type": "number",
          "minimum": 0
        },
        "simulated_tokens": {
          "type": "number",
          "minimum": 0
        },
        "terminal_s": {
          "type": "number",
          "minimum": 0
        },
        "unknown_settlements": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "workload_evidence_complete": {
      "type": "boolean"
    },
    "compute_evidence": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "worker",
            "cohort",
            "trial"
          ],
          "properties": {
            "worker": {
              "type": "string"
            },
            "cohort": {
              "type": "object",
              "additionalProperties": {
                "$ref": "urn:af:schema:durability-compute-identity:2"
              },
              "minProperties": 2,
              "maxProperties": 16
            },
            "trial": {
              "$ref": "urn:af:schema:durability-compute-identity:2"
            }
          }
        }
      ]
    }
  }
}
