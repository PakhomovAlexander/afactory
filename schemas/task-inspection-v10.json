{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-inspection:10",
  "title": "Task inspection af/task-inspection@10",
  "$comment": "Adds separately authorized experiment preparation, decision and registered child closure evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "revision_id",
    "phase",
    "plan_id",
    "chargeable_tokens",
    "attempts",
    "history",
    "execution_records",
    "run_reports",
    "experiments"
  ],
  "properties": {
    "schema": {
      "const": "af/task-inspection@10"
    },
    "task_id": {
      "$ref": "urn:af:schema:task-inspection:8#/properties/task_id"
    },
    "revision_id": {
      "$ref": "urn:af:schema:task-inspection:8#/properties/revision_id"
    },
    "phase": {
      "$ref": "urn:af:schema:task-inspection:8#/properties/phase"
    },
    "plan_id": {
      "$ref": "urn:af:schema:task-inspection:8#/properties/plan_id"
    },
    "chargeable_tokens": {
      "$ref": "urn:af:schema:task-inspection:8#/properties/chargeable_tokens"
    },
    "attempts": {
      "$ref": "urn:af:schema:task-inspection:8#/properties/attempts"
    },
    "selection": {
      "$ref": "urn:af:schema:task-inspection:8#/properties/selection"
    },
    "planning": {
      "$ref": "urn:af:schema:task-inspection:8#/properties/planning"
    },
    "plan_decisions": {
      "$ref": "urn:af:schema:task-inspection:8#/properties/plan_decisions"
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "urn:af:schema:task-inspection:8#/properties/history/items"
      }
    },
    "execution_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "artifact_type",
          "record"
        ],
        "properties": {
          "artifact_id": {
            "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
          },
          "artifact_type": {
            "enum": [
              "af/TaskExecutionRecord@1",
              "af/TaskExecutionRecord@2",
              "af/TaskExecutionRecord@3",
              "af/TaskExecutionRecord@4",
              "af/TaskExecutionRecord@5"
            ]
          },
          "record": {
            "oneOf": [
              {
                "$ref": "urn:af:schema:task-execution-record:1"
              },
              {
                "$ref": "urn:af:schema:task-execution-record:2"
              },
              {
                "$ref": "urn:af:schema:task-execution-record:3"
              },
              {
                "$ref": "urn:af:schema:task-execution-record:4"
              },
              {
                "$ref": "urn:af:schema:task-execution-record:5"
              }
            ]
          },
          "diagnostic": {
            "type": "object"
          }
        }
      }
    },
    "run_reports": {
      "$ref": "urn:af:schema:task-inspection:8#/properties/run_reports"
    },
    "delivery": {
      "$ref": "urn:af:schema:task-inspection:8#/properties/delivery"
    },
    "result": {
      "$ref": "urn:af:schema:task-inspection:8#/properties/result"
    },
    "planning_diagnostic": {
      "$ref": "urn:af:schema:task-inspection:8#/properties/planning_diagnostic"
    },
    "repair_assessments": {
      "$ref": "urn:af:schema:task-inspection:8#/properties/repair_assessments"
    },
    "review_rounds": {
      "$ref": "urn:af:schema:task-inspection:8#/properties/review_rounds"
    },
    "graph": {
      "$ref": "urn:af:schema:task-inspection:8#/properties/graph"
    },
    "plan": {
      "$ref": "urn:af:schema:task-inspection:8#/properties/plan"
    },
    "broker_records": {
      "$ref": "urn:af:schema:task-inspection:8#/properties/broker_records"
    },
    "owned_child_sets": {
      "$ref": "urn:af:schema:task-inspection:8#/properties/owned_child_sets"
    },
    "review_handoffs": {
      "$ref": "urn:af:schema:task-inspection:8#/properties/review_handoffs"
    },
    "review_integrations": {
      "$ref": "urn:af:schema:task-inspection:8#/properties/review_integrations"
    },
    "attempt_walls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "attempt_id",
          "node_id",
          "round",
          "epoch",
          "started_unix_ms",
          "elapsed_ms"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "attempt_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "node_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "round": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "epoch": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "started_unix_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "elapsed_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "usage": {
            "$ref": "urn:af:schema:task-runtime-evidence:1#/$defs/usage"
          }
        }
      }
    },
    "runtime_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "artifact_type",
          "record"
        ],
        "properties": {
          "artifact_id": {
            "$ref": "urn:af:schema:task-runtime-evidence:1#/$defs/digest"
          },
          "artifact_type": {
            "const": "af/TaskRuntimeEvidence@1"
          },
          "record": {
            "$ref": "urn:af:schema:task-runtime-evidence:1"
          }
        }
      }
    },
    "experiments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "artifact_id",
          "artifact_type",
          "record"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "prepared",
              "decision",
              "registered"
            ]
          },
          "artifact_id": {
            "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
          },
          "artifact_type": {
            "enum": [
              "af/ExperimentPrepared@1",
              "af/ExperimentPlanDecision@1",
              "af/ExperimentExecutionPlan@1"
            ]
          },
          "prepared_id": {
            "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
          },
          "decision_id": {
            "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
          },
          "record": {
            "oneOf": [
              {
                "$ref": "urn:af:schema:experiment-prepared:1"
              },
              {
                "$ref": "urn:af:schema:experiment-plan-decision:1"
              },
              {
                "$ref": "urn:af:schema:experiment-execution-plan:1"
              }
            ]
          }
        }
      }
    }
  },
  "dependentRequired": {
    "graph": [
      "plan"
    ],
    "plan": [
      "graph"
    ],
    "delivery": [
      "result"
    ],
    "planning_diagnostic": [
      "result"
    ],
    "repair_assessments": [
      "result"
    ],
    "review_rounds": [
      "result"
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "properties": {
              "kind": {
                "const": "finished"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "result"
        ]
      },
      "else": {
        "not": {
          "required": [
            "result"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "graph"
        ]
      },
      "then": {
        "properties": {
          "plan_id": {
            "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
          }
        }
      }
    }
  ]
}
