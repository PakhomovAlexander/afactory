{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:review-kernel:schema:integration-checks:1",
  "title": "IntegrationChecks@1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["derived_snapshot_id", "checks"],
  "properties": {
    "derived_snapshot_id": { "$ref": "#/$defs/digest" },
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "passed", "result_artifact_id"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "result_artifact_id": { "$ref": "#/$defs/digest" }
        }
      }
    }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}
