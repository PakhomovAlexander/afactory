{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:review-kernel:schema:evidence-satisfaction:1",
  "title": "EvidenceSatisfaction@1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["demand_id", "evidence_id", "subject_id", "policy_revision", "reason"],
  "properties": {
    "demand_id": { "$ref": "#/$defs/digest" },
    "evidence_id": { "$ref": "#/$defs/digest" },
    "subject_id": { "$ref": "#/$defs/digest" },
    "policy_revision": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}
