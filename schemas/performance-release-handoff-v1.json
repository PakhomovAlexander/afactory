{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:performance-release-handoff:1",
  "title": "af.perf-release-handoff/1",
  "description": "One release handoff decision (ADR-0180): the verified upstream run and every attempt's publish and pin outcomes, the published release, the identity and claim key, each claim of its history and why it is valid or not, and whether this run claims, measures, links the first claim's retained result, or why it runs nothing; always advisory.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "af.perf-release-handoff/1"
    },
    "stage": {
      "type": "string",
      "enum": [
        "handoff",
        "confirm"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "release",
        "remeasure"
      ]
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "maxLength": 201,
          "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
        },
        "run_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740992
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "event": {
          "type": "string",
          "enum": [
            "workflow_run",
            "workflow_dispatch"
          ]
        },
        "sha": {
          "$ref": "#/$defs/git_sha"
        }
      },
      "required": [
        "repository",
        "run_id",
        "run_attempt",
        "event",
        "sha"
      ]
    },
    "upstream": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "run_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740992
            },
            "run_attempt": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "latest_attempt": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "workflow_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740992
            },
            "workflow_path": {
              "const": ".github/workflows/release.yml"
            },
            "event": {
              "const": "push"
            },
            "head_branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "head_sha": {
              "$ref": "#/$defs/git_sha"
            },
            "conclusion": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              ]
            },
            "created_unix_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740992
            }
          },
          "required": [
            "run_id",
            "run_attempt",
            "latest_attempt",
            "workflow_id",
            "workflow_path",
            "event",
            "head_branch",
            "head_sha",
            "conclusion",
            "created_unix_ms"
          ]
        }
      ]
    },
    "publication": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "attempts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "attempt": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  },
                  "jobs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  },
                  "publish": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      }
                    ]
                  },
                  "pin": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      }
                    ]
                  }
                },
                "required": [
                  "attempt",
                  "jobs",
                  "publish",
                  "pin"
                ]
              },
              "minItems": 1,
              "maxItems": 20
            },
            "published_in_attempt": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          "required": [
            "attempts",
            "published_in_attempt"
          ]
        }
      ]
    },
    "release": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tag": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^v(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})(-rc\\.(0|[1-9][0-9]{0,8}))?$"
            },
            "sha": {
              "$ref": "#/$defs/git_sha"
            },
            "id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740992
            },
            "prerelease": {
              "type": "boolean"
            },
            "published_at": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "tag",
            "sha",
            "id",
            "prerelease",
            "published_at"
          ]
        }
      ]
    },
    "identity": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "maxLength": 201,
              "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
            },
            "upstream_run_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740992
            },
            "tag": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^v(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})(-rc\\.(0|[1-9][0-9]{0,8}))?$"
            },
            "sha": {
              "$ref": "#/$defs/git_sha"
            }
          },
          "required": [
            "repository",
            "upstream_run_id",
            "tag",
            "sha"
          ]
        }
      ]
    },
    "key": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/digest"
        }
      ]
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "not_read",
            "complete",
            "unavailable",
            "expired"
          ]
        },
        "detail": {
          "type": "string",
          "maxLength": 4096
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "artifact_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740992
              },
              "actions_run_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740992
              },
              "created_unix_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740992
              },
              "expired": {
                "type": "boolean"
              },
              "valid": {
                "type": "boolean"
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/id"
                  }
                ]
              }
            },
            "required": [
              "artifact_id",
              "actions_run_id",
              "created_unix_ms",
              "expired",
              "valid",
              "reason"
            ]
          },
          "minItems": 0,
          "maxItems": 20
        }
      },
      "required": [
        "state",
        "detail",
        "claims"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "claimed",
        "measure",
        "linked",
        "incomplete",
        "not_eligible",
        "refused"
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/id"
        }
      ]
    },
    "detail": {
      "type": "string",
      "maxLength": 4096
    },
    "claim_artifact": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "maxLength": 128,
          "pattern": "^af-release-(claim-[0-9a-f]{64}|remeasure-[0-9a-f]{64}-[1-9][0-9]{0,15})$"
        }
      ]
    },
    "first_claim": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "artifact_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740992
            },
            "actions_run_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740992
            },
            "actions_run_attempt": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "lab_run_prefix": {
              "type": "string",
              "maxLength": 32,
              "pattern": "^gh[1-9][0-9]{0,15}_a[1-9][0-9]{0,3}_$"
            }
          },
          "required": [
            "artifact_id",
            "actions_run_id",
            "actions_run_attempt",
            "lab_run_prefix"
          ]
        }
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740992
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "expired": {
            "type": "boolean"
          }
        },
        "required": [
          "artifact_id",
          "name",
          "expired"
        ]
      },
      "minItems": 0,
      "maxItems": 16
    },
    "enforcement": {
      "const": "advisory"
    }
  },
  "required": [
    "schema",
    "stage",
    "mode",
    "actions",
    "upstream",
    "publication",
    "release",
    "identity",
    "key",
    "history",
    "status",
    "reason",
    "detail",
    "claim_artifact",
    "first_claim",
    "results",
    "enforcement"
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "git_sha": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    }
  }
}
