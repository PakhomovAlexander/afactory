{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-execution-record:4",
  "title": "TaskExecutionRecord@4",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "child_set_id"
      ],
      "properties": {
        "kind": {
          "const": "owned_children_registered"
        },
        "child_set_id": {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "child_set_id",
        "output_id",
        "attempt_id"
      ],
      "properties": {
        "kind": {
          "const": "owned_child_published"
        },
        "child_set_id": {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
        },
        "output_id": {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{26}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "child_set_id",
        "output_id"
      ],
      "properties": {
        "kind": {
          "const": "owned_children_completed"
        },
        "child_set_id": {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
        },
        "output_id": {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
        }
      }
    }
  ]
}
