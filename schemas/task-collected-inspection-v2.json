{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-collected-inspection:2",
  "title": "af/task-collected-inspection@2",
  "description": "What `af task show --json` prints for a Task `af task gc --apply` collected (ADR-0135), in place of the artifact-backed `af/task-inspection@12`: the Task's ID, the finished phase its log recorded, and its retained tombstone. No artifact is read to produce it. Version 2 adds the `state` `af task list` prints for it: finished, the outcome its tombstone retained, cause `collected`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "phase",
    "state",
    "collected"
  ],
  "properties": {
    "schema": {
      "const": "af/task-collected-inspection@2"
    },
    "task_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/name"
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "result_id"
      ],
      "properties": {
        "kind": {
          "const": "finished"
        },
        "result_id": {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
        }
      }
    },
    "state": {
      "allOf": [
        {
          "$ref": "urn:af:schema:task-state:1#/$defs/state"
        },
        {
          "properties": {
            "phase": {
              "const": "finished"
            },
            "cause": {
              "const": "collected"
            }
          }
        }
      ]
    },
    "collected": {
      "$ref": "urn:af:schema:task-collected:1"
    }
  }
}
