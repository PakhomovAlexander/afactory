{
  "$id": "urn:af:schema:scenario-ci-notification-evidence:2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Bounded exact references to the full native settlement retained in the Run. Receipt result, diagnosis details, accepted envelope and diagnostic prefixes are explicitly omitted from transport, never from native storage.",
  "properties": {
    "category": {
      "enum": [
        "transient",
        "product_bug",
        "test_bug",
        "ci_infra",
        "unknown"
      ]
    },
    "omitted": {
      "const": "details_retained_in_native_settlement"
    },
    "plan_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "provenance": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "artifact_id": {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            "kind": {
              "const": "accepted"
            }
          },
          "required": [
            "kind",
            "artifact_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "deterministic_refusal"
            },
            "refusals": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "attempt_id": {
                    "pattern": "^[A-Za-z0-9]{26}$",
                    "type": "string"
                  },
                  "diagnostic_id": {
                    "pattern": "^sha256:[0-9a-f]{64}$",
                    "type": "string"
                  }
                },
                "required": [
                  "attempt_id",
                  "diagnostic_id"
                ],
                "type": "object"
              },
              "maxItems": 20,
              "minItems": 1,
              "type": "array"
            }
          },
          "required": [
            "kind",
            "refusals"
          ],
          "type": "object"
        }
      ]
    },
    "repository_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "result_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "revision_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "af/scenario-ci-notification-evidence@2"
    },
    "selection": {
      "additionalProperties": false,
      "properties": {
        "occurrence_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "schema": {
          "const": "af.ci-diagnosis-selection/1"
        },
        "signature_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "source_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "occurrence_id",
        "signature_id",
        "source_sha"
      ],
      "type": "object"
    },
    "settlement_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "snapshot_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "task_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "repository_id",
    "settlement_id",
    "task_id",
    "plan_id",
    "revision_id",
    "result_id",
    "snapshot_id",
    "selection",
    "category",
    "provenance",
    "omitted"
  ],
  "title": "Native CI notification evidence v2",
  "type": "object"
}
