{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:pr-lines:2",
  "title": "af/PrLines@2",
  "description": "Exact path-based PR additions: directories partition the entire PR, crates partition only paths under crates/<crate>/. The crate view never increases the PR total. Rust test paths take priority over src main code; all other files are other. The previous unversioned directory map is refused.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "directories",
    "crates"
  ],
  "properties": {
    "schema": {
      "const": "af/PrLines@2"
    },
    "directories": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "crates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "main",
          "tests",
          "other"
        ],
        "properties": {
          "main": {
            "type": "integer",
            "minimum": 0
          },
          "tests": {
            "type": "integer",
            "minimum": 0
          },
          "other": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
