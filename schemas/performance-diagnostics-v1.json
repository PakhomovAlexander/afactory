{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:performance-diagnostics:1",
  "title": "af.perf-diagnostics/1",
  "description": "fixtures/performance/diagnostics.toml as parsed TOML (ADR-0174): diagnostic case selection, capture defaults within the hard caps, the declared event and DWARF alternative, trace overhead target, counter cases, resource limits, diagnostic recipes derived from verdict recipes, and every external tool's pin, version provenance and provisioning instructions.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "af.perf-diagnostics/1"
    },
    "description": {
      "type": "string",
      "maxLength": 4096
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_cases": {
          "const": 3
        },
        "max_cases": {
          "const": 8
        },
        "order": {
          "const": "regressed_then_inconclusive_by_instance_id"
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "default_cases",
        "max_cases",
        "order",
        "description"
      ]
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frequency_hz": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1999
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "event": {
          "type": "string",
          "maxLength": 72,
          "pattern": "^[a-z][a-z0-9_-]{0,63}(?::[ukh]{1,3})?$"
        },
        "dwarf_stack_bytes": {
          "const": 32768
        },
        "extra_dwarf_captures_per_side": {
          "const": 1
        },
        "dwarf_when_unknown_ratio_above": {
          "$ref": "#/$defs/decimal"
        },
        "minimum_samples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_repetitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "handshake_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "frequency_hz",
        "duration_seconds",
        "event",
        "dwarf_stack_bytes",
        "extra_dwarf_captures_per_side",
        "dwarf_when_unknown_ratio_above",
        "minimum_samples",
        "max_repetitions",
        "handshake_timeout_seconds",
        "description"
      ]
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overhead_target": {
          "$ref": "#/$defs/decimal"
        },
        "overhead_pairs": {
          "type": "integer",
          "minimum": 12,
          "maximum": 200
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "overhead_target",
        "overhead_pairs",
        "description"
      ]
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "seconds",
        "cases",
        "description"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "profile_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "builds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "tool_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "tool_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      },
      "required": [
        "total_minutes",
        "profile_bytes",
        "builds",
        "tool_output_bytes",
        "tool_seconds"
      ]
    },
    "recipes": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,63}$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string",
              "maxLength": 4096
            },
            "kind": {
              "type": "string",
              "enum": [
                "cpu_profile",
                "trace",
                "counters"
              ]
            },
            "base_recipe": {
              "$ref": "#/$defs/id"
            },
            "features": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 4096,
                "pattern": "^[a-z0-9_-]{1,64}$"
              },
              "minItems": 0,
              "maxItems": 8,
              "uniqueItems": true
            },
            "debug_symbols": {
              "type": "boolean"
            },
            "frame_pointers": {
              "type": "boolean"
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "perf",
                  "inferno_collapse_perf",
                  "inferno_diff_folded",
                  "inferno_flamegraph",
                  "samply",
                  "valgrind",
                  "callgrind_control"
                ]
              },
              "minItems": 0,
              "maxItems": 8,
              "uniqueItems": true
            }
          },
          "required": [
            "description",
            "kind",
            "base_recipe",
            "features",
            "debug_symbols",
            "frame_pointers",
            "tools"
          ]
        }
      },
      "additionalProperties": false
    },
    "tools": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,63}$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string",
              "maxLength": 4096
            },
            "executable": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "os": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "linux",
                  "macos"
                ]
              },
              "minItems": 1,
              "maxItems": 2,
              "uniqueItems": true
            },
            "package": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "version": {
              "type": "string",
              "maxLength": 32,
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "source_sha256": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            "source_url": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^https://[A-Za-z0-9./_-]+$"
            },
            "version_argv": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "minItems": 1,
              "maxItems": 4
            },
            "provisioning": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "required": [
            "description",
            "executable",
            "os",
            "package",
            "provisioning"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "description",
    "selection",
    "capture",
    "trace",
    "counters",
    "limits",
    "recipes",
    "tools"
  ],
  "$defs": {
    "decimal": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
      "description": "Canonical nonnegative decimal, at most 38 significant digits."
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    }
  }
}
