{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:report-draft-validation:1",
  "title": "af/ReportDraftValidation@1",
  "description": "What the kernel found when it validated a report author's draft for shape before sealing it (ADR-0202): one result per check (`one_draft`, `sets`, `required_sections`), the report policy it judged against verbatim, and one line per failure. A failed validation refuses the reply and travels with the author's retry feedback; the report's size and citations are judged by the report check after sealing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy",
    "checks",
    "failures",
    "outcome"
  ],
  "properties": {
    "schema": {
      "const": "af/ReportDraftValidation@1"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_document_bytes",
        "required_sections",
        "require_citations",
        "require_repository_citations"
      ],
      "properties": {
        "max_document_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "required_sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "require_citations": {
          "type": "boolean"
        },
        "require_repository_citations": {
          "type": "boolean"
        }
      }
    },
    "checks": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
        "maxLength": 128
      },
      "additionalProperties": {
        "enum": [
          "passed",
          "failed",
          "inconclusive"
        ]
      }
    },
    "failures": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "\\S"
      }
    },
    "outcome": {
      "enum": [
        "passed",
        "failed"
      ]
    }
  }
}
