{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:onboard-tasks:1",
  "title": "Task onboarding preview af/onboard-tasks@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "repository",
    "files",
    "append_text",
    "gate",
    "provider_kind",
    "warnings",
    "next_steps"
  ],
  "properties": {
    "schema": {
      "const": "af/onboard-tasks@1"
    },
    "status": {
      "enum": ["preview", "created"]
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "append_text": {
      "type": "string",
      "pattern": "^\\n\\[task\\.defaults\\]"
    },
    "gate": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "program", "args", "source"],
        "properties": {
          "name": {"type": "string"},
          "program": {"type": "string"},
          "args": {"type": "array", "items": {"type": "string"}},
          "source": {"type": "string"}
        }
      }
    },
    "provider_kind": {
      "enum": ["claude", "codex", "mixed"]
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    },
    "next_steps": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
