{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-status:1",
  "title": "Task status af/task-status@1",
  "$comment": "What `af task status ID --json` and `af task wait ID --json` print (ADR-0202): the Task's state, the node whose Attempt runs now, the time since the Task's clock started (to now while it runs, to its last event once it stopped), the tokens charged so far, the run process whose writer took the Task's last lease (the newest one recorded when no record names that writer), and the cancel request that stopped the Task's last lease. Read-only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "state",
    "node",
    "elapsed_ms",
    "chargeable_tokens",
    "run",
    "cancel"
  ],
  "properties": {
    "schema": {
      "const": "af/task-status@1"
    },
    "task_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/name"
    },
    "state": {
      "$ref": "urn:af:schema:task-state:1#/$defs/state"
    },
    "node": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "elapsed_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "chargeable_tokens": {
      "$ref": "urn:af:schema:task-token-usage:3#/$defs/decimalU128"
    },
    "run": {
      "anyOf": [
        {
          "$ref": "urn:af:schema:task-run-process:1"
        },
        {
          "type": "null"
        }
      ]
    },
    "cancel": {
      "anyOf": [
        {
          "$ref": "urn:af:schema:task-cancel-request:1"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
