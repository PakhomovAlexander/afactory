{
  "$id": "urn:af:schema:github-followup:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "GitHub Scenario adapter v1. Semantic validation also binds exact identities, scope and durable state.",
  "properties": {
    "body": {
      "maxLength": 48000,
      "minLength": 1,
      "type": "string"
    },
    "publication": {
      "maxLength": 65536,
      "minLength": 1,
      "pattern": "^github-pr:sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "af/github-followup@1"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema",
    "publication",
    "title",
    "body"
  ],
  "type": "object"
}
