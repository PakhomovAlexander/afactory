{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:scenario-adapter-response:1",
  "title": "scenario-adapter-response v1",
  "description": "ADR-0274. Cross-port types, identity, authority, budget, signature and lifecycle invariants also require semantic admission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "intent_id",
    "input_digest",
    "outcome",
    "evidence",
    "observation"
  ],
  "properties": {
    "schema": {
      "const": "af/scenario-adapter-response@1"
    },
    "intent_id": {
      "$ref": "urn:af:schema:scenario:4#/$defs/digest"
    },
    "input_digest": {
      "$ref": "urn:af:schema:scenario:4#/$defs/digest"
    },
    "outcome": {
      "enum": [
        "done",
        "pending",
        "absent",
        "failed"
      ]
    },
    "evidence": {
      "$ref": "urn:af:schema:scenario:4#/$defs/text"
    },
    "observation": {
      "anyOf": [
        {
          "$ref": "urn:af:schema:scenario:4#/$defs/Observation"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
