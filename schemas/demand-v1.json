{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:review-kernel:schema:demand:1",
  "title": "Demand@1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["demand_id", "claim", "why", "suggested_method", "source", "requirement", "round", "subject_id"],
  "properties": {
    "demand_id": { "$ref": "#/$defs/digest" },
    "claim": { "type": "string", "minLength": 1 },
    "why": { "type": "string", "minLength": 1 },
    "suggested_method": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "requirement": { "enum": ["required", "advisory"] },
    "round": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "subject_id": { "$ref": "#/$defs/digest" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } }
}
