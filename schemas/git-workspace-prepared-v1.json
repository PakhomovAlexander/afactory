{
  "$id": "urn:af:schema:git-workspace-prepared:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base": {
      "maxLength": 65536,
      "minLength": 1,
      "type": "string"
    },
    "body": {
      "maxLength": 48000,
      "minLength": 1,
      "type": "string"
    },
    "branch": {
      "maxLength": 65536,
      "minLength": 1,
      "type": "string"
    },
    "commit": {
      "maxLength": 65536,
      "minLength": 1,
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "config_digest": {
      "maxLength": 65536,
      "minLength": 1,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "owner": {
      "maxLength": 65536,
      "minLength": 1,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "previous_owner": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "maxLength": 65536,
          "minLength": 1,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      ]
    },
    "repository": {
      "maxLength": 65536,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9_][A-Za-z0-9_.-]{0,99}$",
      "type": "string"
    },
    "repository_id": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
    },
    "result_id": {
      "maxLength": 65536,
      "minLength": 1,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema": {
      "const": "af/git-workspace-prepared@1"
    },
    "snapshot_id": {
      "maxLength": 65536,
      "minLength": 1,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "source_commit": {
      "maxLength": 65536,
      "minLength": 1,
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "source_predecessor": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "maxLength": 65536,
          "minLength": 1,
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      ]
    },
    "source_snapshot": {
      "maxLength": 65536,
      "minLength": 1,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "task_id": {
      "maxLength": 65536,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$",
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "tree": {
      "maxLength": 65536,
      "minLength": 1,
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "worktree": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^/[^\\x00]+$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "owner",
    "previous_owner",
    "config_digest",
    "repository",
    "repository_id",
    "task_id",
    "result_id",
    "snapshot_id",
    "source_snapshot",
    "source_predecessor",
    "source_commit",
    "branch",
    "base",
    "commit",
    "tree",
    "worktree",
    "title",
    "body"
  ],
  "title": "git-workspace-prepared v1",
  "type": "object"
}
