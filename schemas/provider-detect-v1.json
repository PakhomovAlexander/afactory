{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:provider-detect:1",
  "title": "Provider detect@1",
  "$comment": "The machine-readable result of one `af provider detect` (ADR-0197): the official CLIs found, the unsupported harness CLIs on PATH, every candidate auth directory with what the status probe said about it and the one command af suggests, and, under --apply, what was registered. Deliberately absent, in every state: account email, organization or account identity, credentials, OAuth material and Provider-authored text; versions are af's own reading of a version line, and `notes` are af-authored.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "exit_code",
    "applied",
    "binaries",
    "unsupported",
    "candidates",
    "notes"
  ],
  "properties": {
    "schema": {
      "const": "af/provider-detect@1"
    },
    "exit_code": {
      "$comment": "0 the scan completed; 4 a found CLI cannot start or does not accept af's invocation (the rows are still reported); 5 a registry conflict stopped --apply. 1 and 2 are reported as af/error@1 documents, never as this one.",
      "enum": [0, 4, 5]
    },
    "applied": {
      "$comment": "Whether --apply was given; without it nothing was written.",
      "type": "boolean"
    },
    "binaries": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "version", "on_path", "compatible"],
        "properties": {
          "kind": { "enum": ["claude", "codex"] },
          "path": { "type": "string", "minLength": 1 },
          "version": { "$ref": "#/$defs/version" },
          "on_path": { "type": "boolean" },
          "compatible": {
            "$comment": "The capability check's verdict (ADR-0146); null when af gave up waiting on it.",
            "type": ["boolean", "null"]
          }
        }
      }
    },
    "unsupported": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "version"],
        "properties": {
          "name": {
            "enum": [
              "gemini",
              "cursor-agent",
              "opencode",
              "amp",
              "copilot",
              "aider",
              "qwen",
              "goose"
            ]
          },
          "path": { "type": "string", "minLength": 1 },
          "version": { "$ref": "#/$defs/version" }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "$comment": "Exit 4 is claimed exactly when a found CLI cannot serve af.",
      "if": {
        "properties": {
          "binaries": {
            "contains": {
              "properties": { "compatible": { "const": false } },
              "required": ["compatible"]
            }
          }
        }
      },
      "then": {
        "properties": { "exit_code": { "enum": [4, 5] } }
      },
      "else": {
        "properties": { "exit_code": { "enum": [0, 5] } }
      }
    },
    {
      "$comment": "Exit 5 only under --apply, and only with a row whose publication met a conflict.",
      "if": {
        "properties": { "exit_code": { "const": 5 } }
      },
      "then": {
        "properties": {
          "applied": { "const": true },
          "candidates": {
            "contains": {
              "properties": {
                "applied": {
                  "type": "object",
                  "properties": { "result": { "const": "registry_conflict" } }
                }
              }
            }
          }
        }
      }
    },
    {
      "$comment": "Without --apply no row says what --apply did.",
      "if": {
        "properties": { "applied": { "const": false } }
      },
      "then": {
        "properties": {
          "candidates": {
            "items": { "properties": { "applied": { "type": "null" } } }
          }
        }
      }
    }
  ],
  "$defs": {
    "version": {
      "$comment": "af's reading of a version line: digits and dots, an optional pre-release.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[0-9]{1,9}(\\.[0-9]{1,9}){1,3}([-+][0-9A-Za-z.-]+)?$"
        }
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "auth_dir",
        "source",
        "markers",
        "safe",
        "auth",
        "auth_method",
        "plan",
        "registered_as",
        "suggested",
        "applied"
      ],
      "properties": {
        "kind": { "enum": ["claude", "codex"] },
        "auth_dir": {
          "type": "string",
          "pattern": "^/"
        },
        "source": {
          "$comment": "env: CLAUDE_CONFIG_DIR or CODEX_HOME; default: ~/.claude or ~/.codex; sibling: a literal one-level sibling name; registry: an auth_dir already registered; explicit: --dir.",
          "enum": ["env", "default", "sibling", "registry", "explicit"]
        },
        "markers": {
          "$comment": "The login marker names present in the directory, examined by name only.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              ".claude.json",
              ".credentials.json",
              "settings.json",
              "auth.json",
              "config.toml"
            ]
          }
        },
        "safe": {
          "$comment": "Owned by the caller, not group- or world-writable, not a symlink: the rules setup and add apply.",
          "type": "boolean"
        },
        "auth": {
          "$comment": "The closed vocabulary of af provider status; not_probed for a directory that is absent, unsafe, holds no marker (without --all), or whose CLI was not found or cannot serve af.",
          "enum": [
            "authenticated",
            "not_authenticated",
            "unknown",
            "unavailable",
            "installation_failed",
            "incompatible",
            "not_probed"
          ]
        },
        "auth_method": {
          "enum": ["oauth", "api_key", "none", "unknown"]
        },
        "plan": {
          "$comment": "af's own plan name; the Codex plan is not part of the status probe's answer and stays unknown.",
          "enum": ["max", "team", "pro", "business", "free", "unknown"]
        },
        "registered_as": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }]
        },
        "suggested": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "id", "command"],
          "properties": {
            "action": {
              "$comment": "register: af provider add; login: af provider setup ... --login, run by a human at a private terminal; probe: af provider detect --all; fix_safety: the chmod fix when there is one; fix_cli: the upgrade command; install: the official install command; retry: af provider detect; none.",
              "enum": [
                "register",
                "login",
                "probe",
                "fix_safety",
                "fix_cli",
                "install",
                "retry",
                "none"
              ]
            },
            "id": {
              "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }]
            },
            "command": {
              "type": ["string", "null"],
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": { "action": { "enum": ["register", "login"] } }
              },
              "then": {
                "properties": {
                  "id": { "$ref": "#/$defs/id" },
                  "command": { "type": "string" }
                }
              },
              "else": {
                "properties": { "id": { "type": "null" } }
              }
            },
            {
              "if": {
                "properties": { "action": { "const": "register" } }
              },
              "then": {
                "properties": {
                  "command": { "pattern": "^af provider add " }
                }
              }
            },
            {
              "if": {
                "properties": { "action": { "const": "login" } }
              },
              "then": {
                "properties": {
                  "command": { "pattern": "^af provider setup .* --login$" }
                }
              }
            },
            {
              "if": {
                "properties": { "action": { "const": "none" } }
              },
              "then": {
                "properties": { "command": { "type": "null" } }
              }
            }
          ]
        },
        "applied": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "result"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "result": {
                  "enum": [
                    "registered",
                    "already_registered",
                    "registry_conflict",
                    "skipped_not_authenticated"
                  ]
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "$comment": "Only an authenticated, unregistered directory is registered or met a conflict; a logged-out one is only ever skipped.",
          "if": {
            "properties": {
              "applied": {
                "type": "object",
                "properties": {
                  "result": { "enum": ["registered", "registry_conflict"] }
                }
              }
            }
          },
          "then": {
            "properties": {
              "auth": { "const": "authenticated" },
              "registered_as": { "type": "null" },
              "suggested": {
                "properties": { "action": { "const": "register" } }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "applied": {
                "type": "object",
                "properties": {
                  "result": { "const": "skipped_not_authenticated" }
                }
              }
            }
          },
          "then": {
            "properties": { "auth": { "const": "not_authenticated" } }
          }
        },
        {
          "$comment": "An authenticated, unregistered directory is always offered for registration.",
          "if": {
            "properties": {
              "auth": { "const": "authenticated" },
              "registered_as": { "type": "null" },
              "safe": { "const": true }
            }
          },
          "then": {
            "properties": {
              "suggested": {
                "properties": { "action": { "const": "register" } }
              }
            }
          }
        },
        {
          "$comment": "An unsafe directory is never probed.",
          "if": {
            "properties": { "safe": { "const": false } }
          },
          "then": {
            "properties": { "auth": { "const": "not_probed" } }
          }
        },
        {
          "if": {
            "properties": { "auth": { "const": "authenticated" } }
          },
          "then": {
            "properties": { "auth_method": { "enum": ["oauth", "api_key", "unknown"] } }
          },
          "else": {
            "properties": {
              "plan": { "const": "unknown" },
              "auth_method": { "enum": ["none", "unknown"] }
            }
          }
        }
      ]
    }
  }
}
