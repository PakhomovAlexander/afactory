                    },
                    {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reasons",
        "verdict"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "not_judged"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "decision": {
      "enum": [
        "one_shape",
        "two_shapes",
        "not_judged"
      ]
    }
  }
}
