          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "tool_output_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "levels": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "off",
              "spans"
            ],
            "properties": {
              "off": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "drain_median_ms",
                  "pairs",
                  "passed",
                  "rss_median_bytes",
                  "stream_bytes",
                  "wall_interval_pct",
                  "wall_median_pct"
                ],
                "properties": {
                  "pairs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "json",
                        "order",
                        "rss_difference_bytes",
                        "stream-json",
                        "wall_difference_pct"
                      ],
                      "properties": {
                        "order": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 2,
                          "items": {
                            "enum": [
                              "json",
                              "stream-json"
                            ]
                          }
                        },
                        "json": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "drain_ms",
                            "exit_code",
                            "peak_rss_bytes",
                            "segments",
                            "stdout_bytes",
                            "wall_ms"
                          ],
                          "properties": {
                            "wall_ms": {
                              "type": "number"
                            },
                            "exit_code": {
                              "type": "integer"
                            },
                            "peak_rss_bytes": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "segments": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "drain_ms": {
                              "type": [
                                "number",
                                "null"
                              ]
                            },
                            "stdout_bytes": {
                              "type": "integer",
                              "minimum": 0
                            }
                          }
                        },
                        "stream-json": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "drain_ms",
                            "exit_code",
                            "peak_rss_bytes",
                            "segments",
                            "stdout_bytes",
                            "wall_ms"
                          ],
                          "properties": {
                            "wall_ms": {
                              "type": "number"
                            },
                            "exit_code": {
                              "type": "integer"
                            },
                            "peak_rss_bytes": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "segments": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "drain_ms": {
                              "type": [
                                "number",
                                "null"
                              ]
                            },
                            "stdout_bytes": {
                              "type": "integer",
                              "minimum": 0
                            }
                          }
                        },
                        "wall_difference_pct": {
                          "type": "number"
                        },
                        "rss_difference_bytes": {
                          "type": "integer"
                        }
                      }
                    }
                  },
                  "wall_median_pct": {
                    "type": "number"
                  },
                  "wall_interval_pct": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    }
                  },
                  "rss_median_bytes": {
                    "type": "integer"
                  },
                  "stream_bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "drain_median_ms": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "passed": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  }
                }
              },
              "spans": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "drain_median_ms",
                  "pairs",
                  "passed",
                  "rss_median_bytes",
                  "stream_bytes",
                  "wall_interval_pct",
                  "wall_median_pct"
                ],
                "properties": {
                  "pairs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "json",
                        "order",
                        "rss_difference_bytes",
                        "stream-json",
                        "wall_difference_pct"
                      ],
                      "properties": {
                        "order": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 2,
                          "items": {
                            "enum": [
                              "json",
                              "stream-json"
                            ]
                          }
