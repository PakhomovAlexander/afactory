              "usage"
            ],
            "properties": {
              "phase": {
                "type": "string"
              },
              "chargeable_tokens": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "attempts": {
                "type": "integer",
                "minimum": 0
              },
              "usage": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "prefixItems": [
                    {
