                              ]
                            },
                            "stdout_bytes": {
                              "type": "integer",
                              "minimum": 0
                            }
                          }
                        },
                        "wall_difference_pct": {
                          "type": "number"
                        },
                        "rss_difference_bytes": {
                          "type": "integer"
                        }
                      }
                    }
                  },
                  "wall_median_pct": {
                    "type": "number"
                  },
                  "wall_interval_pct": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "number"
                    }
                  },
                  "rss_median_bytes": {
                    "type": "integer"
                  },
                  "stream_bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "drain_median_ms": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "passed": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  }
                }
              }
            }
          },
          "accounting": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "attempts",
              "chargeable_tokens",
