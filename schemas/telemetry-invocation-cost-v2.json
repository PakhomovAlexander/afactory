                          "properties": {
                            "wall_ms": {
                              "type": "number"
                            },
                            "exit_code": {
                              "type": "integer"
                            },
                            "peak_rss_bytes": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "segments": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "drain_ms": {
                              "type": [
                                "number",
                                "null"
                              ]
                            },
                            "stdout_bytes": {
                              "type": "integer",
                              "minimum": 0
                            }
                          }
                        },
                        "stream-json": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "drain_ms",
                            "exit_code",
                            "peak_rss_bytes",
                            "segments",
                            "stdout_bytes",
                            "wall_ms"
                          ],
                          "properties": {
                            "wall_ms": {
                              "type": "number"
                            },
                            "exit_code": {
                              "type": "integer"
                            },
