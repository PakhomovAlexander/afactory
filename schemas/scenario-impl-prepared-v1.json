{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:scenario-impl-prepared:1",
  "title": "scenario-impl-prepared v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "owner",
    "previous_owner",
    "config_digest",
    "repository",
    "repository_id",
    "task_id",
    "result_id",
    "snapshot_id",
    "source_snapshot",
    "source_predecessor",
    "source_commit",
    "branch",
    "base",
    "commit",
    "tree",
    "worktree",
    "title",
    "body"
  ],
  "properties": {
    "schema": {
      "const": "af/scenario-impl-prepared@1"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "previous_owner": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "config_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9_][A-Za-z0-9_.-]{0,99}$"
    },
    "repository_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "result_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_snapshot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_predecessor": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "source_commit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^[0-9a-f]{40}$"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "base": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "commit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^[0-9a-f]{40}$"
    },
    "tree": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^[0-9a-f]{40}$"
    },
    "worktree": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/[^\\x00]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48000
    }
  }
}
