{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:scenario-artifact:1",
  "title": "Portable Scenario artifact v1",
  "description": "A committed local report Scenario and its dependency pins. Semantic admission additionally checks captured path containment, package closure, dependency bytes and compatible receiver authority. Concrete named sources conform to report-sources v1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "definition", "inputs", "packages", "schemas"],
  "properties": {
    "schema": { "const": "af/scenario-artifact@1" },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "step", "result", "task", "limits"],
      "properties": {
        "id": { "$ref": "urn:af:schema:scenario:11#/$defs/name" },
        "step": { "$ref": "urn:af:schema:scenario:11#/$defs/name" },
        "result": { "$ref": "urn:af:schema:scenario:11#/$defs/name" },
        "limits": { "$ref": "urn:af:schema:scenario:11#/properties/limits" },
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "kind_package", "pipeline", "goal", "limits"],
          "properties": {
            "kind": { "$ref": "urn:af:schema:task-contracts:4#/$defs/package" },
            "kind_package": { "$ref": "urn:af:schema:task-contracts:4#/$defs/package" },
            "pipeline": { "$ref": "urn:af:schema:task-contracts:4#/$defs/package" },
            "goal": { "type": "string", "minLength": 1 },
            "limits": { "$ref": "urn:af:schema:task-file:1#/properties/limits" }
          }
        }
      }
    },
    "inputs": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 256,
      "propertyNames": { "$ref": "urn:af:schema:task-contracts:4#/$defs/name" },
      "additionalProperties": { "const": "report_source" }
    },
    "packages": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "propertyNames": { "$ref": "urn:af:schema:task-contracts:4#/$defs/package" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest", "version"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "digest": { "$ref": "urn:af:schema:task-contracts:4#/$defs/digest" },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "schemas": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": { "$ref": "urn:af:schema:scenario:11#/$defs/name" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "digest": { "$ref": "urn:af:schema:task-contracts:4#/$defs/digest" }
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*//)(?!.*/$)(?!.*(?:^|/)(?:\\.{1,2}|\\.git)(?:/|$))[^\\\\\\x00-\\x1f\\x7f]+$"
    }
  }
}
