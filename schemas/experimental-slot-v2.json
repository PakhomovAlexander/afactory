{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:experimental-slot:2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "slot",
    "outer_plan_binding_id",
    "policy_id",
    "protected_oracle_id",
    "allowed_task_kinds",
    "allowed_packages",
    "allowed_worker_package_ids",
    "allowed_efforts",
    "allowed_effects",
    "max_children",
    "max_depth",
    "max_concurrency",
    "max_development_candidates",
    "allowance"
  ],
  "properties": {
    "schema": {
      "const": "af.experimental-slot/2"
    },
    "slot": {
      "$ref": "#/$defs/name"
    },
    "policy_id": {
      "$ref": "#/$defs/id"
    },
    "protected_oracle_id": {
      "$ref": "#/$defs/id"
    },
    "allowed_task_kinds": {
      "$ref": "#/$defs/names"
    },
    "allowed_packages": {
      "$ref": "#/$defs/names"
    },
    "allowed_worker_package_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "allowed_efforts": {
      "$ref": "#/$defs/names"
    },
    "allowed_effects": {
      "$ref": "#/$defs/names"
    },
    "max_children": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "max_depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "max_concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "max_development_candidates": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "allowance": {
      "$ref": "#/$defs/allowance"
    },
    "outer_plan_binding_id": {
      "$ref": "#/$defs/id"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/name"
      }
    },
    "allowance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokens",
        "attempts",
        "wall_ms"
      ],
      "properties": {
        "tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "attempts": {
          "type": "integer",
          "minimum": 1
        },
        "wall_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  },
  "title": "ExperimentalSlot@2"
}
