{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:pipeline-selection:1",
  "title": "Captured Pipeline selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "requested",
    "no_match",
    "candidates",
    "decision"
  ],
  "properties": {
    "schema": {
      "const": "af.pipeline-selection/1"
    },
    "requested": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "fallback"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "fallback": {
              "enum": [
                "refuse",
                "select",
                "generate"
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "no_match": {
      "enum": [
        "refuse",
        "generate"
      ]
    },
    "candidates": {
      "type": "array",
      "maxItems": 129,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pipeline",
          "preferred",
          "priority",
          "state"
        ],
        "properties": {
          "pipeline": {
            "type": "string",
            "minLength": 1
          },
          "preferred": {
            "type": "boolean"
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "state": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "fit"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "compatible"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "reasons"
                ],
                "properties": {
                  "kind": {
                    "const": "no_fit"
                  },
                  "reasons": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "facts"
                ],
                "properties": {
                  "kind": {
                    "const": "unknown_facts"
                  },
                  "facts": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "reason"
                ],
                "properties": {
                  "kind": {
                    "const": "unavailable"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "reason"
                ],
                "properties": {
                  "kind": {
                    "const": "infeasible"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "reason"
                ],
                "properties": {
                  "kind": {
                    "const": "invalid"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        }
      }
    },
    "decision": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "pipeline"
          ],
          "properties": {
            "kind": {
              "const": "selected"
            },
            "pipeline": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "pipelines"
          ],
          "properties": {
            "kind": {
              "const": "ambiguous"
            },
            "pipelines": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "facts"
          ],
          "properties": {
            "kind": {
              "const": "needs_facts"
            },
            "facts": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "unavailable"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "infeasible"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "invalid"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "refused"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "needs_generation"
            }
          }
        }
      ]
    }
  }
}
