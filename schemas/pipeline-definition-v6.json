{
  "description": "The current Task Pipeline format. Briefs, recovery and structural acceptance are explicit capabilities.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "version",
    "contract",
    "accepts",
    "slots",
    "nodes",
    "outputs",
    "coverage",
    "max_attempts",
    "max_parallel"
  ],
  "properties": {
    "schema": {
      "const": "af.pipeline/6"
    },
    "name": {
      "$ref": "urn:af:schema:task-contracts:4#/$defs/package"
    },
    "version": {
      "$ref": "urn:af:schema:task-contracts:4#/$defs/text"
    },
    "contract": {
      "$ref": "#/$defs/contract"
    },
    "accepts": {
      "$ref": "urn:af:schema:task-contracts:4#/$defs/applicability"
    },
    "slots": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:af:schema:task-contracts:4#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/slot"
      },
      "minProperties": 0
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 64
    },
    "outputs": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:af:schema:task-contracts:4#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "urn:af:schema:task-contracts:4#/$defs/valueRef"
      },
      "minProperties": 1
    },
    "coverage": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:af:schema:task-contracts:4#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "urn:af:schema:task-contracts:4#/$defs/valueRef"
      },
      "minProperties": 0
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "max_parallel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:pipeline-definition:6",
  "$defs": {
    "contract": {
      "description": "Public Pipeline ports, including optional Project Brief inputs.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "outputs"
      ],
      "properties": {
        "inputs": {
          "type": "object",
          "propertyNames": {
            "$ref": "urn:af:schema:task-contracts:4#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "#/$defs/inputPort"
          },
          "minProperties": 0
        },
        "outputs": {
          "type": "object",
          "propertyNames": {
            "$ref": "urn:af:schema:task-contracts:4#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "urn:af:schema:task-contracts:4#/$defs/outputPort"
          },
          "minProperties": 1
        }
      }
    },
    "port": {
      "description": "A typed Pipeline port; a Project Brief default requires its explicit variant.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "cardinality",
        "optional",
        "affinity",
        "covers"
      ],
      "properties": {
        "artifact_type": {
          "$ref": "urn:af:schema:task-contracts:4#/$defs/artifactType"
        },
        "cardinality": {
          "$ref": "urn:af:schema:task-contracts:4#/$defs/cardinality"
        },
        "optional": {
          "type": "boolean"
        },
        "affinity": {
          "$ref": "urn:af:schema:task-contracts:4#/$defs/affinity"
        },
        "root_default": {
          "enum": [
            "empty_review_history",
            "project_brief"
          ]
        },
        "brief": {
          "description": "The `[brief.<name>]` variant a `project_brief` root default renders (ADR-0160); allowed only with it.",
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "covers": {
          "type": "array",
          "items": {
            "$ref": "urn:af:schema:task-contracts:4#/$defs/name"
          },
          "uniqueItems": true,
          "minItems": 0,
          "$comment": "Canonical ascending order is required by semantic admission; typed round-trips preserve identity."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "root_default"
            ],
            "properties": {
              "root_default": {
                "const": "empty_review_history"
              }
            }
          },
          "then": {
            "properties": {
              "artifact_type": {
                "const": "af/ReviewHistory@1"
              },
              "cardinality": {
                "const": "one"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "root_default"
            ],
            "properties": {
              "root_default": {
                "const": "project_brief"
              }
            }
          },
          "then": {
            "required": [
              "brief"
            ],
            "properties": {
              "artifact_type": {
                "const": "af/ProjectBrief@1"
              },
              "cardinality": {
                "const": "one"
              },
              "optional": {
                "const": true
              },
              "affinity": {
                "properties": {
                  "kind": {
                    "const": "unbound"
                  }
                }
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "brief"
              ]
            }
          }
        }
      ]
    },
    "inputPort": {
      "allOf": [
        {
          "$ref": "#/$defs/port"
        },
        {
          "properties": {
            "covers": {
              "maxItems": 0
            }
          }
        }
      ]
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker",
        "role",
        "input_type",
        "output_type",
        "min_attempts",
        "max_attempts",
        "allow_local_replacement",
        "independent_from"
      ],
      "properties": {
        "worker": {
          "$ref": "urn:af:schema:task-contracts:4#/$defs/package"
        },
        "role": {
          "$ref": "urn:af:schema:task-contracts:4#/$defs/name"
        },
        "input_type": {
          "$ref": "urn:af:schema:task-contracts:4#/$defs/artifactType"
        },
        "output_type": {
          "$ref": "urn:af:schema:task-contracts:4#/$defs/artifactType"
        },
        "min_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "allow_local_replacement": {
          "type": "boolean"
        },
        "independent_from": {
          "type": "array",
          "items": {
            "$ref": "urn:af:schema:task-contracts:4#/$defs/name"
          },
          "uniqueItems": true,
          "minItems": 0,
          "$comment": "Canonical ascending order is required by semantic admission; typed round-trips preserve identity."
        },
        "recovery_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        }
      },
      "description": "A bounded Worker slot with optional recovery_attempts (0 through 8, absent means 1)."
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operator",
        "inputs"
      ],
      "properties": {
        "id": {
          "$ref": "urn:af:schema:task-contracts:4#/$defs/name"
        },
        "operator": {
          "$ref": "#/$defs/operator"
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "$ref": "urn:af:schema:task-contracts:4#/$defs/name"
          },
          "additionalProperties": {
            "$ref": "urn:af:schema:task-contracts:4#/$defs/valueRef"
          },
          "minProperties": 0
        },
        "when": {
          "$ref": "urn:af:schema:task-contracts:4#/$defs/condition"
        }
      }
    },
    "operator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "slot"
          ],
          "properties": {
            "op": {
              "const": "worker"
            },
            "slot": {
              "$ref": "urn:af:schema:task-contracts:4#/$defs/name"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "enum": [
                "seal",
                "accept"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "checks"
          ],
          "properties": {
            "op": {
              "const": "check"
            },
            "checks": {
              "type": "array",
              "items": {
                "$ref": "urn:af:schema:task-contracts:4#/$defs/name"
              },
              "uniqueItems": true,
              "minItems": 0,
              "$comment": "Run on this machine. Canonical ascending order is required by semantic admission."
            },
            "remote_checks": {
              "type": "array",
              "items": {
                "$ref": "urn:af:schema:task-contracts:4#/$defs/name"
              },
              "uniqueItems": true,
              "minItems": 1,
              "$comment": "Run by each check's declared remote executor (ADR-0140); absent, never empty. A name in both lists is refused by semantic admission. Canonical ascending order is required by semantic admission."
            }
          },
          "anyOf": [
            {
              "properties": {
                "checks": {
                  "minItems": 1
                }
              }
            },
            {
              "required": [
                "remote_checks"
              ]
            }
          ],
          "$comment": "A node names at least one check in all."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "measures"
          ],
          "properties": {
            "op": {
              "const": "measure"
            },
            "measures": {
              "type": "array",
              "items": {
                "$ref": "urn:af:schema:task-contracts:4#/$defs/name"
              },
              "uniqueItems": true,
              "minItems": 1,
              "maxItems": 16,
              "$comment": "One af/Measurement@1 output per named measure of the captured code policy (ADR-0132). Canonical ascending order is required by semantic admission."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "objective"
          ],
          "properties": {
            "op": {
              "const": "compare"
            },
            "objective": {
              "$ref": "urn:af:schema:task-contracts:4#/$defs/name"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "slot"
          ],
          "properties": {
            "op": {
              "const": "verify"
            },
            "slot": {
              "$ref": "urn:af:schema:task-contracts:4#/$defs/name"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "pipeline",
            "bindings"
          ],
          "properties": {
            "op": {
              "const": "call"
            },
            "pipeline": {
              "$ref": "urn:af:schema:task-contracts:4#/$defs/package"
            },
            "bindings": {
              "type": "object",
              "propertyNames": {
                "$ref": "urn:af:schema:task-contracts:4#/$defs/name"
              },
              "additionalProperties": {
                "$ref": "urn:af:schema:task-contracts:4#/$defs/name"
              },
              "minProperties": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "review_bind"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "attest_fixes"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "slot"
          ],
          "properties": {
            "op": {
              "const": "fix_verify"
            },
            "slot": {
              "$ref": "urn:af:schema:task-contracts:4#/$defs/name"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "select"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "review_reduce"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "review_accept"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "repair_accept"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "planning_context"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "document_seal"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "document_check"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "document_accept"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "report_seal"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "report_check"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "report_accept"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "optimization_project"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "baseline_slot",
            "candidate_slot"
          ],
          "properties": {
            "op": {
              "const": "optimization_experiment"
            },
            "baseline_slot": {
              "$ref": "urn:af:schema:task-contracts:4#/$defs/name"
            },
            "candidate_slot": {
              "$ref": "urn:af:schema:task-contracts:4#/$defs/name"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "review_continue"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "optimization_prepare"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "optimization_finalize"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "structured_accept"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "review_bind_integrated"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "reviewers",
            "protected_paths"
          ],
          "properties": {
            "op": {
              "const": "review_integrate"
            },
            "reviewers": {
              "type": "array",
              "uniqueItems": true,
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "$ref": "urn:af:schema:task-contracts:4#/$defs/name"
              }
            },
            "protected_paths": {
              "type": "array",
              "uniqueItems": true,
              "minItems": 0,
              "maxItems": 4096,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "review_commit"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "scatter",
            "max_paths_per_slice",
            "max_fanout"
          ],
          "properties": {
            "op": {
              "const": "review_slice"
            },
            "scatter": {
              "$ref": "urn:af:schema:task-contracts:4#/$defs/name"
            },
            "max_paths_per_slice": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "max_fanout": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "slot",
            "max_fanout"
          ],
          "properties": {
            "op": {
              "const": "review_scatter"
            },
            "slot": {
              "$ref": "urn:af:schema:task-contracts:4#/$defs/name"
            },
            "max_fanout": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "reviewers",
            "closeout"
          ],
          "properties": {
            "op": {
              "const": "review_reduce_shards"
            },
            "reviewers": {
              "type": "array",
              "uniqueItems": true,
              "minItems": 1,
              "maxItems": 63,
              "items": {
                "$ref": "urn:af:schema:task-contracts:4#/$defs/name"
              }
            },
            "closeout": {
              "$ref": "urn:af:schema:task-contracts:4#/$defs/name"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "review_integration_source"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "nodes": {
            "contains": {
              "properties": {
                "operator": {
                  "properties": {
                    "op": {
                      "const": "structured_accept"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "nodes": {
            "items": {
              "properties": {
                "operator": {
                  "properties": {
                    "op": {
                      "enum": [
                        "worker",
                        "structured_accept"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
