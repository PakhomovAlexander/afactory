{
  "$id": "urn:af:schema:ci-signature-state:2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "first_seen_at": {
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "last_seen_at": {
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "occurrences": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "at": {
            "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
            "type": "string"
          },
          "attempt": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "run": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "at",
          "run",
          "attempt"
        ],
        "type": "object"
      },
      "maxProperties": 4096,
      "propertyNames": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "object"
    },
    "repair_count": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "schema": {
      "const": "af.ci-signature-state/2"
    },
    "scopes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "completed_at": {
            "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
            "type": "string"
          },
          "head_sha": {
            "pattern": "^[0-9a-f]{40}$",
            "type": "string"
          },
          "job_name": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[^\\u0000]+$",
            "type": "string"
          },
          "last_seen_at": {
            "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
            "type": "string"
          },
          "platform": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[^\\u0000]+$",
            "type": "string"
          },
          "workflow_id": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "workflow_id",
          "job_name",
          "platform",
          "head_sha",
          "last_seen_at",
          "completed_at"
        ],
        "type": "object"
      },
      "maxItems": 4096,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "transient_count": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema",
    "scopes",
    "first_seen_at",
    "last_seen_at",
    "occurrences",
    "transient_count",
    "repair_count"
  ],
  "title": "Ci signature state v2",
  "type": "object"
}
