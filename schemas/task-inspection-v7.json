{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "revision_id",
    "phase",
    "plan_id",
    "chargeable_tokens",
    "attempts",
    "history",
    "execution_records",
    "run_reports",
    "review_integrations"
  ],
  "dependentRequired": {
    "graph": [
      "plan"
    ],
    "plan": [
      "graph"
    ],
    "delivery": [
      "result"
    ],
    "planning_diagnostic": [
      "result"
    ],
    "repair_assessments": [
      "result"
    ],
    "review_rounds": [
      "result"
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "properties": {
              "kind": {
                "const": "finished"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "result"
        ]
      },
      "else": {
        "not": {
          "required": [
            "result"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "graph"
        ]
      },
      "then": {
        "properties": {
          "plan_id": {
            "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
          }
        }
      }
    }
  ],
  "$id": "urn:af:schema:task-inspection:7",
  "title": "Task inspection af/task-inspection@7",
  "$comment": "Persisted post-Round Integration selection, common Task execution and exact original report/handoff generations. Earlier inspection generations remain unchanged. Historical evidence grants no admission or dispatch authority.",
  "properties": {
    "schema": {
      "const": "af/task-inspection@7"
    },
    "task_id": {
      "$ref": "urn:af:schema:task-inspection:6#/properties/task_id"
    },
    "revision_id": {
      "$ref": "urn:af:schema:task-inspection:6#/properties/revision_id"
    },
    "phase": {
      "$ref": "urn:af:schema:task-inspection:6#/properties/phase"
    },
    "plan_id": {
      "$ref": "urn:af:schema:task-inspection:6#/properties/plan_id"
    },
    "chargeable_tokens": {
      "$ref": "urn:af:schema:task-inspection:6#/properties/chargeable_tokens"
    },
    "attempts": {
      "$ref": "urn:af:schema:task-inspection:6#/properties/attempts"
    },
    "selection": {
      "$ref": "urn:af:schema:task-inspection:6#/properties/selection"
    },
    "planning": {
      "$ref": "urn:af:schema:task-inspection:6#/properties/planning"
    },
    "plan_decisions": {
      "$ref": "urn:af:schema:task-inspection:6#/properties/plan_decisions"
    },
    "history": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "urn:af:schema:task-inspection:6#/properties/history/items"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sequence",
              "transition"
            ],
            "properties": {
              "sequence": {
                "$ref": "urn:af:schema:task-inspection:6#/properties/history/items/oneOf/1/properties/sequence"
              },
              "transition": {
                "$ref": "urn:af:schema:task-transition:3"
              }
            }
          }
        ]
      }
    },
    "execution_records": {
      "$ref": "urn:af:schema:task-inspection:6#/properties/execution_records"
    },
    "run_reports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "report",
          "diagnostics"
        ],
        "properties": {
          "artifact_id": {
            "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
          },
          "report": {
            "oneOf": [
              {
                "$ref": "urn:af:schema:task-run-report:1"
              },
              {
                "$ref": "urn:af:schema:task-run-report:2"
              }
            ]
          },
          "diagnostics": {
            "type": "object",
            "additionalProperties": {
              "$ref": "urn:af:schema:task-diagnostic:1"
            }
          }
        }
      }
    },
    "delivery": {
      "$ref": "urn:af:schema:task-inspection:6#/properties/delivery"
    },
    "result": {
      "$ref": "urn:af:schema:task-inspection:6#/properties/result"
    },
    "planning_diagnostic": {
      "$ref": "urn:af:schema:task-inspection:6#/properties/planning_diagnostic"
    },
    "repair_assessments": {
      "$ref": "urn:af:schema:task-inspection:6#/properties/repair_assessments"
    },
    "review_rounds": {
      "$ref": "urn:af:schema:task-inspection:6#/properties/review_rounds"
    },
    "graph": {
      "$ref": "urn:af:schema:task-inspection:6#/properties/graph"
    },
    "plan": {
      "$ref": "urn:af:schema:task-inspection:6#/properties/plan"
    },
    "owned_child_sets": {
      "$ref": "urn:af:schema:task-inspection:6#/properties/owned_child_sets"
    },
    "review_handoffs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "artifact_type",
              "record"
            ],
            "properties": {
              "artifact_id": {
                "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
              },
              "artifact_type": {
                "const": "af/TaskReviewHandoff@1"
              },
              "record": {
                "$ref": "urn:af:schema:task-review-handoff:1"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "artifact_type",
              "record"
            ],
            "properties": {
              "artifact_id": {
                "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
              },
              "artifact_type": {
                "const": "af/TaskReviewHandoff@2"
              },
              "record": {
                "$ref": "urn:af:schema:task-review-handoff:2"
              }
            }
          }
        ]
      }
    },
    "review_integrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "artifact_type",
          "record",
          "node",
          "requires_checks",
          "finished",
          "report_id",
          "integration_committed_event_id"
        ],
        "properties": {
          "artifact_id": {
            "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
          },
          "artifact_type": {
            "const": "af/TaskReviewIntegrationPhase@1"
          },
          "record": {
            "$ref": "urn:af:schema:task-review-integration-phase:1"
          },
          "node": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(\\.[A-Za-z0-9][A-Za-z0-9_-]{0,127})*$"
          },
          "requires_checks": {
            "type": "boolean"
          },
          "finished": {
            "type": "boolean"
          },
          "report_id": {
            "oneOf": [
              {
                "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
              },
              {
                "type": "null"
              }
            ]
          },
          "integration_committed_event_id": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9]{26}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "record": {
                  "properties": {
                    "selection": {
                      "properties": {
                        "kind": {
                          "const": "prepared"
                        }
                      }
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "requires_checks": {
                  "const": true
                }
              }
            },
            "else": {
              "properties": {
                "requires_checks": {
                  "const": false
                },
                "finished": {
                  "const": true
                },
                "report_id": {
                  "type": "null"
                },
                "integration_committed_event_id": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "finished": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "report_id": {
                  "type": "null"
                },
                "integration_committed_event_id": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "requires_checks": {
                  "const": true
                },
                "finished": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "report_id": {
                  "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "integration_committed_event_id": {
                  "type": "string"
                }
              }
            },
            "then": {
              "properties": {
                "requires_checks": {
                  "const": true
                },
                "finished": {
                  "const": true
                },
                "report_id": {
                  "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
                }
              }
            }
          }
        ]
      }
    }
  }
}
