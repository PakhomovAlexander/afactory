{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-transition:4",
  "title": "TaskTransition@4 recording recovery payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "writer",
    "epoch",
    "now_unix_ms",
    "change"
  ],
  "properties": {
    "writer": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "maxLength": 128
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "now_unix_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "task_revision_id",
        "plan_id",
        "report_id"
      ],
      "properties": {
        "kind": {
          "const": "recording_resumed"
        },
        "task_revision_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "report_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
