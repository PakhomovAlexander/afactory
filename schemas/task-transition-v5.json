{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:af:schema:task-transition:5",
  "title":"TaskTransition@5 adoption observation payload",
  "type":"object","additionalProperties":false,
  "required":["writer","epoch","now_unix_ms","change"],
  "properties":{
    "writer":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_-]*$","maxLength":128},
    "epoch":{"type":"integer","minimum":1,"maximum":9007199254740991},
    "now_unix_ms":{"type":"integer","minimum":1,"maximum":9007199254740991},
    "change":{"type":"object","additionalProperties":false,
      "required":["kind","observation_id"],
      "properties":{"kind":{"const":"adoption_observation_recorded"},"observation_id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}
    }
  }
}
