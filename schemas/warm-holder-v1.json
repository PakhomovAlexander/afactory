{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:warm-holder:1",
  "title": "af.warm-holder/1",
  "description": "The process holding a Warm Check Cache key's lock, written beside the key as `<project>/<toolchain>.holder` once the lock is taken and removed before it is released (ADR-0207). A check that waits for the key prints `waiting for warm layer <key> held by <command> <pid> since <time>` from it every 60 seconds.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "pid",
    "host",
    "since_unix_ms",
    "command"
  ],
  "properties": {
    "schema": {
      "const": "af.warm-holder/1"
    },
    "pid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "host": {
      "$ref": "#/$defs/text"
    },
    "since_unix_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*[^\\s\\u0000-\\u001f\\u007f-\\u009f][^\\u0000-\\u001f\\u007f-\\u009f]*$"
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*[^\\s\\u0000-\\u001f\\u007f-\\u009f][^\\u0000-\\u001f\\u007f-\\u009f]*$"
    }
  }
}
