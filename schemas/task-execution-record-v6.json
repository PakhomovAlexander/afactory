{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-execution-record:6",
  "title": "TaskExecutionRecord@6",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "invocation_id"
      ],
      "properties": {
        "kind": {
          "const": "invocation"
        },
        "invocation_id": {
          "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "invocation_id",
        "attempt_id",
        "reservation_id",
        "reserved_tokens",
        "deadline_unix_ms",
        "feedback_ids"
      ],
      "properties": {
        "kind": {
          "const": "reserved"
        },
        "invocation_id": {
          "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{26}$"
        },
        "reservation_id": {
          "type": "string",
          "pattern": "^reservation:[0-9]{1,20}$"
        },
        "reserved_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deadline_unix_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "feedback_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
          },
          "maxItems": 16,
          "uniqueItems": true
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "attempt_id",
        "context_id"
      ],
      "properties": {
        "kind": {
          "const": "context_bound"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{26}$"
        },
        "context_id": {
          "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "attempt_id"
      ],
      "properties": {
        "kind": {
          "const": "started"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{26}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "attempt_id",
        "launch"
      ],
      "properties": {
        "kind": {
          "const": "codex_launch_armed"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{26}$"
        },
        "launch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "context_id",
            "executable_digest",
            "protocol_digest",
            "runtime_digest",
            "sandbox_digest",
            "reply_schema_digest",
            "submission_digest",
            "nonce",
            "thread_id",
            "mode"
          ],
          "properties": {
            "context_id": {
              "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
            },
            "executable_digest": {
              "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
            },
            "protocol_digest": {
              "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
            },
            "runtime_digest": {
              "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
            },
            "sandbox_digest": {
              "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
            },
            "reply_schema_digest": {
              "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
            },
            "submission_digest": {
              "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
            },
            "nonce": {
              "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
            },
            "thread_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            },
            "mode": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "producer"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "checkpoint_id"
                  ],
                  "properties": {
                    "kind": {
                      "const": "warm_repair"
                    },
                    "checkpoint_id": {
                      "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "fresh_repair"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "attempt_id",
        "launch_id",
        "evidence_id",
        "outcome"
      ],
      "properties": {
        "kind": {
          "const": "codex_launch_resolved"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{26}$"
        },
        "launch_id": {
          "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
        },
        "evidence_id": {
          "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
        },
        "outcome": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "not_dispatched"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "turn_id"
              ],
              "properties": {
                "kind": {
                  "const": "completed"
                },
                "turn_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,128}$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "turn_id"
              ],
              "properties": {
                "kind": {
                  "const": "failed"
                },
                "turn_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,128}$"
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "attempt_id",
        "checkpoint_id"
      ],
      "properties": {
        "kind": {
          "const": "codex_checkpoint_selected"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{26}$"
        },
        "checkpoint_id": {
          "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "attempt_id",
        "reason"
      ],
      "properties": {
        "kind": {
          "const": "released"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{26}$"
        },
        "reason": {
          "type": "string",
          "pattern": "\\S",
          "maxLength": 65536
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "output_id"
      ],
      "properties": {
        "kind": {
          "const": "published"
        },
        "output_id": {
          "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{26}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "attempt_id",
        "charged_tokens",
        "result",
        "raw_artifact_ids"
      ],
      "properties": {
        "kind": {
          "const": "settled"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{26}$"
        },
        "charged_tokens": {
          "$ref": "urn:af:schema:task-token-usage:3#/$defs/decimalU128"
        },
        "result": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "output_id"
              ],
              "properties": {
                "kind": {
                  "const": "succeeded"
                },
                "output_id": {
                  "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "diagnostic_id"
              ],
              "properties": {
                "kind": {
                  "const": "failed"
                },
                "diagnostic_id": {
                  "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
                },
                "feedback_id": {
                  "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "diagnostic_id"
              ],
              "properties": {
                "kind": {
                  "const": "abandoned"
                },
                "diagnostic_id": {
                  "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
                }
              }
            }
          ]
        },
        "raw_artifact_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "usage_id": {
          "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
        },
        "unknown_usage": {
          "description": "No usage was reported: the Attempt is charged zero and its usage is unknown, with its cause (ADR-0143).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cause"
          ],
          "properties": {
            "cause": {
              "enum": [
                "capacity",
                "rate_limit",
                "authentication",
                "model_unavailable",
                "network",
                "lease_expired",
                "interrupted",
                "unreported"
              ]
            }
          }
        }
      },
      "dependentSchemas": {
        "unknown_usage": {
          "properties": {
            "charged_tokens": {
              "const": "0"
            }
          },
          "not": {
            "required": [
              "usage_id"
            ]
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "attempt_id",
        "charged_tokens",
        "usage_id",
        "raw_artifact_ids"
      ],
      "properties": {
        "kind": {
          "const": "usage_observed"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{26}$"
        },
        "charged_tokens": {
          "$ref": "urn:af:schema:task-token-usage:3#/$defs/decimalU128"
        },
        "usage_id": {
          "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
        },
        "raw_artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "child_set_id"
      ],
      "properties": {
        "kind": {
          "const": "owned_children_registered"
        },
        "child_set_id": {
          "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "child_set_id",
        "output_id",
        "attempt_id"
      ],
      "properties": {
        "kind": {
          "const": "owned_child_published"
        },
        "child_set_id": {
          "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
        },
        "output_id": {
          "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{26}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "child_set_id",
        "output_id"
      ],
      "properties": {
        "kind": {
          "const": "owned_children_completed"
        },
        "child_set_id": {
          "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
        },
        "output_id": {
          "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "prepared_id"
      ],
      "properties": {
        "kind": {
          "const": "experiment_prepared"
        },
        "prepared_id": {
          "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "prepared_id",
        "decision_id"
      ],
      "properties": {
        "kind": {
          "const": "experiment_plan_decided"
        },
        "prepared_id": {
          "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
        },
        "decision_id": {
          "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "prepared_id",
        "decision_id",
        "child_plan_id"
      ],
      "properties": {
        "kind": {
          "const": "experiment_children_registered"
        },
        "prepared_id": {
          "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
        },
        "decision_id": {
          "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
        },
        "child_plan_id": {
          "$ref": "urn:af:schema:task-contracts:4#/$defs/digest"
        }
      }
    }
  ]
}
