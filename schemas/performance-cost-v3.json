{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:performance-cost:3",
  "title": "af.perf-cost/3",
  "description": "A cost demonstration (ADR-0183, ADR-0184): every retained pull-request and same-source run, failed attempts included, with its observed cold or warm build cache, source, plan, bundle, build and binary identities, build and per-shard sampling time, per-case sample counts and wall time, artifact bytes and failures; each group's completed and failed runs, the median and maximum of its completed runs, and whether five distinct completed measured comparisons demonstrate it.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "af.perf-cost/3"
    },
    "status": {
      "type": "string",
      "enum": [
        "demonstrated",
        "pending"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4096
      },
      "minItems": 0,
      "maxItems": 64
    },
    "runs_per_group": {
      "const": 5
    },
