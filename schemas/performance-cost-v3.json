  "$defs": {
    "digest": {
      "type": "string",
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "git_sha": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "rational": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:/[1-9][0-9]*)?$",
      "description": "Exact signed rational in lowest terms, such as -3/4 or 2."
    }
  }
