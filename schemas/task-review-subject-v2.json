{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-review-subject:2",
  "title": "TaskReviewSubject@2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject_id",
    "snapshot_id",
    "prior_history_id",
    "round",
    "subject"
  ],
  "properties": {
    "subject_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    },
    "snapshot_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    },
    "prior_history_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "subject": {
      "$ref": "urn:review-kernel:schema:subject:1"
    },
    "change_scope": {
      "$ref": "#/$defs/scope"
    },
    "continuation_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "subject": {
            "properties": {
              "kind": {
                "const": "diff"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "change_scope"
        ]
      },
      "else": {
        "not": {
          "required": [
            "change_scope"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "continuation_id"
        ]
      },
      "then": {
        "properties": {
          "round": {
            "minimum": 2
          }
        }
      }
    }
  ],
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed_paths",
        "renames",
        "rename_detection_truncated",
        "git_version",
        "diff_policy_version",
        "patch"
      ],
      "properties": {
        "changed_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:review-kernel:schema:change-set:1#/$defs/path"
          },
          "minItems": 1
        },
        "renames": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "urn:review-kernel:schema:change-set:1#/$defs/rename"
          }
        },
        "rename_detection_truncated": {
          "description": "True when Git preserved the complete add/delete path set but skipped exhaustive rename linkage at the recorded policy limit.",
          "type": "boolean"
        },
        "git_version": {
          "type": "string",
          "minLength": 1
        },
        "diff_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "patch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "content_id",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^\\.af-review-inputs/[0-9a-f]{64}\\.patch$"
            },
            "content_id": {
              "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4194304
            }
          }
        }
      }
    }
  }
}
