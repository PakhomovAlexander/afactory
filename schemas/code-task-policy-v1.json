{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:code-task-policy:1",
  "title": "Code Task policy af.code-task-policy/1",
  "description": "The captured form of a repository's `.af/code-policy.toml`: the named checks a code Task runs against a read-only Snapshot and, optionally, the Warm Check Cache those checks may use (ADR-0123). A policy without `warm` is captured exactly as before the table existed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "checks", "check_wall_ms", "require_container"],
  "properties": {
    "schema": {"const": "af.code-task-policy/1"},
    "checks": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {"$ref": "#/$defs/name"},
      "additionalProperties": {"$ref": "#/$defs/check"}
    },
    "check_wall_ms": {
      "description": "The whole check Attempt's wall. At most 3600000, or the per-check wall times the number of checks when that is larger.",
      "type": "integer",
      "minimum": 1,
      "maximum": 115200000
    },
    "check_process_wall_ms": {"type": "integer", "minimum": 1, "maximum": 3600000},
    "require_container": {"type": "boolean"},
    "warm": {"$ref": "#/$defs/warm"}
  },
  "if": {"properties": {"require_container": {"const": true}}, "required": ["warm"]},
  "then": false,
  "$defs": {
    "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "arg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "provenance"],
      "properties": {
        "value": {"type": "string"},
        "provenance": {"enum": ["literal", "untrusted"]}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command", "required"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "required": {"type": "boolean"},
        "command": {
          "type": "object",
          "additionalProperties": false,
          "required": ["program", "args"],
          "properties": {
            "program": {"type": "string", "minLength": 1},
            "args": {"type": "array", "items": {"$ref": "#/$defs/arg"}}
          }
        }
      }
    },
    "warm": {
      "description": "An explicitly unsafe, machine-local layer only a trusted_local check touches: a toolchain-keyed, byte-bounded build directory and administrator-approved Cache Snapshots. Refused together with require_container = true.",
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{"required": ["build_cache"]}, {"required": ["caches"]}],
      "properties": {
        "build_cache": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["cargo_target"]}
        },
        "caches": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["cargo"]}
        },
        "max_bytes": {
          "description": "The directory's byte bound; 8 GiB when absent.",
          "type": "integer",
          "minimum": 1,
          "maximum": 34359738368
        }
      }
    }
  }
}
