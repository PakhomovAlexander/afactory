{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:worker-reply-reask:1",
  "title": "af/WorkerReplyReask@1 payload",
  "description": "What the kernel tells a model Worker whose typed reply did not parse when it asks it once more within the same Attempt (ADR-0208): the parse error with its line and column, the offending excerpt, and the CAS digest of the whole reply the Attempt keeps as raw evidence. It travels as one more feedback value of the re-sent request and grants nothing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "instruction",
    "error",
    "excerpt",
    "raw_reply_id"
  ],
  "properties": {
    "schema": {
      "const": "af/WorkerReplyReask@1"
    },
    "instruction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "\\S"
    },
    "error": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "line": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "column": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "excerpt": {
      "type": "string",
      "maxLength": 512
    },
    "raw_reply_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
