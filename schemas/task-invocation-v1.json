{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-invocation:1",
  "title": "task-invocation@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "node",
    "inputs"
  ],
  "properties": {
    "plan_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    },
    "node": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(\\.[A-Za-z0-9][A-Za-z0-9_-]{0,127})*$"
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:af:schema:task-contracts:1#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "urn:af:schema:task-contracts:1#/$defs/artifactInput"
      }
    }
  }
}
