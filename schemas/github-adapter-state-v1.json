{
  "$id": "urn:af:schema:github-adapter-state:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "GitHub Scenario adapter v1. Semantic validation also binds exact identities, scope and durable state.",
  "properties": {
    "checksum": {
      "maxLength": 65536,
      "minLength": 1,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "config_digest": {
      "maxLength": 65536,
      "minLength": 1,
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "records": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "maxLength": 1000,
                "minLength": 1,
                "type": "string"
              }
            ]
          },
          "object": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "maximum": 9007199254740991,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "number": {
                    "maximum": 9007199254740991,
                    "minimum": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "id",
                  "number"
                ],
                "type": "object"
              }
            ]
          },
          "phase": {
            "enum": [
              "prepared",
              "dispatched",
              "done",
              "failed"
            ]
          },
          "request": {
            "additionalProperties": false,
            "properties": {
              "destination": {
                "maxLength": 65536,
                "minLength": 1,
                "type": "string"
              },
              "input_digest": {
                "maxLength": 65536,
                "minLength": 1,
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              "inputs": {
                "additionalProperties": {
                  "$ref": "urn:af:schema:scenario:1#/$defs/Datum"
                },
                "type": "object"
              },
              "intent_id": {
                "maxLength": 65536,
                "minLength": 1,
                "pattern": "^sha256:[0-9a-f]{64}$",
                "type": "string"
              },
              "operation": {
                "enum": [
                  "publish_pr",
                  "followup",
                  "notify"
                ]
              },
              "schema": {
                "const": "af/scenario-adapter-request@1"
              }
            },
            "required": [
              "schema",
              "intent_id",
              "input_digest",
              "operation",
              "destination",
              "inputs"
            ],
            "type": "object"
          },
          "request_digest": {
            "maxLength": 65536,
            "minLength": 1,
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "request",
          "request_digest",
          "phase",
          "object",
          "evidence"
        ],
        "type": "object"
      },
      "maxProperties": 4096,
      "propertyNames": {
        "maxLength": 65536,
        "minLength": 1,
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "object"
    },
    "schema": {
      "const": "af/github-adapter-state@1"
    }
  },
  "required": [
    "schema",
    "config_digest",
    "checksum",
    "records"
  ],
  "type": "object"
}
