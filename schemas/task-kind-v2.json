{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-kind:2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "version",
    "kind",
    "profile"
  ],
  "properties": {
    "schema": {
      "const": "af.task-kind/2"
    },
    "name": {
      "$ref": "urn:af:schema:task-contracts:3#/$defs/package"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "kind": {
      "allOf": [
        {
          "$ref": "urn:af:schema:task-contracts:3#/$defs/package"
        },
        {
          "not": {
            "enum": [
              "implement",
              "review",
              "document",
              "report",
              "optimize",
              "verification"
            ]
          }
        }
      ]
    },
    "profile": {
      "const": "structured"
    }
  }
}
