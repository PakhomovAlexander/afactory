{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:review-kernel:schema:shard-set:1",
  "title": "ShardSet@1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject_id", "slice_set_id", "all_shards_required", "shards"],
  "properties": {
    "subject_id": { "$ref": "#/$defs/digest" },
    "slice_set_id": { "$ref": "#/$defs/digest" },
    "all_shards_required": { "type": "boolean" },
    "shards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slice_id", "runtime_node_id", "outcome"],
        "properties": {
          "slice_id": { "$ref": "#/$defs/digest" },
          "runtime_node_id": { "type": "string", "minLength": 1 },
          "outcome": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "result_artifact_ids"],
                "properties": {
                  "kind": { "const": "completed" },
                  "result_artifact_ids": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/digest" }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "reason"],
                "properties": {
                  "kind": { "const": "failed" },
                  "reason": { "type": "string", "minLength": 1 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "reason"],
                "properties": {
                  "kind": { "const": "missing" },
                  "reason": { "type": "string", "minLength": 1 }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
