{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:performance-evidence-packet:1",
  "title": "af.perf-evidence-packet/1",
  "description": "Native Scenario lab integration.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "af.perf-evidence-packet/1"
    },
    "cutoff_unix_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740992
    },
    "created_unix_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740992
    },
    "max_age_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 31536000000
    },
    "compatibility": {
      "$ref": "#/$defs/digest"
    },
    "max_items": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "max_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65536
    },
    "index_digest": {
      "$ref": "#/$defs/digest"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "finding",
                  "performance",
                  "telemetry"
                ]
              },
              "source_id": {
                "$ref": "#/$defs/digest"
              },
              "source_digest": {
                "$ref": "#/$defs/digest"
              },
              "provenance": {
                "type": "string",
                "enum": [
                  "verified_native",
                  "native_journal",
                  "captured_artifact"
                ]
              },
              "freshness_basis": {
                "type": "string",
                "enum": [
                  "native_terminal",
                  "native_created",
                  "native_cutoff",
                  "capture_observed"
                ]
              },
              "observed_unix_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740992
              },
              "compatibility": {
                "$ref": "#/$defs/digest"
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "positive",
                  "negative",
                  "inconclusive",
                  "merged",
                  "diagnostic"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "required": [
              "kind",
              "source_id",
              "source_digest",
              "provenance",
              "freshness_basis",
              "observed_unix_ms",
              "compatibility",
              "outcome",
              "summary"
            ]
          },
          "fresh": {
            "type": "boolean"
          },
          "compatible": {
            "type": "boolean"
          }
        },
        "required": [
          "artifact",
          "fresh",
          "compatible"
        ]
      },
      "minItems": 0,
      "maxItems": 256
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "future",
              "item_limit",
              "byte_limit"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          }
        },
        "required": [
          "reason",
          "count"
        ]
      },
      "minItems": 0,
      "maxItems": 3
    },
    "telemetry_is_diagnostic": {
      "const": true
    }
  },
  "required": [
    "schema",
    "cutoff_unix_ms",
    "created_unix_ms",
    "max_age_ms",
    "compatibility",
    "max_items",
    "max_bytes",
    "index_digest",
    "items",
    "omissions",
    "telemetry_is_diagnostic"
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
