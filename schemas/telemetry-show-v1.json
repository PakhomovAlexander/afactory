{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:telemetry-show:1",
  "title": "af/telemetry-show@1",
  "description": "`af telemetry show RUN --json` (design §10; ADR-0153): one run's span tree, from each execution's `af.command` through `af.run`, `af.authority.load`, `af.plan`, every `af.node` and its `af.attempt`, to the command's `af.sweep`, in depth-first order with children by start time. Each span carries its start offset from the run's first record, total and self time (total less the union of its ended children, clipped to it) in microseconds, `status` (`ok`, `error`, `unset`, or `open` when it has no recorded end) and its key attributes (every attribute with `--span`, which also lists that span's events). The run carries its retained executions — every one in full (`list`), the sealed ones' ordinals (`sealed`) and, beside them, every open one (`open`: its segment is live or unsealed, or its `af.run` has no recorded end) — its history (`prefix:k` or `partial`, never complete) and its label (`retained executions 1–k` only when none is open, otherwise naming the open ones: `retained executions 1–k, open: m…`). Telemetry ids carry no authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "directory",
    "index",
    "run",
    "spans",
    "unreadable"
  ],
  "properties": {
    "schema": {
      "const": "af/telemetry-show@1"
    },
    "directory": {
      "type": "string"
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "fresh",
            "direct",
            "absent"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "store_id",
        "run_id",
        "trace_id",
        "history",
        "missing_ordinals",
        "retained",
        "executions",
        "first_start_unix_ns"
      ],
      "properties": {
        "store_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "kind": {
          "type": "string"
        },
        "history": {
          "type": "string",
          "pattern": "^(prefix:(0|[1-9][0-9]*)|partial)$"
        },
        "missing_ordinals": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "retained": {
          "type": "string",
          "minLength": 1
        },
        "executions": {
          "$ref": "#/$defs/executions"
        },
        "first_start_unix_ns": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      }
    },
    "spans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "span_id",
          "name",
          "depth",
          "segment_id",
          "start_offset_us",
          "status",
          "attributes"
        ],
        "properties": {
          "span_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "parent_span_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "depth": {
            "type": "integer",
            "minimum": 0
          },
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "start_offset_us": {
            "type": "integer",
            "minimum": 0
          },
          "total_us": {
            "type": "integer",
            "minimum": 0
          },
          "self_us": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "ok",
              "error",
              "unset",
              "open"
            ]
          },
          "attributes": {
            "type": "object"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seq",
          "name",
          "time_unix_ns",
          "offset_us",
          "attributes"
        ],
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "time_unix_ns": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "offset_us": {
            "type": "integer",
            "minimum": 0
          },
          "attributes": {
            "type": "object"
          },
          "blob": {
            "type": "string"
          }
        }
      }
    },
    "unreadable": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id",
        "span_id",
        "ordinal",
        "start_unix_ns",
        "end_unix_ns",
        "open",
        "wall_us",
        "segment"
      ],
      "properties": {
        "execution_id": {
          "type": "string",
          "minLength": 1
        },
        "span_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "ordinal": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "store_sequence_at_start": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "start_unix_ns": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "end_unix_ns": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "open": {
          "type": "boolean"
        },
        "wall_us": {
          "type": "integer",
          "minimum": 0
        },
        "segment": {
          "enum": [
            "live",
            "unsealed",
            "sealed"
          ]
        },
        "outcome": {
          "type": "string"
        }
      }
    },
    "open_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id",
        "segment"
      ],
      "properties": {
        "execution_id": {
          "type": "string",
          "minLength": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "segment": {
          "enum": [
            "live",
            "unsealed",
            "sealed"
          ]
        }
      }
    },
    "executions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retained",
        "sealed",
        "open",
        "list"
      ],
      "properties": {
        "retained": {
          "type": "integer",
          "minimum": 0
        },
        "sealed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "open": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/open_execution"
          }
        },
        "list": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/execution"
          }
        }
      }
    }
  }
}
