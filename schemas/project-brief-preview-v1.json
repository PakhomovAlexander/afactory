{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:project-brief-preview:1",
  "title": "af/project-brief-preview@1",
  "description": "What `af project brief --json` prints (ADR-0160): the artifact ID a plan would bind, the Brief byte for byte as the text form prints it, and the context manifest entry a Worker wired to the port would see; or the `none` outcome and its reason. Recorded nowhere.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "variant",
    "outcome"
  ],
  "properties": {
    "schema": {
      "const": "af/project-brief-preview@1"
    },
    "variant": {
      "$ref": "urn:af:schema:project-brief:1#/$defs/name"
    },
    "outcome": {
      "enum": [
        "brief",
        "none"
      ]
    },
    "reason": {
      "enum": [
        "variant_none",
        "no_survey"
      ]
    },
    "brief_id": {
      "$ref": "urn:af:schema:project-survey:2#/$defs/digest"
    },
    "brief": {
      "$ref": "urn:af:schema:project-brief:1"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "required_by",
        "artifact_id",
        "artifact_type",
        "rendered_bytes",
        "estimated_tokens"
      ],
      "properties": {
        "name": {
          "$ref": "urn:af:schema:project-brief:1#/$defs/name"
        },
        "required_by": {
          "type": "string",
          "pattern": "^port:[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "artifact_id": {
          "$ref": "urn:af:schema:project-survey:2#/$defs/digest"
        },
        "artifact_type": {
          "const": "af/ProjectBrief@1"
        },
        "rendered_bytes": {
          "description": "The bytes of the Worker value the runner renders.",
          "$ref": "urn:af:schema:project-survey:2#/$defs/decimal"
        },
        "estimated_tokens": {
          "description": "The runner's estimate: the bytes divided by four, rounded up.",
          "$ref": "urn:af:schema:project-survey:2#/$defs/decimal"
        }
      }
    }
  },
  "if": {
    "properties": {
      "outcome": {
        "const": "brief"
      }
    }
  },
  "then": {
    "required": [
      "brief_id",
      "brief",
      "manifest"
    ],
    "not": {
      "required": [
        "reason"
      ]
    }
  },
  "else": {
    "required": [
      "reason"
    ],
    "not": {
      "anyOf": [
        {
          "required": [
            "brief_id"
          ]
        },
        {
          "required": [
            "brief"
          ]
        },
        {
          "required": [
            "manifest"
          ]
        }
      ]
    }
  }
}
