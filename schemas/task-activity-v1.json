{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-activity:1",
  "title": "af/task-activity/1",
  "description": "One disposable activity ring slot, not a CAS artifact or execution event. Task/Attempt identities are bound by the host; all provider-derived metadata is a closed enum.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "attempt_id", "sequence", "unix_ms", "operation", "phase"],
  "properties": {
    "schema": {"const": "af/task-activity/1"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[!-~]+$"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "unix_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "operation": {"enum": ["worker", "command", "file_change", "tool", "observation"]},
    "phase": {"enum": ["started", "completed", "failed", "dropped", "truncated"]}
  },
  "if": {"properties": {"operation": {"const": "observation"}}},
  "then": {"properties": {"phase": {"enum": ["dropped", "truncated"]}}},
  "else": {"properties": {"phase": {"enum": ["started", "completed", "failed"]}}}
}
