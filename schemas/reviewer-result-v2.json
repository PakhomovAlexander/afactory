{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:review-kernel:schema:reviewer-result:2",
  "title": "ReviewerResult@2 payload",
  "description": "Additive reviewer result contract with one explicit disposition for every assigned prior Finding. Assignment coverage is checked against the exact input FindingSet@1 by the kernel.",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "reports", "benchmark_demands", "dispositions"],
  "properties": {
    "verdict": { "enum": ["approve", "request-changes", "block"] },
    "summary": { "type": ["string", "null"] },
    "reports": {
      "type": "array",
      "items": { "$ref": "urn:review-kernel:schema:reviewer-result:1#/$defs/legacyReport" }
    },
    "benchmark_demands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "why", "suggested_method"],
        "properties": {
          "claim": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 },
          "suggested_method": { "type": "string", "minLength": 1 }
        }
      }
    },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "position", "reason"],
        "properties": {
          "finding_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "position": { "enum": ["corroborate", "not_reproduced", "dispute"] },
          "reason": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    }
  }
}
