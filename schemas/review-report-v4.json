{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:review-report-view:4",
  "title": "af/review-report@4 inspection view",
  "description": "Task-backed Review inspection. Task totals are current cumulative ledger charges; Round snapshots are frozen cumulative charges and must not be summed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "campaign", "runs_recorded", "ledger_round", "final_verdict", "rounds", "task_accounting", "demands", "findings_summary", "findings"],
  "properties": {
    "schema": {"const": "af/review-report@4"},
    "campaign": {"type": "string"},
    "runs_recorded": {"$ref": "#/$defs/count"},
    "ledger_round": {"$ref": "#/$defs/count"},
    "final_verdict": {"type": ["string", "null"]},
    "rounds": {"type": "array", "items": {"$ref": "#/$defs/round"}},
    "task_accounting": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}},
    "demands": {"type": "array", "items": {"type": "object"}},
    "wall_ms": {"$ref": "#/$defs/count"},
    "findings_summary": {"type": "object"},
    "findings": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "digest": {"$ref": "urn:af:schema:task-contracts:1#/$defs/digest"},
    "decimalU64": {"$ref": "urn:af:schema:task-token-usage:1#/$defs/decimalU64"},
    "decimalU128": {"$ref": "urn:af:schema:task-review-accounting:1#/$defs/decimalU128"},
    "round": {
      "type": "object", "additionalProperties": false,
      "required": ["run", "verdict"],
      "dependentRequired": {
        "task_chargeable_tokens_at_report": ["task_accounting"],
        "task_accounting": ["task_chargeable_tokens_at_report"]
      },
      "not": {"required": ["reported_tokens", "task_chargeable_tokens_at_report"]},
      "properties": {
        "run": {"$ref": "#/$defs/count"},
        "round": {"$ref": "#/$defs/count"},
        "epoch": {"$ref": "#/$defs/count"},
        "verdict": {"type": "string"},
        "reported_tokens": {"$ref": "#/$defs/count"},
        "task_chargeable_tokens_at_report": {"$ref": "#/$defs/decimalU128"},
        "task_accounting": {"$ref": "urn:af:schema:task-review-accounting:1"}
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "through_sequence", "chargeable_tokens", "reserved_tokens", "attempts_started", "provider_attempts_started", "business_attempts_started", "other_attempts_started", "attempts"],
      "properties": {
        "task_id": {"$ref": "urn:af:schema:task-contracts:1#/$defs/name"},
        "through_sequence": {"$ref": "#/$defs/count"},
        "chargeable_tokens": {"$ref": "#/$defs/decimalU128"},
        "reserved_tokens": {"$ref": "#/$defs/decimalU128"},
        "attempts_started": {"$ref": "#/$defs/decimalU64"},
        "provider_attempts_started": {"$ref": "#/$defs/decimalU64"},
        "business_attempts_started": {"$ref": "#/$defs/decimalU64"},
        "other_attempts_started": {"$ref": "#/$defs/decimalU64"},
        "wall_ms": {"$ref": "#/$defs/count"},
        "attempts": {"type": "array", "items": {"$ref": "#/$defs/attempt"}}
      }
    },
    "attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "invocation_id", "plan_id", "node", "category", "binding_slots", "started", "outcome", "reservation_id", "reserved_tokens", "chargeable_tokens"],
      "properties": {
        "attempt_id": {"type": "string"},
        "invocation_id": {"$ref": "#/$defs/digest"},
        "plan_id": {"$ref": "#/$defs/digest"},
        "node": {"type": "string"},
        "category": {"enum": ["provider", "business", "other"]},
        "review_node": {"type": "string"},
        "binding_slots": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "round": {"$ref": "#/$defs/count"},
        "epoch": {"$ref": "#/$defs/count"},
        "started": {"type": "boolean"},
        "outcome": {"enum": ["failed", "abandoned", "fenced", "selected", "released", "running", "reserved"]},
        "reservation_id": {"type": "string"},
        "reserved_tokens": {"$ref": "#/$defs/decimalU64"},
        "chargeable_tokens": {"$ref": "#/$defs/decimalU128"},
        "result": {"$ref": "#/$defs/result"},
        "wall": {
          "type": "object", "additionalProperties": false, "required": ["started_unix_ms", "elapsed_ms"],
          "properties": {
            "started_unix_ms": {"$ref": "#/$defs/count"},
            "elapsed_ms": {"$ref": "#/$defs/count"},
            "usage": {"$ref": "urn:af:schema:task-token-usage:3"}
          }
        }
      }
    },
    "result": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "output_id"], "properties": {"kind": {"const": "succeeded"}, "output_id": {"$ref": "#/$defs/digest"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "diagnostic_id"], "properties": {"kind": {"const": "failed"}, "diagnostic_id": {"$ref": "#/$defs/digest"}, "feedback_id": {"$ref": "#/$defs/digest"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "diagnostic_id"], "properties": {"kind": {"const": "abandoned"}, "diagnostic_id": {"$ref": "#/$defs/digest"}}}
      ]
    }
  }
}
