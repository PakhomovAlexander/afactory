{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:pi-context:1",
  "title": "Explicit private Pi credential/configuration context @1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "const": "af.pi-context/1"
    },
    "environment": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?!(NODE_|PI_|HOME$|XDG_|PATH$|LD_|DYLD_))[A-Z][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "extension": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entrypoint",
            "sha256"
          ],
          "properties": {
            "entrypoint": {
              "type": "string",
              "pattern": "^/"
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        }
      ]
    }
  }
}
