{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-cancel-request:1",
  "title": "Task cancel request af/task-cancel-request@1",
  "$comment": "A request to cancel one run: `runs/<task>-<run>.cancel.json`, written by `af task cancel` before it signals the run's process (ADR-0202). `epoch` and `writer` are those of the lease the run held, so the Task's state is `abandoned/cancelled/host_cancelled` exactly for the run it stopped; `requester` is who asked.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "run",
    "epoch",
    "writer",
    "pid",
    "host",
    "requester",
    "requested_unix_ms"
  ],
  "properties": {
    "schema": {
      "const": "af/task-cancel-request@1"
    },
    "task_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/name"
    },
    "run": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "writer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "pid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "requester": {
      "$ref": "#/$defs/requester"
    },
    "requested_unix_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "$defs": {
    "requester": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user",
        "host",
        "pid"
      ],
      "properties": {
        "user": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        },
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    }
  }
}
