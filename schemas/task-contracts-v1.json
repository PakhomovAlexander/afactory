              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(\\.[A-Za-z0-9][A-Za-z0-9_-]{0,127})+$"
            },
            "uniqueItems": true,
            "minItems": 1,
            "$comment": "Canonical ascending order is required by semantic admission."
          },
          "minProperties": 1
        }
      }
    },
