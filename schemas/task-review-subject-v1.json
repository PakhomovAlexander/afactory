{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-review-subject:1",
  "title": "task-review-subject@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject_id",
    "snapshot_id",
    "prior_history_id",
    "round",
    "subject"
  ],
  "properties": {
    "subject_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    },
    "snapshot_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    },
    "prior_history_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "subject": {
      "$ref": "urn:review-kernel:schema:subject:1"
    },
    "change_set": {
      "$ref": "urn:review-kernel:schema:change-set:1"
    },
    "continuation_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "subject": {
            "properties": {
              "kind": {
                "const": "diff"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "change_set"
        ]
      },
      "else": {
        "not": {
          "required": [
            "change_set"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "continuation_id"
        ]
      },
      "then": {
        "properties": {
          "round": {
            "minimum": 2
          }
        }
      }
    }
  ]
}
