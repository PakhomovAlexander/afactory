{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:scenario-evidence-source:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "revision_id",
    "artifact"
  ],
  "properties": {
    "schema": {
      "const": "af/scenario-evidence-source@1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifact": {
      "$ref": "urn:review-kernel:schema:artifact-envelope:1"
    }
  },
  "title": "Native Scenario research evidence source v1"
}
