{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:review-kernel:schema:cache-manifest:1",
  "title": "CacheManifest@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "path_encoding", "entries"],
  "properties": {
    "kind": { "const": "cargo" },
    "path_encoding": { "const": "percent_v2" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content", "size"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "content": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 0, "maximum": 4294967296 }
        }
      }
    }
  }
}
