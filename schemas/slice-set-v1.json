{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:review-kernel:schema:slice-set:1",
  "title": "SliceSet@1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject_id", "coverage", "max_fanout", "all_shards_required", "closeout", "slices"],
  "properties": {
    "subject_id": { "$ref": "#/$defs/digest" },
    "coverage": { "enum": ["complete", "explicit_partial"] },
    "max_fanout": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "all_shards_required": { "type": "boolean" },
    "closeout": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "required" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "policy_id", "reason"], "properties": { "kind": { "const": "waived" }, "policy_id": { "$ref": "#/$defs/digest" }, "reason": { "type": "string", "minLength": 1 } } }
      ]
    },
    "slices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slice_id", "runtime_node_id", "paths"],
        "properties": {
          "slice_id": { "$ref": "#/$defs/digest" },
          "runtime_node_id": { "type": "string", "minLength": 1 },
          "paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "overlaps": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
