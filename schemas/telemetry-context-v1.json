{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:telemetry-context:1",
  "title": "af/telemetry-context@1",
  "description": "`af telemetry context RUN ATTEMPT --json` (design §7.1, §8, §10; ADR-0153): the composed Worker input of one Attempt as the content level kept it. `state` is `captured` (the prompt's blob was read), `not_captured` (its execution recorded below `content`; `level` names it) or `unavailable` (no `af.context.compose` was recorded, the allowance dropped the content, or its blob file is gone; `reason` says which). The compose span's own attributes are given at every level: the Worker context artifact it is bound to (`manifest`), the rendered bytes, the estimated tokens as an exact decimal string and the layers in manifest order. At `content` `input` is the prompt bytes the Worker received (`gen_ai.content.input`; its `source_digest` is over those bytes and `original_bytes` their length) and `system` the context manifest they were composed by (`gen_ai.content.system`); in the request the artifact and Snapshot ids of each value keep, in the manifest every identity member keeps. Every byte shown is a blob's retained bytes, redacted whole (credential-looking lines and values withheld, grant values and the home prefix replaced) before any truncation when it was kept, read under `gc.lock` shared and verified against its digest; a content that cannot be shown says why (`reason`). The run carries its history (`prefix:k` or `partial`, never complete) and the label of the executions retained. Telemetry ids carry no authority, and no Worker ever reads this content (ADR-0153).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "directory",
    "index",
    "run",
    "attempt",
    "state",
    "layers",
    "unreadable"
  ],
  "properties": {
    "schema": {
      "const": "af/telemetry-context@1"
    },
    "directory": {
      "type": "string"
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "fresh",
            "direct",
            "absent"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "store_id",
        "run_id",
        "trace_id",
        "history",
        "missing_ordinals",
        "retained"
      ],
      "properties": {
        "store_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "run_id": {
          "type": "string"
        },
        "trace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "history": {
          "type": "string",
          "pattern": "^(prefix:(0|[1-9][0-9]*)|partial)$"
        },
        "missing_ordinals": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "retained": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      }
    },
    "attempt": {
      "type": "string"
    },
    "state": {
      "enum": [
        "captured",
        "not_captured",
        "unavailable"
      ]
    },
    "reason": {
      "type": "string"
    },
    "compose_span_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "level": {
      "enum": [
        "metrics",
        "spans",
        "content",
        "unknown"
      ]
    },
    "manifest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rendered_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "estimated_tokens": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "span_id",
        "segment_id",
        "seq",
        "time_unix_ns",
        "truncated",
        "state"
      ],
      "properties": {
        "event": {
          "type": "string"
        },
        "span_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "segment_id": {
          "type": "string"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "time_unix_ns": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "occurrence_id": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "original_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "retained_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "media_type": {
          "type": "string"
        },
        "state": {
          "enum": [
            "stored",
            "unavailable"
          ]
        },
        "reason": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "span_id",
        "segment_id",
        "seq",
        "time_unix_ns",
        "truncated",
        "state"
      ],
      "properties": {
        "event": {
          "type": "string"
        },
        "span_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "segment_id": {
          "type": "string"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "time_unix_ns": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "occurrence_id": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "original_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "retained_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "media_type": {
          "type": "string"
        },
        "state": {
          "enum": [
            "stored",
            "unavailable"
          ]
        },
        "reason": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      }
    },
    "unreadable": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
