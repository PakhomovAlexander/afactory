{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:broker-operation-receipt:2",
  "title": "BrokerOperationReceipt@2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "handle_id",
    "node",
    "attempt_id",
    "lease_epoch",
    "operation",
    "destination",
    "method",
    "ordinal",
    "outcome",
    "request_digest",
    "request_bytes",
    "response_bytes",
    "reserved_usage",
    "charged_usage"
  ],
  "properties": {
    "handle_id": {
      "$ref": "#/$defs/id"
    },
    "node": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "$ref": "#/$defs/id"
    },
    "lease_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "operation": {
      "$ref": "#/$defs/symbolic_name"
    },
    "destination": {
      "$ref": "#/$defs/symbolic_name"
    },
    "method": {
      "$ref": "#/$defs/symbolic_name"
    },
    "ordinal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "outcome": {
      "enum": [
        "succeeded",
        "refused",
        "failed",
        "revoked"
      ]
    },
    "failure_reason": {
      "enum": [
        "authority_revoked",
        "request_too_large",
        "quota_exceeded",
        "connector_failed",
        "credential_exposure",
        "response_too_large",
        "usage_overrun"
      ]
    },
    "request_digest": {
      "$ref": "#/$defs/digest"
    },
    "response_digest": {
      "$ref": "#/$defs/digest"
    },
    "request_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "response_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reserved_usage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "charged_usage": {
      "$ref": "#/$defs/decimalU64"
    }
  },
  "$defs": {
    "decimalU64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$",
      "maxLength": 20,
      "not": {
        "pattern": "[^0-9]"
      }
    },
    "id": {
      "description": "Monotonic sortable identifier (ULID-style), lowercase.",
      "type": "string",
      "pattern": "^[0-9a-z]{26}$"
    },
    "symbolic_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
