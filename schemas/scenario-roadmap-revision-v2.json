{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:scenario-roadmap-revision:2",
  "title": "scenario-roadmap-revision v2",
  "description": "Goal roadmap planning and complete-loop admission. Semantic validation also checks identity, dependency, immutable history and accounting rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "revision",
    "parent",
    "proposal"
  ],
  "properties": {
    "schema": {
      "const": "af/scenario-roadmap-revision@2"
    },
    "revision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "parent": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposal": {
      "$ref": "urn:af:schema:scenario-roadmap-proposal:2#/$defs/Proposal"
    }
  }
}
