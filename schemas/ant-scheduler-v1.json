{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:ant-scheduler:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "running",
    "started_unix_ms",
    "heartbeat_unix_ms",
    "stop_requested",
    "error"
  ],
  "properties": {
    "schema": {
      "const": "af/ant-scheduler@1"
    },
    "running": {
      "type": "boolean"
    },
    "started_unix_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 8640000000000
        },
        {
          "type": "null"
        }
      ]
    },
    "heartbeat_unix_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 8640000000000
        },
        {
          "type": "null"
        }
      ]
    },
    "stop_requested": {
      "type": "boolean"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "title": "ant-scheduler v1"
}
