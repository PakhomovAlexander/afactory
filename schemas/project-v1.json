{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:project:1",
  "title": "af/project@1",
  "description": "`af project show --json` (ADR-0157): the Project of the invoking checkout, a function of its Project Store's log and this machine's workspaces.toml. Every registered Workspace, in label order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project_id",
    "repository_id",
    "store",
    "registered_unix_ms",
    "workspaces"
  ],
  "properties": {
    "schema": {
      "const": "af/project@1"
    },
    "project_id": {
      "$ref": "urn:af:schema:project-registered:1#/$defs/project_id"
    },
    "repository_id": {
      "$ref": "urn:af:schema:project-registered:1#/$defs/repository_id"
    },
    "name": {
      "$ref": "urn:af:schema:project-registered:1#/$defs/name"
    },
    "min_af": {
      "$ref": "urn:af:schema:project-registered:1#/$defs/min_af"
    },
    "store": {
      "description": "The Project Store: $XDG_STATE_HOME/af/project/<hex>.",
      "$ref": "#/$defs/path"
    },
    "registered_unix_ms": {
      "$ref": "urn:af:schema:project-registered:1#/$defs/unix_ms"
    },
    "workspaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workspace"
      }
    }
  },
  "$defs": {
    "path": {
      "description": "An absolute path on this machine, from workspaces.toml or the state root.",
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/"
    },
    "workspace": {
      "description": "One registered Workspace: the log's record joined with this machine's workspaces.toml. A path the file does not know is absent.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "label",
        "origin",
        "registered_unix_ms"
      ],
      "properties": {
        "workspace_id": {
          "$ref": "urn:af:schema:project-registered:1#/$defs/workspace_id"
        },
        "label": {
          "$ref": "urn:af:schema:project-registered:1#/$defs/label"
        },
        "origin": {
          "$ref": "urn:af:schema:project-registered:1#/$defs/origin"
        },
        "registered_unix_ms": {
          "$ref": "urn:af:schema:project-registered:1#/$defs/unix_ms"
        },
        "path": {
          "description": "The checkout.",
          "$ref": "#/$defs/path"
        },
        "state": {
          "description": "The Workspace's Task Store.",
          "$ref": "#/$defs/path"
        },
        "bindings": {
          "description": "The bindings file `--workspace` supplies as `--bindings`.",
          "$ref": "#/$defs/path"
        },
        "tasks": {
          "description": "The directory for the Workspace's Task files.",
          "$ref": "#/$defs/path"
        }
      }
    }
  }
}
