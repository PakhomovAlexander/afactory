{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-auth-recovery:1",
  "title": "af/task-auth-recovery@1",
  "description": "The `af task recover --json` document (ADR-0141): one Task's Provider auth recovery state, the auth contexts its latest suspension requires with their recovery generations, exact accounting including verification probes, and the outcomes still owed to each participation's own coordinator. It never carries a URL, code, token, native text or account identity. Exit code 3 means the private host or a human must act.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "state",
    "contexts",
    "accounting",
    "notifications",
    "undeliverable",
    "exit_code"
  ],
  "properties": {
    "schema": {
      "const": "af/task-auth-recovery@1"
    },
    "task_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "state": {
      "enum": [
        "not_suspended",
        "suspended",
        "login_required",
        "verification_failed",
        "blocked",
        "resumed",
        "terminal"
      ]
    },
    "reason": {
      "enum": [
        "deadline_expired",
        "authority_changed",
        "binding_changed",
        "allowance_missing",
        "allowance_exhausted",
        "budget_breached"
      ]
    },
    "contexts": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "context_key",
          "provider",
          "provider_kind",
          "generation",
          "status",
          "login_recorded"
        ],
        "properties": {
          "context_key": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "provider": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "provider_kind": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "status": {
            "enum": [
              "healthy",
              "failed",
              "verified"
            ]
          },
          "login_recorded": {
            "type": "boolean"
          }
        }
      }
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chargeable_tokens",
        "verification_tokens",
        "begun_attempts",
        "limit_tokens",
        "deadline_unix_ms"
      ],
      "properties": {
        "chargeable_tokens": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,38})$"
        },
        "verification_tokens": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,38})$"
        },
        "begun_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deadline_unix_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "notifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "context_key",
          "outcome_sequence",
          "generation",
          "outcome",
          "requester_ref",
          "coordinator_ref"
        ],
        "properties": {
          "context_key": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "outcome_sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "outcome": {
            "enum": [
              "resumed",
              "login_required",
              "verification_failed",
              "blocked"
            ]
          },
          "reason": {
            "enum": [
              "deadline_expired",
              "authority_changed",
              "binding_changed",
              "allowance_missing",
              "allowance_exhausted",
              "budget_breached"
            ]
          },
          "requester_ref": {
            "$ref": "urn:af:schema:task-auth-suspension:1#/$defs/opaqueRef"
          },
          "coordinator_ref": {
            "$ref": "urn:af:schema:task-auth-suspension:1#/$defs/opaqueRef"
          }
        }
      }
    },
    "undeliverable": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "login": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "provider_kind"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "provider_kind": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_id",
        "execution",
        "acceptance"
      ],
      "properties": {
        "result_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "execution": {
          "enum": [
            "completed",
            "incomplete",
            "exhausted"
          ]
        },
        "acceptance": {
          "enum": [
            "satisfied",
            "unsatisfied",
            "inconclusive"
          ]
        }
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "successor_task_id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        }
      }
    },
    "exit_code": {
      "enum": [
        0,
        3
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ]
      },
      "else": {
        "not": {
          "required": [
            "reason"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "terminal"
          }
        }
      },
      "then": {
        "required": [
          "result",
          "continuation"
        ]
      },
      "else": {
        "not": {
          "required": [
            "continuation"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "suspended",
              "login_required",
              "verification_failed",
              "blocked"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 3
          }
        }
      },
      "else": {
        "properties": {
          "exit_code": {
            "const": 0
          }
        }
      }
    }
  ]
}
