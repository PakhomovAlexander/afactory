{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:scenario-store:5",
  "title": "scenario-store v5",
  "description": "ADR-0274. Cross-port types, identity, authority, budget, signature and lifecycle invariants also require semantic admission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "writer_version",
    "runs",
    "ants",
    "roadmaps"
  ],
  "properties": {
    "schema": {
      "const": "af/scenario-store@5"
    },
    "writer_version": {
      "$ref": "urn:af:schema:scenario:4#/$defs/text"
    },
    "runs": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:af:schema:scenario:4#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "urn:af:schema:scenario:4#/$defs/Run"
      }
    },
    "ants": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:af:schema:scenario:4#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "urn:af:schema:scenario:4#/$defs/AntState"
      }
    },
    "roadmaps": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:af:schema:scenario:4#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "urn:af:schema:scenario-roadmap-proposal:2#/$defs/Roadmap"
      }
    }
  }
}
