{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:nightly-completion-v1",
  "title": "nightly-completion-v1",
  "description": "Native nightly asynchronous service; admission binds exact provenance.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "af/nightly-completion@1"
    },
    "nightly_tag": {
      "type": "string",
      "minLength": 18,
      "maxLength": 18,
      "pattern": "^nightly-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}$"
    },
    "configuration_digest": {
      "$ref": "#/$defs/digest"
    },
    "operation": {
      "type": "string",
      "enum": [
        "nightly_build_v1",
        "nightly_compare_v1",
        "nightly_report_v1",
        "publish_nightly_v1"
      ]
    },
    "artifacts": {
      "type": "object",
      "minProperties": 0,
      "maxProperties": 8,
      "patternProperties": {
        "^[a-z_]+$": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "detail": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  },
  "required": [
    "schema",
    "nightly_tag",
    "configuration_digest",
    "operation",
    "artifacts",
    "detail"
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
