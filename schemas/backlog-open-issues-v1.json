{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:backlog-open-issues:1",
  "title": "Private GitHub open issue observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "observation", "repository", "repository_id", "destination", "issues"],
  "properties": {
    "schema": {"type": "string", "const": "af.backlog-open-issues/1"},
    "observation": {"type": "string", "const": "live-page-walk"},
    "repository": {"$ref": "#/$defs/repository"},
    "repository_id": {"$ref": "#/$defs/identity"},
    "destination": {
      "type": "string",
      "pattern": "^github:[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9_.-]{1,100}$"
    },
    "issues": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "number", "updated_at", "title", "body_excerpt", "body_truncated"],
        "properties": {
          "id": {"$ref": "#/$defs/identity"},
          "number": {"$ref": "#/$defs/identity"},
          "updated_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 512},
          "body_excerpt": {"type": "string", "maxLength": 512},
          "body_truncated": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {
    "identity": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9_.-]{1,100}$"}
  }
}
