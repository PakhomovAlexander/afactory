{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:af:schema:experiment-trial-result:1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","invocation_id","case_id","family_id","arm","repetition","compatibility_id","verified","protected_checks_passed","intervals"],
  "properties":{
    "schema":{"const":"af.experiment-trial-result/1"},
    "invocation_id":{"$ref":"#/$defs/id"},
    "case_id":{"$ref":"#/$defs/id"},
    "family_id":{"$ref":"#/$defs/id"},
    "arm":{"enum":["baseline","candidate"]},
    "repetition":{"type":"integer","minimum":1},
    "compatibility_id":{"$ref":"#/$defs/id"},
    "verified":{"type":"boolean"},
    "protected_checks_passed":{"type":"boolean"},
    "intervals":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/interval"}}
  },
  "$defs":{
    "id":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "safe":{"type":"integer","minimum":0,"maximum":9007199254740991},
    "interval":{"type":"object","additionalProperties":false,"required":["kind","start_ms","end_ms"],"properties":{"kind":{"enum":["execution","preparation","cache_population","cache_lookup","cache_copy"]},"start_ms":{"$ref":"#/$defs/safe"},"end_ms":{"$ref":"#/$defs/safe"}}}
  }
}
