        "time_unix_ns",
        "what",
        "reason"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "t": {
          "const": "problem"
        },
        "schema": {
          "const": "af/TelemetryProblem@1"
        },
