          "type": "string",
          "maxLength": 1024
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq",
        "t",
        "schema",
        "ended_unix_ns",
        "exit",
        "spans",
        "events",
        "blobs",
        "dropped",
        "dropped_chunks",
        "discarded_bytes",
        "refs"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "t": {
          "const": "seal"
        },
        "schema": {
          "const": "af/TelemetrySeal@1"
        },
        "ended_unix_ns": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "exit": {
          "enum": [
            "ok",
            "error",
            "signal",
            "recovered"
          ]
        },
        "spans": {
          "type": "integer",
          "minimum": 0
        },
        "events": {
          "type": "integer",
          "minimum": 0
        },
        "blobs": {
          "type": "integer",
          "minimum": 0
        },
        "dropped": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Null means unknown: only in a seal with `exit = recovered` that a recovering reader wrote for a prefix without the writer's seal (the writer's in-memory counters died with it); such a capture is incomplete. A writer's seal, and a recovered seal that superseded a stranded writer's seal, carry the count."
        },
        "dropped_chunks": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Null means unknown: only in a seal with `exit = recovered` that a recovering reader wrote for a prefix without the writer's seal (the writer's in-memory counters died with it); such a capture is incomplete. A writer's seal, and a recovered seal that superseded a stranded writer's seal, carry the count."
        },
        "discarded_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "refs": {
          "type": "string",
          "pattern": "^[0-9]+-[0-9]+-[0-9a-f]+\\.refs$"
        }
      },
      "if": {
        "not": {
          "properties": {
            "exit": {
              "const": "recovered"
            }
          }
        }
      },
      "then": {
        "properties": {
          "dropped": {
            "type": "integer"
          },
          "dropped_chunks": {
            "type": "integer"
          }
        }
      }
    }
