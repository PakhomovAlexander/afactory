  "$defs": {
    "segment_id": {
      "type": "string",
      "pattern": "^[0-9]+-[0-9]+-[0-9a-f]+$"
    },
    "occurrence_id": {
      "type": "string",
      "pattern": "^[0-9]+-[0-9]+-[0-9a-f]+:[1-9][0-9]*$"
    }
  }
}
