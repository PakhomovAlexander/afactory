{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:provider-registry:2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "providers": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "auth_dir"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "claude",
                  "codex"
                ]
              },
              "auth_dir": {
                "type": "string",
                "pattern": "^/"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "auth_dir",
              "backend",
              "sdk_entrypoint"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "pi"
              },
              "auth_dir": {
                "type": "string",
                "pattern": "^/"
              },
              "backend": {
                "const": "openai-codex"
              },
              "sdk_entrypoint": {
                "type": "string",
                "pattern": "^/"
              }
            }
          }
        ]
      }
    }
  }
}
