{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-kind:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "version",
    "kind",
    "profile"
  ],
  "properties": {
    "schema": {
      "const": "af.task-kind/1"
    },
    "name": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/package"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "kind": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/package"
    },
    "profile": {
      "enum": [
        "implementation",
        "reviewed_implementation",
        "repair_allowed_implementation",
        "review",
        "document"
      ]
    }
  }
}
