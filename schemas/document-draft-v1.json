{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:document-draft:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "title",
    "sections",
    "citations"
  ],
  "properties": {
    "schema": {
      "const": "af.document-draft/1"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S",
      "allOf": [
        {
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f]"
          }
        }
      ]
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "heading",
          "body"
        ],
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S",
            "allOf": [
              {
                "not": {
                  "pattern": "[\\x00-\\x1f\\x7f]"
                }
              }
            ]
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536,
            "pattern": "\\S"
          }
        }
      }
    },
    "citations": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
      }
    }
  }
}
