{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checks",
    "requirements",
    "source",
    "testing"
  ],
  "properties": {
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "artifact_type",
          "payload",
          "snapshot_id"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "artifact_type": {
            "const": "af/TaskCheckReceipt@2"
          },
          "payload": {
            "type": "object"
          },
          "snapshot_id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "diff_subject": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "artifact_type",
          "payload",
          "snapshot_id"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "artifact_type": {
            "const": "af/DiffSubject@1"
          },
          "payload": {
            "type": "object"
          },
          "snapshot_id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "artifact_type",
          "payload"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "artifact_type": {
            "const": "af/Requirements@1"
          },
          "payload": {
            "type": "object"
          }
        }
      }
    },
    "source": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "artifact_type",
          "payload",
          "snapshot_id"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "artifact_type": {
            "const": "af/SourceTree@1"
          },
          "payload": {
            "type": "object"
          },
          "snapshot_id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "testing": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "artifact_type",
          "payload",
          "snapshot_id"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "artifact_type": {
            "const": "af/ImplementationTestEvidence@1"
          },
          "payload": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema",
              "snapshot_id",
              "status",
              "reason",
              "commands"
            ],
            "properties": {
              "schema": {
                "const": "af/implementation-test-evidence@1"
              },
              "snapshot_id": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "status": {
                "enum": [
                  "passed",
                  "failed",
                  "unavailable"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S",
                "not": {
                  "pattern": "\\u0000"
                }
              },
              "commands": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "purpose",
                    "command",
                    "exit_code",
                    "evidence"
                  ],
                  "properties": {
                    "purpose": {
                      "enum": [
                        "build",
                        "install",
                        "test"
                      ]
                    },
                    "command": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "\\S",
                      "not": {
                        "pattern": "\\u0000"
                      }
                    },
                    "exit_code": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 255
                        }
                      ]
                    },
                    "evidence": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096,
                      "pattern": "\\S",
                      "not": {
                        "pattern": "\\u0000"
                      }
                    }
                  }
                },
                "maxItems": 32
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "passed"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "commands": {
                      "minItems": 3,
                      "items": {
                        "properties": {
                          "exit_code": {
                            "const": 0
                          }
                        }
                      },
                      "allOf": [
                        {
                          "contains": {
                            "properties": {
                              "purpose": {
                                "const": "build"
                              }
                            }
                          }
                        },
                        {
                          "contains": {
                            "properties": {
                              "purpose": {
                                "const": "install"
                              }
                            }
                          }
                        },
                        {
                          "contains": {
                            "properties": {
                              "purpose": {
                                "const": "test"
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            ]
          },
          "snapshot_id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "artifact_type",
          "payload"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "artifact_type": {
            "const": "af/TaskAcceptance@1"
          },
          "payload": {
            "type": "object"
          }
        }
      }
    }
  },
  "$id": "urn:af:schema:implementation-evaluation-input:1",
  "title": "af/ImplementationEvaluationInput@1",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
