      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_tokens",
        "wall_ns"
      ],
      "properties": {
        "native_tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relative_difference",
            "families",
            "zero_baseline_pairs",
            "screen"
          ],
          "properties": {
            "relative_difference": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "numerator",
                    "denominator"
                  ],
                  "properties": {
                    "numerator": {
                      "type": "integer"
                    },
                    "denominator": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "families": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "numerator",
                  "denominator"
                ],
                "properties": {
                  "numerator": {
                    "type": "integer"
                  },
                  "denominator": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            "zero_baseline_pairs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "screen": {
              "enum": [
                "incomplete",
                "within_bounds",
                "outside_bounds"
              ]
            }
          }
        },
        "wall_ns": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relative_difference",
            "families",
            "zero_baseline_pairs",
            "screen"
          ],
          "properties": {
            "relative_difference": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "numerator",
                    "denominator"
                  ],
                  "properties": {
                    "numerator": {
                      "type": "integer"
                    },
                    "denominator": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "families": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "numerator",
                  "denominator"
                ],
                "properties": {
                  "numerator": {
                    "type": "integer"
                  },
                  "denominator": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            },
            "zero_baseline_pairs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "screen": {
              "enum": [
                "incomplete",
                "within_bounds",
                "outside_bounds"
              ]
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
