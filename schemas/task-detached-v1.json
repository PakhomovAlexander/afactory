{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-detached:1",
  "title": "Task detached af/task-detached@1",
  "$comment": "What `af task run ID --detach --json` prints (ADR-0202): the run it started in the background, its process and host, the log it writes, `runs/<task>-<run>.log` in the Task Store, and the Task's state when the command returned.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "run",
    "pid",
    "host",
    "log",
    "state"
  ],
  "properties": {
    "schema": {
      "const": "af/task-detached@1"
    },
    "task_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/name"
    },
    "run": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "pid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "log": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "\\S"
    },
    "state": {
      "$ref": "urn:af:schema:task-state:1#/$defs/state"
    }
  }
}
