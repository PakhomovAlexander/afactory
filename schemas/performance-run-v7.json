              "$ref": "#/$defs/git_sha"
            }
          },
          "required": [
            "kind",
            "pushed_sha"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "manual"
            },
            "remeasure_of": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/id"
                }
              ]
            }
          },
          "required": [
            "kind",
            "remeasure_of"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "nightly"
            },
            "main_sha": {
              "$ref": "#/$defs/git_sha"
            },
            "baseline_tag": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "kind",
            "main_sha",
            "baseline_tag"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "pr"
            },
            "number": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483648
                }
              ]
            },
            "head_sha": {
              "$ref": "#/$defs/git_sha"
            },
            "base_sha": {
              "$ref": "#/$defs/git_sha"
            },
            "merge_sha": {
              "$ref": "#/$defs/git_sha"
            },
            "merge_base_sha": {
              "$ref": "#/$defs/git_sha"
            }
          },
          "required": [
            "kind",
            "number",
            "head_sha",
            "base_sha",
            "merge_sha",
            "merge_base_sha"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "release"
            },
            "tag": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "tag_sha": {
              "$ref": "#/$defs/git_sha"
            },
            "baseline_tag": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "prerelease": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "tag",
            "tag_sha",
            "baseline_tag",
            "prerelease"
          ]
        }
      ]
    },
    "selectors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base": {
          "anyOf": [
            {
              "type": "null"
