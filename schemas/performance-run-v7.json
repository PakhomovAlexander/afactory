          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "start_pairs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "end_pairs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "max_median_shift": {
          "$ref": "#/$defs/decimal"
        },
        "max_mad_ratio": {
          "$ref": "#/$defs/decimal"
