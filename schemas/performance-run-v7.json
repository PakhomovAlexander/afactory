    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sample_log_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "shard_bundle_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        },
        "build_artifact_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967296
        },
        "worktree_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 85899345920
        },
        "free_disk_floor_bytes": {
          "type": "integer",
          "minimum": 10737418240,
          "maximum": 4611686018427387904
        },
        "build_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 45
        },
        "shard_sampling_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "run_total_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        },
        "concurrent_jobs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "record_bytes": {
