  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "af.perf-run/7"
    },
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "parent_run_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/id"
        }
      ]
    },
    "scope": {
      "type": "string",
      "enum": [
        "full",
        "partial_scope",
        "bootstrap",
        "calibration",
        "diagnostic"
      ]
    },
    "tier": {
      "type": "string",
      "enum": [
        "quick",
        "nightly",
        "release"
      ]
    },
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
