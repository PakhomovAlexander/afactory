        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "golden_canonical_digest",
                "golden_cas_digest",
                "golden_source_manifest",
                "golden_semantic_projection",
                "golden_authority_outcome",
                "cli_version_and_usage_tokens",
                "cli_task_outcome",
                "cli_state_fields",
                "persistence_round_trip"
              ]
            },
            "state": {
              "type": "string",
              "enum": [
                "pending_native_oracle",
                "pending_cli_fixture",
                "available"
              ]
            },
            "description": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "required": [
            "kind",
            "state",
            "description"
          ]
        }
      },
      "required": [
        "rule",
        "workload",
        "metric",
        "unit",
        "batch_repetitions",
        "start_pairs",
        "end_pairs",
        "max_median_shift",
        "max_mad_ratio",
        "denominator_floor",
        "state",
        "oracle"
      ]
