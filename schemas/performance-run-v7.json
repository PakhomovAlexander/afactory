                "calibrated_groups": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "group_id": {
                        "$ref": "#/$defs/id"
                      },
                      "cpu_model": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "image": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      }
                    },
                    "required": [
                      "group_id",
                      "cpu_model",
                      "image"
                    ]
                  },
                  "minItems": 1,
                  "maxItems": 16
                }
              },
              "required": [
                "sha256",
                "admission",
                "readiness_sha256",
                "cohort_id",
                "calibrated_groups"
              ]
            }
          ]
        },
        "suite_sha256": {
          "$ref": "#/$defs/digest"
        },
        "policy_digest": {
          "$ref": "#/$defs/digest"
        },
        "instrument_digest": {
          "$ref": "#/$defs/digest"
        },
        "fixture_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "mode",
        "activation",
        "suite_sha256",
        "policy_digest",
        "instrument_digest",
        "fixture_digest"
      ]
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "changed": {
          "type": "boolean"
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relative_path"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "changed",
        "paths",
        "truncated"
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environment_id": {
          "$ref": "#/$defs/id"
        },
        "environment_digest": {
          "$ref": "#/$defs/digest"
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string",
              "maxLength": 4096
            },
            "os": {
              "type": "string",
              "enum": [
                "linux",
                "macos"
              ]
            },
            "arch": {
              "type": "string",
              "enum": [
                "x86_64",
                "aarch64"
              ]
            },
            "libc": {
              "type": "string",
              "enum": [
                "gnu",
                "musl",
                "darwin"
              ]
            },
            "runner": {
              "type": "string",
              "enum": [
                "github_hosted",
                "trusted_local",
                "dedicated"
              ]
            },
            "runner_label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "containment": {
              "type": "string",
              "enum": [
                "linux_container",
                "trusted_local_process_group"
              ]
            },
            "logical_cpus": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "prefer_separate_physical_cores": {
              "type": "boolean"
            },
            "memory_limit_bytes": {
              "type": "integer",
              "minimum": 67108864,
              "maximum": 1099511627776
            },
            "pid_limit": {
              "type": "integer",
              "minimum": 16,
              "maximum": 65536
            },
            "swap": {
              "type": "string",
              "enum": [
                "disabled",
                "host_default"
              ]
            },
            "network": {
              "type": "string",
              "enum": [
                "disabled",
                "host_default"
              ]
            },
            "cpu_quota": {
              "type": "string",
              "enum": [
                "none",
                "declared"
              ]
            },
            "scratch_limit_bytes": {
              "type": "integer",
              "minimum": 67108864,
              "maximum": 68719476736
            },
            "state": {
              "type": "string",
              "enum": [
                "supported",
                "not_yet_executable"
              ]
            },
            "pending": {
              "type": "string",
              "maxLength": 512
            }
          },
          "required": [
            "description",
            "os",
            "arch",
            "libc",
            "runner",
            "runner_label",
            "containment",
            "swap",
            "network",
            "cpu_quota",
            "scratch_limit_bytes",
            "state",
            "pending"
          ]
        },
        "recipe_id": {
          "$ref": "#/$defs/id"
        },
        "recipe_digest": {
          "$ref": "#/$defs/digest"
        },
        "recipe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string",
              "maxLength": 4096
            },
            "os": {
              "type": "string",
              "enum": [
                "linux",
                "macos"
              ]
            },
            "target": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z0-9_]+(?:-[a-z0-9_]+){2,3}$"
            },
            "toolchain": {
              "type": "string",
              "maxLength": 32,
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "profile": {
              "const": "release"
            },
            "builder": {
              "type": "string",
              "enum": [
                "cargo",
                "cargo_zigbuild"
              ]
            },
            "cargo_zigbuild": {
              "type": "string",
              "maxLength": 32,
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "zig": {
              "type": "string",
              "maxLength": 32,
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "linker": {
              "type": "string",
              "enum": [
                "system_cc",
                "zig_cc",
                "apple_ld"
              ]
            },
            "features": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 4096,
                "pattern": "^[a-z0-9_-]{1,64}$"
              },
              "minItems": 0,
              "maxItems": 32,
              "uniqueItems": true
            },
            "rustflags": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 4096,
                "pattern": "^[A-Za-z0-9=_,.:+-]{1,128}$"
              },
              "minItems": 0,
              "maxItems": 32
            },
            "instrumented": {
              "type": "boolean"
            },
            "debug_symbols": {
              "type": "boolean"
            },
            "frame_pointers": {
              "type": "boolean"
            },
            "container_image": {
              "type": "string",
              "maxLength": 330,
              "pattern": "^(?:(?:[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?::[0-9]{1,5})?/)*[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*@)?sha256:[0-9a-f]{64}$"
            },
            "state": {
              "type": "string",
              "enum": [
                "supported",
                "not_yet_executable"
              ]
            },
            "pending": {
              "type": "string",
              "maxLength": 512
            }
          },
          "required": [
            "description",
            "os",
            "target",
            "toolchain",
            "profile",
            "builder",
            "linker",
            "features",
            "rustflags",
            "instrumented",
            "debug_symbols",
            "frame_pointers",
            "state",
            "pending"
          ]
        },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "isolation": {
              "type": "string",
              "enum": [
                "container",
                "trusted_host",
                "native_host"
              ]
            },
            "image": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "maxLength": 330,
                  "pattern": "^(?:(?:[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?::[0-9]{1,5})?/)*[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*@)?sha256:[0-9a-f]{64}$"
                }
              ]
