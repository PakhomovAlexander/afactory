      "required": [
        "sample_log_bytes",
        "shard_bundle_bytes",
        "build_artifact_bytes",
        "worktree_bytes",
        "free_disk_floor_bytes",
        "build_minutes",
        "shard_sampling_minutes",
        "run_total_minutes",
        "concurrent_jobs",
        "record_bytes"
      ]
