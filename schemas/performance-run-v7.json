                    "configured"
                  ]
                }
              ]
            }
          },
          "required": [
            "isolation",
            "image",
            "image_source"
          ]
        },
        "default": {
          "type": "boolean"
        }
      },
      "required": [
        "environment_id",
        "environment_digest",
        "environment",
        "recipe_id",
        "recipe_digest",
        "recipe",
        "build",
        "default"
      ]
    },
    "verdict_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
