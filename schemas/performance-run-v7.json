        "authority": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          ]
        }
      },
      "required": [
        "base",
        "head",
        "control",
        "authority"
      ]
    },
    "resolved": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseline_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "candidate_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "control_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "authority_sha": {
          "$ref": "#/$defs/git_sha"
        }
      },
      "required": [
        "baseline_sha",
        "candidate_sha",
        "control_sha",
        "authority_sha"
      ]
    },
    "build_inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cargo_lock_sha256": {
              "$ref": "#/$defs/digest"
            }
          },
          "required": [
            "cargo_lock_sha256"
          ]
        },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cargo_lock_sha256": {
              "$ref": "#/$defs/digest"
            }
          },
          "required": [
            "cargo_lock_sha256"
          ]
        },
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cargo_lock_sha256": {
              "$ref": "#/$defs/digest"
            }
          },
          "required": [
            "cargo_lock_sha256"
          ]
        }
      },
      "required": [
        "authority",
        "baseline",
        "candidate"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "active",
            "proposed",
            "control"
          ]
        },
        "activation": {
          "anyOf": [
            {
              "type": "null"
