{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:backlog-schedule:1",
  "title": "Receiver-local backlog schedule enrollment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "scope", "paused"],
  "properties": {
    "schema": {"const": "af/backlog-schedule@1"},
    "revision": {"$ref": "#/$defs/digest"},
    "paused": {"type": "boolean"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner", "project_id", "scenario_state", "repo", "commit", "file", "task_state",
        "template_scope", "bindings", "providers", "scenario_id", "intake_authority",
        "batch_policy", "intake_policy", "destination", "limits"
      ],
      "properties": {
        "owner": {"$ref": "urn:af:schema:scenario:11#/$defs/name"},
        "project_id": {"$ref": "#/$defs/digest"},
        "scenario_state": {"$ref": "#/$defs/absolutePath"},
        "repo": {"$ref": "#/$defs/absolutePath"},
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "file": {"type": "string", "pattern": "^[^/].*\\.json$"},
        "task_state": {"$ref": "#/$defs/absolutePath"},
        "template_scope": {"$ref": "#/$defs/digest"},
        "bindings": {"oneOf": [{"$ref": "#/$defs/filePin"}, {"type": "null"}]},
        "providers": {"$ref": "#/$defs/filePin"},
        "scenario_id": {"$ref": "#/$defs/digest"},
        "intake_authority": {"$ref": "#/$defs/digest"},
        "batch_policy": {"$ref": "#/$defs/digest"},
        "intake_policy": {"$ref": "#/$defs/digest"},
        "destination": {"type": "string", "minLength": 1},
        "limits": {"$ref": "urn:af:schema:scenario:11#/$defs/Limits"}
      }
    }
  },
  "$defs": {
    "digest": {"$ref": "urn:af:schema:backlog-record:2#/$defs/digest"},
    "absolutePath": {"type": "string", "pattern": "^/"},
    "filePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
