{
  "$id": "urn:af:schema:test-class-receipt:2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "class": {
      "enum": [
        "functional",
        "e2e",
        "uix",
        "perf"
      ]
    },
    "plan": {
      "additionalProperties": false,
      "properties": {
        "catalog_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "classes": {
          "additionalProperties": false,
          "properties": {
            "e2e": {
              "additionalProperties": false,
              "properties": {
                "reason": {
                  "type": "string"
                },
                "selected": {
                  "type": "boolean"
                },
                "state": {
                  "enum": [
                    "SELECTED",
                    "NOT RUN"
                  ]
                }
              },
              "required": [
                "selected",
                "reason",
                "state"
              ],
              "type": "object"
            },
            "functional": {
              "additionalProperties": false,
              "properties": {
                "reason": {
                  "type": "string"
                },
                "selected": {
                  "type": "boolean"
                },
                "state": {
                  "enum": [
                    "SELECTED",
                    "NOT RUN"
                  ]
                }
              },
              "required": [
                "selected",
                "reason",
                "state"
              ],
              "type": "object"
            },
            "perf": {
              "additionalProperties": false,
              "properties": {
                "reason": {
                  "type": "string"
                },
                "selected": {
                  "type": "boolean"
                },
                "state": {
                  "enum": [
                    "SELECTED",
                    "NOT RUN"
                  ]
                }
              },
              "required": [
                "selected",
                "reason",
                "state"
              ],
              "type": "object"
            },
            "uix": {
              "additionalProperties": false,
              "properties": {
                "reason": {
                  "type": "string"
                },
                "selected": {
                  "type": "boolean"
                },
                "state": {
                  "enum": [
                    "SELECTED",
                    "NOT RUN"
                  ]
                }
              },
              "required": [
                "selected",
                "reason",
                "state"
              ],
              "type": "object"
            }
          },
          "required": [
            "functional",
            "e2e",
            "uix",
            "perf"
          ],
          "type": "object"
        },
        "context": {
          "enum": [
            "pr",
            "gate",
            "release_pr",
            "local",
            "release"
          ]
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "profile": {
          "enum": [
            "full",
            "fast",
            "custom"
          ]
        },
        "schema": {
          "const": "af.test-plan/2"
        },
        "selected": {
          "items": {
            "enum": [
              "functional",
              "e2e",
              "uix",
              "perf"
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "schema",
        "profile",
        "context",
        "sha",
        "version",
        "labels",
        "selected",
        "catalog_sha256",
        "classes"
      ],
      "type": "object"
    },
    "platform": {
      "type": "string"
    },
    "schema": {
      "const": "af.test-class-receipt/2"
    },
    "status": {
      "const": "success"
    }
  },
  "required": [
    "schema",
    "plan",
    "platform",
    "class",
    "status"
  ],
  "type": "object"
}
