{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "revision_id",
    "phase",
    "plan_id",
    "chargeable_tokens",
    "attempts",
    "history",
    "execution_records",
    "run_reports",
    "owned_child_sets"
  ],
  "dependentRequired": {
    "graph": [
      "plan"
    ],
    "plan": [
      "graph"
    ],
    "delivery": [
      "result"
    ],
    "planning_diagnostic": [
      "result"
    ],
    "repair_assessments": [
      "result"
    ],
    "review_rounds": [
      "result"
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "properties": {
              "kind": {
                "const": "finished"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "result"
        ]
      },
      "else": {
        "not": {
          "required": [
            "result"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "graph"
        ]
      },
      "then": {
        "properties": {
          "plan_id": {
            "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
          }
        }
      }
    }
  ],
  "$id": "urn:af:schema:task-inspection:5",
  "title": "Task inspection af/task-inspection@5",
  "$comment": "Owned-child Task inspection. Registration, child publication and parent completion remain in the common Task history. Historical V1/V2/V3/V4 execution records retain their exact types and payloads; optional Broker records retain their frozen V4 contract. These read-only facts grant no dispatch authority.",
  "properties": {
    "schema": {
      "const": "af/task-inspection@5"
    },
    "task_id": {
      "$ref": "urn:af:schema:task-inspection:3#/properties/task_id"
    },
    "revision_id": {
      "$ref": "urn:af:schema:task-inspection:3#/properties/revision_id"
    },
    "phase": {
      "$ref": "urn:af:schema:task-inspection:3#/properties/phase"
    },
    "plan_id": {
      "$ref": "urn:af:schema:task-inspection:3#/properties/plan_id"
    },
    "chargeable_tokens": {
      "$ref": "urn:af:schema:task-inspection:3#/properties/chargeable_tokens"
    },
    "attempts": {
      "$ref": "urn:af:schema:task-inspection:3#/properties/attempts"
    },
    "selection": {
      "$ref": "urn:af:schema:task-inspection:3#/properties/selection"
    },
    "planning": {
      "$ref": "urn:af:schema:task-inspection:3#/properties/planning"
    },
    "plan_decisions": {
      "$ref": "urn:af:schema:task-inspection:3#/properties/plan_decisions"
    },
    "history": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "urn:af:schema:task-inspection:3#/properties/history/items"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sequence",
              "broker_transition"
            ],
            "properties": {
              "sequence": {
                "$ref": "urn:af:schema:task-inspection:3#/properties/history/items/properties/sequence"
              },
              "broker_transition": {
                "$ref": "urn:af:schema:task-broker-transition:1"
              }
            }
          }
        ]
      }
    },
    "execution_records": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "urn:af:schema:task-inspection:3#/properties/execution_records/items"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "artifact_type",
              "record"
            ],
            "properties": {
              "artifact_id": {
                "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
              },
              "artifact_type": {
                "const": "af/TaskExecutionRecord@4"
              },
              "record": {
                "$ref": "urn:af:schema:task-execution-record:4"
              }
            }
          }
        ]
      }
    },
    "run_reports": {
      "$ref": "urn:af:schema:task-inspection:3#/properties/run_reports"
    },
    "delivery": {
      "$ref": "urn:af:schema:task-inspection:3#/properties/delivery"
    },
    "result": {
      "$ref": "urn:af:schema:task-inspection:3#/properties/result"
    },
    "planning_diagnostic": {
      "$ref": "urn:af:schema:task-inspection:3#/properties/planning_diagnostic"
    },
    "repair_assessments": {
      "$ref": "urn:af:schema:task-inspection:3#/properties/repair_assessments"
    },
    "review_rounds": {
      "$ref": "urn:af:schema:task-inspection:3#/properties/review_rounds"
    },
    "graph": {
      "$ref": "urn:af:schema:task-inspection:3#/properties/graph"
    },
    "plan": {
      "$ref": "urn:af:schema:task-inspection:3#/properties/plan"
    },
    "broker_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "artifact_type",
              "record"
            ],
            "properties": {
              "artifact_id": {
                "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
              },
              "artifact_type": {
                "const": "af/TaskBrokerBinding@1"
              },
              "record": {
                "$ref": "urn:af:schema:task-broker-binding:1"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "artifact_type",
              "record"
            ],
            "properties": {
              "artifact_id": {
                "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
              },
              "artifact_type": {
                "const": "af/TaskBrokerOperation@1"
              },
              "record": {
                "$ref": "urn:af:schema:task-broker-operation:1"
              }
            }
          }
        ]
      }
    },
    "owned_child_sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "artifact_type",
          "record"
        ],
        "properties": {
          "artifact_id": {
            "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
          },
          "artifact_type": {
            "const": "af/TaskOwnedChildSet@1"
          },
          "record": {
            "$ref": "urn:af:schema:task-owned-child-set:1"
          }
        }
      }
    }
  }
}
