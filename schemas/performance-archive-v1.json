{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:performance-archive:1",
  "title": "af.perf-archive/1",
  "description": "An archive root's archive.json (ADR-0172): its capacity, at most 1 TiB, and when it was created.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "af.perf-archive/1"
    },
    "capacity_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1099511627776
    },
    "created_unix_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740992
    }
  },
  "required": [
    "schema",
    "capacity_bytes",
    "created_unix_ms"
  ]
}
