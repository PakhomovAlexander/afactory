{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-execution-record:3",
  "title": "TaskExecutionRecord@3",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "attempt_id",
        "charged_tokens",
        "result",
        "raw_artifact_ids"
      ],
      "properties": {
        "kind": {
          "const": "settled"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{26}$"
        },
        "charged_tokens": {
          "$ref": "urn:af:schema:task-token-usage:3#/$defs/decimalU128"
        },
        "result": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "output_id"
              ],
              "properties": {
                "kind": {
                  "const": "succeeded"
                },
                "output_id": {
                  "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "diagnostic_id"
              ],
              "properties": {
                "kind": {
                  "const": "failed"
                },
                "diagnostic_id": {
                  "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
                },
                "feedback_id": {
                  "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "diagnostic_id"
              ],
              "properties": {
                "kind": {
                  "const": "abandoned"
                },
                "diagnostic_id": {
                  "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
                }
              }
            }
          ]
        },
        "raw_artifact_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "usage_id": {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "attempt_id",
        "charged_tokens",
        "usage_id",
        "raw_artifact_ids"
      ],
      "properties": {
        "kind": {
          "const": "usage_observed"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]{26}$"
        },
        "charged_tokens": {
          "$ref": "urn:af:schema:task-token-usage:3#/$defs/decimalU128"
        },
        "usage_id": {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
        },
        "raw_artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
          }
        }
      }
    }
  ]
}
