{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:provider-doctor:2",
  "title": "Common Task Provider doctor@2",
  "$comment": "Observations from the exact captured Provider-admission operations in one existing Review Task. gates_run and workers_dispatched describe this doctor invocation only, not earlier Task history. Common output/receipt IDs and Provider aliases, principal, model and effort remain subject to Store/compiler authority. A doctor outcome is never a complete business RunReport or TaskResult.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ready",
    "run_id",
    "authority",
    "task",
    "provider_admissions",
    "admitted_nodes",
    "gates_run",
    "workers_dispatched"
  ],
  "properties": {
    "schema": {
      "const": "af/provider-doctor@2"
    },
    "ready": {
      "type": "boolean"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_snapshot_id",
        "campaign_manifest_id",
        "subject_id",
        "head_snapshot_id",
        "round_event_id",
        "round",
        "epoch"
      ],
      "properties": {
        "authority_snapshot_id": {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
        },
        "campaign_manifest_id": {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
        },
        "subject_id": {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
        },
        "head_snapshot_id": {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
        },
        "round_event_id": {
          "type": "string",
          "pattern": "^[a-z0-9]{26}$"
        },
        "round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "revision_id",
        "plan_id",
        "phase",
        "limits",
        "committed_tokens",
        "begun_attempts",
        "budget_breached",
        "deadline_expired",
        "resources_exhausted"
      ],
      "properties": {
        "task_id": {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/name"
        },
        "revision_id": {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
        },
        "plan_id": {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
        },
        "phase": {
          "$ref": "urn:af:schema:task-phase:1"
        },
        "limits": {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/limits"
        },
        "committed_tokens": {
          "$ref": "urn:af:schema:task-token-usage:3#/$defs/decimalU128"
        },
        "begun_attempts": {
          "$ref": "urn:af:schema:task-token-usage:3#/$defs/decimalU64"
        },
        "budget_breached": {
          "type": "boolean"
        },
        "deadline_expired": {
          "type": "boolean"
        },
        "resources_exhausted": {
          "type": "boolean"
        }
      }
    },
    "provider_admissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node",
          "bindings",
          "execution",
          "outcome"
        ],
        "properties": {
          "node": {
            "$ref": "urn:af:schema:task-invocation:1#/properties/node"
          },
          "bindings": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "urn:af:schema:task-invocation:1#/properties/node"
            }
          },
          "execution": {
            "allOf": [
              {
                "$ref": "urn:af:schema:task-contracts:1#/$defs/workerExecution"
              },
              {
                "properties": {
                  "kind": {
                    "const": "model"
                  }
                }
              }
            ]
          },
          "outcome": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "output_id",
                  "admission_ids"
                ],
                "properties": {
                  "kind": {
                    "const": "completed"
                  },
                  "output_id": {
                    "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
                  },
                  "admission_ids": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "error"
                ],
                "properties": {
                  "kind": {
                    "const": "failed"
                  },
                  "error": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "admitted_nodes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gates_run": {
      "const": false
    },
    "workers_dispatched": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ready": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "task": {
            "properties": {
              "budget_breached": {
                "const": false
              },
              "deadline_expired": {
                "const": false
              },
              "resources_exhausted": {
                "const": false
              }
            }
          },
          "provider_admissions": {
            "items": {
              "properties": {
                "outcome": {
                  "properties": {
                    "kind": {
                      "const": "completed"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "properties": {
              "resources_exhausted": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "task": {
            "properties": {
              "budget_breached": {
                "const": false
              },
              "deadline_expired": {
                "const": false
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "task": {
            "anyOf": [
              {
                "properties": {
                  "budget_breached": {
                    "const": true
                  }
                }
              },
              {
                "properties": {
                  "deadline_expired": {
                    "const": true
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
