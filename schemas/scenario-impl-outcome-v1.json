{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:scenario-impl-outcome:1",
  "title": "scenario-impl-outcome v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "subject",
    "revision",
    "result_id",
    "snapshot_id",
    "ready",
    "repair",
    "reasons",
    "pr_id",
    "pr_number"
  ],
  "properties": {
    "schema": {
      "const": "af/scenario-impl-outcome@1"
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^impl:sha256:[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^[0-9a-f]{40}$"
    },
    "result_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ready": {
      "type": "boolean"
    },
    "repair": {
      "type": "boolean"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 65536
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "pr_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "pr_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
