{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:reviewed-implementation:1",
  "title": "reviewed-implementation@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "invocation",
    "snapshot_id",
    "policy_id",
    "outcome",
    "scope"
  ],
  "properties": {
    "invocation": {
      "$ref": "urn:af:schema:task-invocation:1"
    },
    "snapshot_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    },
    "policy_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    },
    "outcome": {
      "enum": [
        "passed",
        "failed",
        "inconclusive"
      ]
    },
    "scope": {
      "enum": [
        "complete_review",
        "targeted_fixes"
      ]
    }
  }
}
