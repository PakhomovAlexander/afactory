{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:scenario-list:1",
  "title": "scenario-list v1",
  "description": "ADR-0274. Cross-port types, identity, authority, budget, signature and lifecycle invariants also require semantic admission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runs"
  ],
  "properties": {
    "schema": {
      "const": "af/scenario-list@1"
    },
    "runs": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:af:schema:scenario:1#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "urn:af:schema:scenario:1#/$defs/Run"
      }
    }
  }
}
