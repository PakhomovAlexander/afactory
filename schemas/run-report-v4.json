{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:review-kernel:schema:run-report:4",
  "title": "RunReport@4 payload",
  "description": "The structural conclusion of one run, including resolved Gate Execution Bindings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["outcomes", "blocked_gates", "verdict", "execution_bindings"],
  "properties": {
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node", "outcome"],
        "properties": {
          "node": { "type": "string", "minLength": 1 },
          "outcome": { "$ref": "#/$defs/outcome" }
        }
      }
    },
    "blocked_gates": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "verdict": { "$ref": "#/$defs/verdict" },
    "spent_tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "execution_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node",
          "provider",
          "required_isolation",
          "provided_isolation",
          "mode",
          "admitted"
        ],
        "properties": {
          "node": { "type": "string", "minLength": 1 },
          "provider": { "enum": ["trusted_local", "container"] },
          "required_isolation": { "enum": ["none", "container"] },
          "provided_isolation": { "enum": ["none", "process", "container"] },
          "mode": { "const": "ephemeral-write" },
          "admitted": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "artifact_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "outcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "output_artifacts"],
          "properties": {
            "kind": { "const": "completed" },
            "output_artifacts": {
              "type": "array",
              "items": { "$ref": "#/$defs/artifact_id" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "error"],
          "properties": {
            "kind": { "const": "failed" },
            "error": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "suppressed" },
            "reason": { "enum": ["gate_blocked", "upstream_missing"] }
          }
        }
      ]
    },
    "missing_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "reason"],
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "verdict": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "pass" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason"],
          "properties": {
            "kind": { "const": "fail" },
            "reason": { "enum": ["not_converged", "authority_unavailable", "exhausted"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "missing_nodes"],
          "properties": {
            "kind": { "const": "incomplete" },
            "missing_nodes": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/missing_node" }
            }
          }
        }
      ]
    }
  }
}
