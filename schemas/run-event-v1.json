{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:review-kernel:schema:run-event:1",
  "title": "RunEvent@1 envelope",
  "description": "The source of truth. One kernel sequencer allocates a monotonic per-run sequence while many reviewers execute concurrently. Events are never edited: a correction is a new compensating event. Large values live in content-addressed artifacts referenced by digest, never inline.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "run_id",
    "sequence",
    "type",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "event_id": {
      "$ref": "#/$defs/id"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "description": "Monotonic per-run sequence allocated by the single sequencer. Dense and gapless: a gap means loss, not reordering.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "type": {
      "description": "Closed event type and semantic-version vocabulary. New event kinds and payload versions are explicit additive contract changes.",
      "type": "string",
      "enum": [
        "TaskTransition@1",
        "TaskTransition@2",
        "TaskTransition@3",
        "TaskTransition@4",
        "TaskTransition@5",
        "TaskBrokerTransition@1",
        "TaskReviewResultSelected@1",
        "BrokerOperationCompleted@1",
        "AttemptAdmitted@1",
        "AttemptDispatched@1",
        "AttemptFailed@1",
        "AttemptFenced@1",
        "AttemptFeedback@1",
        "AttemptInput@1",
        "AttemptReleased@1",
        "CheckCompleted@1",
        "CampaignOpened@1",
        "ChangeAttested@1",
        "DemandRecorded@1",
        "DemandWaived@1",
        "EvidenceAdded@1",
        "EvidenceReuseAdmitted@1",
        "EvidenceSatisfied@1",
        "FindingReported@1",
        "FindingResolutionChallenged@1",
        "FindingResolutionRecorded@1",
        "FindingResolved@1",
        "FindingsGrouped@1",
        "FindingsUngrouped@1",
        "FixVerified@1",
        "GateDecision@1",
        "GateExecutionBound@1",
        "CacheSnapshotMaterialized@1",
        "GenerationAdvanced@1",
        "IntegrationPrepared@1",
        "IntegrationConflict@1",
        "IntegrationChecksCompleted@1",
        "IntegrationCommitted@1",
        "NodeInvocation@1",
        "NodeOutputReceipt@1",
        "PolicyTimeAdvanced@1",
        "ProviderOperationTransition@1",
        "ProposalAccepted@1",
        "ProposalPrepared@1",
        "ProposalRefused@1",
        "ReviewerExecutionBound@1",
        "RunReport@1",
        "RunReport@2",
        "RunReport@3",
        "RunReport@4",
        "RunReport@5",
        "RunReport@6",
        "RoundInputSuperseded@1",
        "RoundStarted@1",
        "SourceCaptured@1",
        "SliceSetAccepted@1",
        "ShardSetRecorded@1",
        "SemanticClosureChecked@1",
        "WarmSetSelected@1",
        "WorkerNotesRecorded@1",
        "BuildCacheCaptured@1",
        "WorkspaceRebased@1"
      ]
    },
    "occurred_at": {
      "description": "Wall-clock observation, for humans and forensics. NOT an ordering authority \u2014 `sequence` is. Replay must never depend on this field.",
      "type": "string",
      "format": "date-time"
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "description": "The event this one was caused by. Absent for a run's first event.",
      "$ref": "#/$defs/id"
    },
    "correlation_id": {
      "description": "Subject this event is about across its lifetime, e.g. a Finding ID.",
      "type": "string",
      "minLength": 1
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "payload": {
      "description": "Type-specific body. Must satisfy the I-JSON numeric domain: finite binary64, integers only within the interoperable safe range, no negative zero.",
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "TaskBrokerTransition@1"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "urn:af:schema:task-broker-transition:1"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "TaskReviewResultSelected@1"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "urn:af:schema:task-review-result-selected:1"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "TaskTransition@2"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "urn:af:schema:task-transition:2"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "TaskTransition@3"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "urn:af:schema:task-transition:3"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "TaskTransition@4"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "urn:af:schema:task-transition:4"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "TaskTransition@5"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "urn:af:schema:task-transition:5"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "TaskTransition@1"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "urn:af:schema:task-transition:1"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "BrokerOperationCompleted@1"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/broker_operation_receipt"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "CacheSnapshotMaterialized@1"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/cache_snapshot"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "CampaignOpened@1"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/campaign_opened"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "RoundStarted@1"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/round_started"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "RoundInputSuperseded@1"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/round_superseded"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ProviderOperationTransition@1"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/provider_operation_transition"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "GateExecutionBound@1"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/gate_execution_bound"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ReviewerExecutionBound@1"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/reviewer_execution_binding"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ProposalPrepared@1"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/proposal_prepared"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ProposalRefused@1"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/proposal_refused"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ProposalAccepted@1"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/proposal_accepted"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "SliceSetAccepted@1"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/slice_set_accepted"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "ShardSetRecorded@1",
              "SemanticClosureChecked@1"
            ]
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/recorded_set"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "IntegrationPrepared@1"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/integration_prepared"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "IntegrationConflict@1"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/integration_conflict"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "IntegrationChecksCompleted@1"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/integration_checks_completed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "IntegrationCommitted@1"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/integration_committed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "WarmSetSelected@1"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/warm_set_selected"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "WorkerNotesRecorded@1"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/worker_notes_recorded"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "BuildCacheCaptured@1"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/build_cache_captured"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "WorkspaceRebased@1"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/workspace_rebased"
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "description": "Monotonic sortable identifier (ULID-style), lowercase.",
      "type": "string",
      "pattern": "^[0-9a-z]{26}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "symbolic_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "broker_operation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "destination",
        "method",
        "max_request_bytes",
        "max_response_bytes",
        "max_calls",
        "max_usage"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/symbolic_name"
        },
        "destination": {
          "$ref": "#/$defs/symbolic_name"
        },
        "method": {
          "$ref": "#/$defs/symbolic_name"
        },
        "max_request_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "max_usage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740990
        }
      }
    },
    "reviewer_execution_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "attempt_id",
        "lease_epoch",
        "credential_mode",
        "auto_apply",
        "admitted"
      ],
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "$ref": "#/$defs/id"
        },
        "lease_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "credential_mode": {
          "enum": [
            "credential_free",
            "brokered",
            "trusted_unsafe"
          ]
        },
        "auto_apply": {
          "type": "boolean"
        },
        "broker_handle": {
          "$ref": "#/$defs/id"
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/broker_operation_policy"
          }
        },
        "admitted": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "credential_mode": {
                "const": "brokered"
              }
            },
            "required": [
              "credential_mode"
            ]
          },
          "then": {
            "required": [
              "broker_handle",
              "operations"
            ],
            "properties": {
              "operations": {
                "minItems": 1
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "broker_handle"
              ]
            },
            "properties": {
              "operations": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "credential_mode": {
                "const": "trusted_unsafe"
              }
            },
            "required": [
              "credential_mode"
            ]
          },
          "then": {
            "properties": {
              "auto_apply": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "proposal_prepared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_artifact_id",
        "result_artifact_id"
      ],
      "properties": {
        "candidate_artifact_id": {
          "$ref": "#/$defs/digest"
        },
        "result_artifact_id": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "proposal_refused": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "result_artifact_id"
      ],
      "properties": {
        "reason": {
          "enum": [
            "malformed_declaration",
            "invalid_claim",
            "invalid_evidence",
            "invalid_path",
            "empty_mutation",
            "patch_mismatch",
            "path_mismatch"
          ]
        },
        "result_artifact_id": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "proposal_accepted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "proposal_artifact_id",
        "candidate_artifact_id"
      ],
      "properties": {
        "proposal_id": {
          "$ref": "#/$defs/digest"
        },
        "proposal_artifact_id": {
          "$ref": "#/$defs/digest"
        },
        "candidate_artifact_id": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "slice_set_accepted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slice_set_id",
        "slice_set_artifact_id"
      ],
      "properties": {
        "slice_set_id": {
          "$ref": "#/$defs/digest"
        },
        "slice_set_artifact_id": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "recorded_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "record_id"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/digest"
        },
        "record_id": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "integration_prepared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "plan_artifact_id",
        "derived_snapshot_id"
      ],
      "properties": {
        "batch_id": {
          "type": "string",
          "minLength": 1
        },
        "plan_artifact_id": {
          "$ref": "#/$defs/digest"
        },
        "derived_snapshot_id": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "integration_conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_snapshot_id",
        "proposal_ids",
        "paths",
        "reason"
      ],
      "properties": {
        "base_snapshot_id": {
          "$ref": "#/$defs/digest"
        },
        "proposal_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "integration_checks_completed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "checks_artifact_id",
        "passed"
      ],
      "properties": {
        "batch_id": {
          "type": "string",
          "minLength": 1
        },
        "checks_artifact_id": {
          "$ref": "#/$defs/digest"
        },
        "passed": {
          "type": "boolean"
        }
      }
    },
    "integration_committed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_id",
        "prior_subject_id",
        "derived_subject_id",
        "prior_snapshot_id",
        "derived_snapshot_id",
        "proposal_ids",
        "attestation_ids",
        "expected_finding_set_id",
        "expected_demand_set_id",
        "policy_id",
        "semantic_closure_id"
      ],
      "properties": {
        "batch_id": {
          "type": "string",
          "minLength": 1
        },
        "prior_subject_id": {
          "$ref": "#/$defs/digest"
        },
        "derived_subject_id": {
          "$ref": "#/$defs/digest"
        },
        "prior_snapshot_id": {
          "$ref": "#/$defs/digest"
        },
        "derived_snapshot_id": {
          "$ref": "#/$defs/digest"
        },
        "proposal_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "attestation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/digest"
          }
        },
        "expected_finding_set_id": {
          "$ref": "#/$defs/digest"
        },
        "expected_demand_set_id": {
          "$ref": "#/$defs/digest"
        },
        "policy_id": {
          "$ref": "#/$defs/digest"
        },
        "semantic_closure_id": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "warm_set_selected": {
      "description": "Appended before the node's first AttemptDispatched@1 of a Round. The Warm Set artifact names the exact carried layers; `layers` repeats them for operator reports.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "warm_set_artifact_id",
        "layers"
      ],
      "properties": {
        "warm_set_artifact_id": {
          "$ref": "#/$defs/digest"
        },
        "source_attempt_id": {
          "$ref": "#/$defs/id"
        },
        "layers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "notes",
              "head_delta",
              "build_cache",
              "workspace"
            ]
          }
        }
      }
    },
    "workspace_rebased": {
      "description": "Appended once per node per kernel run, before the node's Warm Set is recorded: which head the node's stable workspace template held, which head it holds now, on what basis (materialized in full with a recorded reason, re-based by tree diff and verified against the head's Tree Digest, or reused unchanged), the digest the result was verified to hold, how many entries the preparation touched, and how long it took. The workspace is named by an opaque identity, never a host path.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "workspace_id",
        "to_snapshot_id",
        "basis",
        "verified_digest",
        "entries_touched",
        "preparation_ms"
      ],
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1
        },
        "workspace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "from_snapshot_id": {
          "$ref": "#/$defs/digest"
        },
        "to_snapshot_id": {
          "$ref": "#/$defs/digest"
        },
        "basis": {
          "enum": [
            "full",
            "rebased",
            "reused"
          ]
        },
        "fallback": {
          "enum": [
            "no_verified_template",
            "template_corrupt",
            "apply_failed",
            "digest_mismatch",
            "unrecorded_preparation"
          ]
        },
        "verified_digest": {
          "$ref": "#/$defs/digest"
        },
        "entries_touched": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "preparation_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "basis": {
                "const": "full"
              }
            }
          },
          "then": {
            "required": [
              "fallback"
            ]
          },
          "else": {
            "required": [
              "from_snapshot_id"
            ],
            "not": {
              "required": [
                "fallback"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "basis": {
                "const": "reused"
              }
            }
          },
          "then": {
            "properties": {
              "entries_touched": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "build_cache_captured": {
      "description": "Appended by a Gate after its checks passed, once per declared build cache kind: exactly one of the captured review.kernel/BuildCache@1 artifact or a refusal reason, with the head the Gate built and the limits that applied. A refusal never changes the Gate verdict; Workers that declared the kind run without it. The artifact is explicitly unsafe and never a Cache Snapshot.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_node",
        "head_snapshot_id",
        "kind",
        "limits",
        "entries",
        "bytes"
      ],
      "properties": {
        "gate_node": {
          "type": "string",
          "minLength": 1
        },
        "gate_attempt_id": {
          "$ref": "#/$defs/id"
        },
        "head_snapshot_id": {
          "$ref": "#/$defs/digest"
        },
        "kind": {
          "enum": [
            "cargo_target"
          ]
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_bytes",
            "max_entries",
            "max_depth",
            "max_path_bytes"
          ],
          "properties": {
            "max_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8589934592
            },
            "max_entries": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500000
            },
            "max_depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "max_path_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            }
          }
        },
        "build_cache_artifact_id": {
          "$ref": "#/$defs/digest"
        },
        "refused": {
          "enum": [
            "unsafe_content",
            "limit_exceeded",
            "source_unavailable",
            "capture_failed"
          ]
        },
        "entries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "oneOf": [
        {
          "required": [
            "build_cache_artifact_id"
          ],
          "not": {
            "required": [
              "refused"
            ]
          }
        },
        {
          "required": [
            "refused"
          ],
          "not": {
            "required": [
              "build_cache_artifact_id"
            ]
          }
        }
      ]
    },
    "worker_notes_recorded": {
      "description": "What became of one admitted Attempt's notes declaration: exactly one of a WorkerNotes@1 artifact or a drop reason. The Attempt is admitted either way.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_artifact_id",
        "bytes"
      ],
      "properties": {
        "result_artifact_id": {
          "$ref": "#/$defs/digest"
        },
        "notes_artifact_id": {
          "$ref": "#/$defs/digest"
        },
        "dropped": {
          "enum": [
            "absent",
            "malformed",
            "invalid_path",
            "over_bound"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "oneOf": [
        {
          "required": [
            "notes_artifact_id"
          ],
          "not": {
            "required": [
              "dropped"
            ]
          }
        },
        {
          "required": [
            "dropped"
          ],
          "not": {
            "required": [
              "notes_artifact_id"
            ]
          }
        }
      ]
    },
