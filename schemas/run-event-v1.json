{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:review-kernel:schema:run-event:1",
  "title": "RunEvent@1 envelope",
  "description": "The source of truth. One kernel sequencer allocates a monotonic per-run sequence while many reviewers execute concurrently. Events are never edited: a correction is a new compensating event. Large values live in content-addressed artifacts referenced by digest, never inline.",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "run_id", "sequence", "type", "occurred_at", "payload"],
  "properties": {
    "event_id": { "$ref": "#/$defs/id" },
    "run_id": { "type": "string", "minLength": 1 },
    "sequence": {
      "description": "Monotonic per-run sequence allocated by the single sequencer. Dense and gapless: a gap means loss, not reordering.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "type": {
      "description": "Closed event type and semantic-version vocabulary. New event kinds and payload versions are explicit additive contract changes.",
      "type": "string",
      "enum": [
        "AttemptAdmitted@1",
        "AttemptDispatched@1",
        "AttemptFailed@1",
        "AttemptFenced@1",
        "AttemptReleased@1",
        "CheckCompleted@1",
        "CampaignOpened@1",
        "FindingReported@1",
        "FindingResolved@1",
        "GateDecision@1",
        "GenerationAdvanced@1",
        "NodeInvocation@1",
        "NodeOutputReceipt@1",
        "RunReport@1",
        "RunReport@2",
        "RoundInputSuperseded@1",
        "RoundStarted@1",
        "SourceCaptured@1"
      ]
    },
    "occurred_at": {
      "description": "Wall-clock observation, for humans and forensics. NOT an ordering authority — `sequence` is. Replay must never depend on this field.",
      "type": "string",
      "format": "date-time"
    },
    "node_id": { "type": "string", "minLength": 1 },
    "attempt_id": { "type": "string", "minLength": 1 },
    "causation_id": {
      "description": "The event this one was caused by. Absent for a run's first event.",
      "$ref": "#/$defs/id"
    },
    "correlation_id": {
      "description": "Subject this event is about across its lifetime, e.g. a Finding ID.",
      "type": "string",
      "minLength": 1
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "payload": {
      "description": "Type-specific body. Must satisfy the I-JSON numeric domain: finite binary64, integers only within the interoperable safe range, no negative zero.",
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "CampaignOpened@1" } }, "required": ["type"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/campaign_opened" } } }
    },
    {
      "if": { "properties": { "type": { "const": "RoundStarted@1" } }, "required": ["type"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/round_started" } } }
    },
    {
      "if": { "properties": { "type": { "const": "RoundInputSuperseded@1" } }, "required": ["type"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/round_superseded" } } }
    }
  ],
  "$defs": {
    "id": {
      "description": "Monotonic sortable identifier (ULID-style), lowercase.",
      "type": "string",
      "pattern": "^[0-9a-z]{26}$"
    },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "campaign_opened": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign_manifest_id", "authority_snapshot_id"],
      "properties": {
        "campaign_manifest_id": { "$ref": "#/$defs/digest" },
        "authority_snapshot_id": { "$ref": "#/$defs/digest" }
      }
    },
    "round_started": {
      "type": "object",
      "additionalProperties": false,
      "required": ["round", "epoch", "campaign_manifest_id", "subject_id", "prior_finding_set_id", "prior_demand_set_id"],
      "properties": {
        "round": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "epoch": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "campaign_manifest_id": { "$ref": "#/$defs/digest" },
        "subject_id": { "$ref": "#/$defs/digest" },
        "prior_finding_set_id": { "$ref": "#/$defs/digest" },
        "prior_demand_set_id": { "$ref": "#/$defs/digest" }
      }
    },
    "round_superseded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["round", "old_epoch", "new_epoch", "campaign_manifest_id", "old_subject_id", "replacement_subject_id"],
      "properties": {
        "round": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "old_epoch": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "new_epoch": { "type": "integer", "minimum": 2, "maximum": 4294967295 },
        "campaign_manifest_id": { "$ref": "#/$defs/digest" },
        "old_subject_id": { "$ref": "#/$defs/digest" },
        "replacement_subject_id": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
