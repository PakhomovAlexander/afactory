{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:review-decision-context:1",
  "title": "Checked native human Review context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "review_id",
    "review",
    "subject",
    "finding_set",
    "demand_set",
    "finding_view_ids",
    "policy_time",
    "resolutions"
  ],
  "properties": {
    "schema": {
      "const": "af/review-decision-context@1"
    },
    "review_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "review": {
      "$ref": "urn:af:schema:task-review-round:1"
    },
    "subject": {
      "$ref": "urn:review-kernel:schema:subject:1"
    },
    "finding_set": {
      "$ref": "urn:review-kernel:schema:finding-set:1"
    },
    "demand_set": {
      "$ref": "urn:review-kernel:schema:demand-set:1"
    },
    "finding_view_ids": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "policy_time": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "resolutions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "resolution"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "resolution": {
            "$ref": "urn:review-kernel:schema:finding-resolution:1"
          }
        }
      }
    }
  }
}
