{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:review-kernel:schema:reviewer-result:1",
  "title": "ReviewerResult@1 payload",
  "description": "What one reviewer attempt returned. Reports use the flat reviewer shape emitted by every live adapter; the kernel converts each admitted report to FindingReport@1 and assigns identity, which is why a reviewer cannot name a Finding it has not been given.",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "reports", "benchmark_demands", "disputes"],
  "properties": {
    "verdict": {
      "description": "The reviewer's overall judgement. Evidence for a human, never authority: it does not gate, resolve, or converge anything on its own.",
      "enum": ["approve", "request-changes", "block"]
    },
    "summary": {
      "type": ["string", "null"]
    },
    "reports": {
      "description": "Immutable claims, in the order the reviewer made them. An empty list is a real answer — a reviewer that found nothing is not a reviewer that failed.",
      "type": "array",
      "items": { "$ref": "#/$defs/legacyReport" }
    },
    "benchmark_demands": {
      "description": "Proof this reviewer wants before a performance claim is believed. A demand, not a finding: it asserts nothing except that nothing has been measured.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "why", "suggested_method"],
        "properties": {
          "claim": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 },
          "suggested_method": { "type": "string", "minLength": 1 }
        }
      }
    },
    "disputes": {
      "description": "This reviewer's position on claims it was given. The only channel by which one reviewer's verdict on another's claim reaches the ledger.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "position", "reason"],
        "properties": {
          "claim_id": { "type": "string", "minLength": 1 },
          "position": { "enum": ["confirm", "refute"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "legacyReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "file", "title", "body", "fix"],
      "allOf": [
        {
          "if": { "properties": { "file": { "enum": ["", "(change-wide)"] } } },
          "then": { "properties": { "line": { "type": "null" } } }
        }
      ],
      "properties": {
        "severity": { "enum": ["blocker", "major", "minor"] },
        "file": {
          "type": "string",
          "anyOf": [
            { "enum": ["", "(change-wide)"] },
            {
              "allOf": [
                { "pattern": "^(?:[^/.\\u0000][^/\\u0000]*|\\.[^./\\u0000][^/\\u0000]*|\\.\\.[^/\\u0000][^/\\u0000]*)(?:/(?:[^/.\\u0000][^/\\u0000]*|\\.[^./\\u0000][^/\\u0000]*|\\.\\.[^/\\u0000][^/\\u0000]*))*$" },
                { "pattern": "^\\S(?:[\\s\\S]*\\S)?$" }
              ]
            }
          ]
        },
        "line": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 4294967295
        },
        "title": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "body": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "fix": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
