{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schedule",
    "objects",
    "receipts",
    "grades"
  ],
  "properties": {
    "schema": {
      "enum": [
        "af.agent-bench-evidence/2"
      ]
    },
    "schedule": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "objects": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 4096,
      "propertyNames": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "maxItems": 512,
      "minItems": 0
    },
    "grades": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "maxItems": 512,
      "minItems": 0
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "pair",
        "family",
        "side",
        "case",
        "repetition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "pair": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "family": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "side": {
          "enum": [
            "base",
            "head"
          ]
        },
        "case": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "repetition": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "protocol",
        "cases",
        "oracles",
        "source_base",
        "source_head",
        "model",
        "collector",
        "mode",
        "slots"
      ],
      "properties": {
        "schema": {
          "enum": [
            "af.agent-bench-schedule/2"
          ]
        },
        "protocol": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "cases": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "oracles": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_base": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_head": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "model": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "collector": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "mode": {
          "enum": [
            "smoke",
            "aa",
            "exposed_ab"
          ]
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slot"
          },
          "maxItems": 512,
          "minItems": 2
        }
      }
    },
    "tool_schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "protocol", "cases", "oracles", "source_base", "source_head",
        "model", "collector", "mode", "slots", "configuration", "tools_base", "tools_head"
      ],
      "properties": {
        "schema": { "const": "af.agent-bench-tool-schedule/1" },
        "mode": { "const": "exposed_ab" },
        "protocol": { "$ref": "#/$defs/schedule/properties/protocol" },
        "cases": { "$ref": "#/$defs/schedule/properties/cases" },
        "oracles": { "$ref": "#/$defs/schedule/properties/oracles" },
        "source_base": { "$ref": "#/$defs/schedule/properties/source_base" },
        "source_head": { "$ref": "#/$defs/schedule/properties/source_head" },
        "model": { "$ref": "#/$defs/schedule/properties/model" },
        "collector": { "$ref": "#/$defs/schedule/properties/collector" },
        "slots": { "$ref": "#/$defs/schedule/properties/slots" },
        "configuration": { "$ref": "#/$defs/schedule/properties/collector" },
        "tools_base": { "$ref": "#/$defs/schedule/properties/collector" },
        "tools_head": { "$ref": "#/$defs/schedule/properties/collector" }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "input",
        "output",
        "cached_input",
        "reasoning_output",
        "chargeable",
        "usage_complete"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "input": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "output": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "cached_input": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoning_output": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "chargeable": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "usage_complete": {
          "type": "boolean"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schedule",
        "slot",
        "status",
        "wall_ns",
        "timing_complete",
        "invocations",
        "answer",
        "trace_complete"
      ],
      "properties": {
        "schema": {
          "enum": [
            "af.agent-bench-receipt/1"
          ]
        },
        "schedule": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "slot": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "status": {
          "enum": [
            "ok",
            "error",
            "timeout",
            "cancelled",
            "lost",
            "not_started"
          ]
        },
        "wall_ns": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "timing_complete": {
          "type": "boolean"
        },
        "invocations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/invocation"
          },
          "maxItems": 128,
          "minItems": 0
        },
        "answer": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "trace_complete": {
          "type": "boolean"
        }
      }
    },
    "grade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schedule",
        "slot",
        "answer",
        "oracle",
        "verdict",
        "evidence"
      ],
      "properties": {
        "schema": {
          "enum": [
            "af.agent-bench-grade/1"
          ]
        },
        "schedule": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "slot": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "answer": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "oracle": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "verdict": {
          "enum": [
            "correct",
            "wrong",
            "ambiguous"
          ]
        },
        "evidence": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "cases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "cases"
      ],
      "properties": {
        "schema": {
          "const": "af.agent-bench-cases/1"
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "family",
              "prompt"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              },
              "family": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 65536
              }
            }
          }
        }
      }
    }
  }
}
