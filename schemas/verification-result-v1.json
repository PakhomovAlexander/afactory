{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:verification-result:1",
  "title": "verification-result@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "snapshot_id",
    "policy_id",
    "outcome",
    "check_receipt_id"
  ],
  "properties": {
    "plan_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    },
    "snapshot_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    },
    "policy_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    },
    "outcome": {
      "enum": [
        "passed",
        "failed",
        "inconclusive"
      ]
    },
    "check_receipt_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    },
    "evaluation_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "passed"
          }
        }
      },
      "then": {
        "required": [
          "evaluation_id"
        ]
      }
    }
  ]
}
