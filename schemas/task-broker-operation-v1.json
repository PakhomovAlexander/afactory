{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-broker-operation:1",
  "title": "TaskBrokerOperation@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_id",
    "receipt"
  ],
  "properties": {
    "binding_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    },
    "receipt": {
      "$ref": "urn:af:schema:broker-operation-receipt:2"
    }
  },
  "description": "A receipt under one captured Task Broker binding. Request and response digests describe connector bytes and need not identify CAS artifacts."
}
