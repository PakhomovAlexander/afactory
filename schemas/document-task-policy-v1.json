{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:document-task-policy:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "max_document_bytes",
    "required_sections",
    "require_citations",
    "check_wall_ms",
    "require_container"
  ],
  "properties": {
    "schema": {
      "const": "af.document-task-policy/1"
    },
    "max_document_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "required_sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "\\S",
        "allOf": [
          {
            "not": {
              "pattern": "[\\x00-\\x1f\\x7f]"
            }
          }
        ]
      }
    },
    "require_citations": {
      "type": "boolean"
    },
    "check_wall_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60000
    },
    "require_container": {
      "type": "boolean"
    }
  }
}
