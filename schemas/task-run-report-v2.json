{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-run-report:2",
  "title": "TaskRunReport@2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_revision_id",
    "plan_id",
    "through_sequence",
    "nodes"
  ],
  "properties": {
    "task_revision_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "through_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node",
          "outcome"
        ],
        "properties": {
          "node": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(\\.[A-Za-z0-9][A-Za-z0-9_-]{0,127})*$"
          },
          "outcome": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "output_id"
                ],
                "properties": {
                  "kind": {
                    "const": "completed"
                  },
                  "output_id": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "diagnostic_id",
                  "class"
                ],
                "properties": {
                  "kind": {
                    "const": "failed"
                  },
                  "diagnostic_id": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "class": {
                    "enum": [
                      "execution",
                      "resources",
                      "domain_publication"
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "reason"
                ],
                "properties": {
                  "kind": {
                    "const": "suppressed"
                  },
                  "reason": {
                    "enum": [
                      "branch_not_selected",
                      "upstream_missing"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "phase_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "if": {
    "required": [
      "phase_id"
    ]
  },
  "then": {
    "properties": {
      "nodes": {
        "maxItems": 1,
        "items": {
          "properties": {
            "outcome": {
              "not": {
                "required": [
                  "reason"
                ]
              }
            }
          }
        }
      }
    }
  }
}
