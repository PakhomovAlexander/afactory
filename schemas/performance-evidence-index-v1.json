{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:performance-evidence-index:1",
  "title": "af.perf-evidence-index/1",
  "description": "Native Scenario lab integration.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "af.perf-evidence-index/1"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "finding",
              "performance",
              "telemetry"
            ]
          },
          "source_id": {
            "$ref": "#/$defs/digest"
          },
          "source_digest": {
            "$ref": "#/$defs/digest"
          },
          "provenance": {
            "type": "string",
            "enum": [
              "verified_native",
              "native_journal",
              "captured_artifact"
            ]
          },
          "freshness_basis": {
            "type": "string",
            "enum": [
              "native_terminal",
              "native_created",
              "native_cutoff",
              "capture_observed"
            ]
          },
          "observed_unix_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740992
          },
          "compatibility": {
            "$ref": "#/$defs/digest"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "positive",
              "negative",
              "inconclusive",
              "merged",
              "diagnostic"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [
          "kind",
          "source_id",
          "source_digest",
          "provenance",
          "freshness_basis",
          "observed_unix_ms",
          "compatibility",
          "outcome",
          "summary"
        ]
      },
      "minItems": 0,
      "maxItems": 4096
    }
  },
  "required": [
    "schema",
    "artifacts"
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
