{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-state:2",
  "title": "The Task state every af task rendering prints",
  "$comment": "One state model behind `af task list`, `show`, `report` and `run`, text and --json alike (`af help task-states`): a phase, a terminal outcome present exactly when the Task ended, a cause from a closed vocabulary present exactly when that outcome is not `verified` or the Task was collected, and the one af command to run next. Derived from the Store each time it is read, never persisted. The gate is the last check receipt's summary; a failure is one failed node of the last run report.",
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "outcome",
        "cause",
        "next_action"
      ],
      "properties": {
        "phase": {
          "enum": [
            "planned",
            "running",
            "waiting",
            "abandoned",
            "finished"
          ]
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/outcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "cause": {
          "anyOf": [
            {
              "$ref": "#/$defs/cause"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_action": {
          "description": "One exact af command, or null for none.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^af [^\\u0000-\\u001f\\u007f]{1,2045}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "enum": [
                  "finished",
                  "abandoned"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "$ref": "#/$defs/outcome"
              }
            }
          },
          "else": {
            "properties": {
              "outcome": {
                "type": "null"
              },
              "cause": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "abandoned"
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "const": "cancelled"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "verified"
              }
            }
          },
          "then": {
            "properties": {
              "cause": {
                "enum": [
                  null,
                  "collected"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "changes_requested"
              }
            }
          },
          "then": {
            "properties": {
              "cause": {
                "enum": [
                  "reviewer_findings",
                  "evaluator_rejected",
                  "collected"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "gate_failed"
              }
            }
          },
          "then": {
            "properties": {
              "cause": {
                "enum": [
                  "check_failed",
                  "check_flaky_then_failed",
                  "preflight_failed",
                  "collected"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "provider_failed"
              }
            }
          },
          "then": {
            "properties": {
              "cause": {
                "enum": [
                  "malformed_reply",
                  "provider_network",
                  "provider_capacity",
                  "provider_timeout",
                  "provider_environment",
                  "identity_changed",
                  "identity_unverified",
                  "model_refused",
                  "collected"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "cancelled"
              }
            }
          },
          "then": {
            "properties": {
              "cause": {
                "enum": [
                  "writer_lost",
                  "host_cancelled",
                  "collected"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "expired"
              }
            }
          },
          "then": {
            "properties": {
              "cause": {
                "enum": [
                  "deadline",
                  "collected"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "exhausted"
              }
            }
          },
          "then": {
            "properties": {
              "cause": {
                "enum": [
                  "budget",
                  "attempt_wall",
                  "collected"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cause": {
                "const": "collected"
              }
            }
          },
          "then": {
            "properties": {
              "phase": {
                "const": "finished"
              },
              "next_action": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "cause"
            ],
            "properties": {
              "cause": {
                "enum": [
                  "reviewer_findings",
                  "evaluator_rejected",
                  "check_failed",
                  "check_flaky_then_failed",
                  "preflight_failed",
                  "malformed_reply",
                  "provider_network",
                  "provider_capacity",
                  "provider_timeout",
                  "provider_environment",
                  "identity_changed",
                  "identity_unverified",
                  "model_refused",
                  "writer_lost",
                  "deadline",
                  "budget",
                  "attempt_wall",
                  "host_cancelled"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "next_action": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "outcome": {
      "enum": [
        "verified",
        "changes_requested",
        "gate_failed",
        "provider_failed",
        "cancelled",
        "exhausted",
        "expired"
      ]
    },
    "cause": {
      "enum": [
        "reviewer_findings",
        "evaluator_rejected",
        "check_failed",
        "check_flaky_then_failed",
        "preflight_failed",
        "malformed_reply",
        "provider_network",
        "provider_capacity",
        "provider_timeout",
        "provider_environment",
        "identity_changed",
        "identity_unverified",
        "model_refused",
        "writer_lost",
        "deadline",
        "budget",
        "attempt_wall",
        "collected",
        "host_cancelled"
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "failed_tests",
        "flaky"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "failed_tests": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/testName"
          }
        },
        "flaky": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/testName"
          }
        }
      }
    },
    "testName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "cause",
        "first_line",
        "diagnostic_id"
      ],
      "properties": {
        "node": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "cause": {
          "description": "The cause the node's own records name; null for a node that only lacks a receipt another failed node did not produce.",
          "anyOf": [
            {
              "$ref": "#/$defs/cause"
            },
            {
              "type": "null"
            }
          ]
        },
        "first_line": {
          "type": "string",
          "maxLength": 1024
        },
        "diagnostic_id": {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
        },
        "stderr_id": {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
        }
      }
    }
  }
}
