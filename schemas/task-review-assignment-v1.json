{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-review-assignment:1",
  "title": "TaskReviewAssignment@1",
  "description": "Exact source-scoped assignment. Semantic validation additionally enforces unique IDs, source equality, exclusions and a 64 KiB serialized payload bound.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject_id",
    "prior_history_id",
    "round",
    "reviewer",
    "findings"
  ],
  "properties": {
    "subject_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    },
    "prior_history_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "reviewer": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/name"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "urn:review-kernel:schema:finding-set:1#/properties/findings/items"
      }
    }
  }
}
