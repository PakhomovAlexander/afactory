{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-inspection:3",
  "title": "Task inspection af/task-inspection@3",
  "$comment": "Read-only projection of common Task history. Execution entries retain original V1/V3 payload bytes and match their exact artifact type. Store validates cross-artifact identities, histories, selected results and cumulative accounting; a JSON schema cannot authenticate CAS or recompute a history. Failed-record diagnostic is an explicitly opaque CAS JSON leaf; run-report diagnostics are typed. Explain adds graph and plan together.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "revision_id",
    "phase",
    "plan_id",
    "chargeable_tokens",
    "attempts",
    "history",
    "execution_records",
    "run_reports"
  ],
  "properties": {
    "schema": {
      "const": "af/task-inspection@3"
    },
    "task_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/name"
    },
    "revision_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    },
    "phase": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/taskPhase"
    },
    "plan_id": {
      "anyOf": [
        {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "chargeable_tokens": {
      "$ref": "urn:af:schema:task-token-usage:2#/$defs/decimalU128"
    },
    "attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "request_revision_id",
        "assessment"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
        },
        "request_revision_id": {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
        },
        "assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "requested",
            "no_match",
            "candidates",
            "decision"
          ],
          "properties": {
            "schema": {
              "const": "af.pipeline-selection/1"
            },
            "requested": {
              "anyOf": [
                {
                  "$ref": "urn:af:schema:task-contracts:1#/$defs/choice"
                },
                {
                  "type": "null"
                }
              ]
            },
            "no_match": {
              "enum": [
                "refuse",
                "generate"
              ]
            },
            "candidates": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pipeline",
                  "preferred",
                  "priority",
                  "state"
                ],
                "properties": {
                  "pipeline": {
                    "type": "string"
                  },
                  "preferred": {
                    "type": "boolean"
                  },
                  "priority": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "state": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind"
                        ],
                        "properties": {
                          "kind": {
                            "const": "fit"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind"
                        ],
                        "properties": {
                          "kind": {
                            "const": "compatible"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "reasons"
                        ],
                        "properties": {
                          "kind": {
                            "const": "no_fit"
                          },
                          "reasons": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "facts"
                        ],
                        "properties": {
                          "kind": {
                            "const": "unknown_facts"
                          },
                          "facts": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "uniqueItems": true
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "reason"
                        ],
                        "properties": {
                          "kind": {
                            "const": "unavailable"
                          },
                          "reason": {
                            "type": "string"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "reason"
                        ],
                        "properties": {
                          "kind": {
                            "const": "infeasible"
                          },
                          "reason": {
                            "type": "string"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "reason"
                        ],
                        "properties": {
                          "kind": {
                            "const": "invalid"
                          },
                          "reason": {
                            "type": "string"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            },
            "decision": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "unavailable"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "infeasible"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "invalid"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "refused"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "needs_generation"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "pipeline"
                  ],
                  "properties": {
                    "kind": {
                      "const": "selected"
                    },
                    "pipeline": {
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "pipelines"
                  ],
                  "properties": {
                    "kind": {
                      "const": "ambiguous"
                    },
                    "pipelines": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "uniqueItems": true
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "facts"
                  ],
                  "properties": {
                    "kind": {
                      "const": "needs_facts"
                    },
                    "facts": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "uniqueItems": true
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "planning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bootstrap_plan_id",
        "proposal_id",
        "request_revision_id"
      ],
      "properties": {
        "bootstrap_plan_id": {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
        },
        "proposal_id": {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
        },
        "request_revision_id": {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
        }
      }
    },
    "plan_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "decision",
          "valid_until_unix_ms"
        ],
        "properties": {
          "artifact_id": {
            "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
          },
          "decision": {
            "$ref": "urn:af:schema:task-contracts:1#/$defs/planDecision"
          },
          "valid_until_unix_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "minItems": 1
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "transition"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "transition": {
            "$ref": "urn:af:schema:task-transition:1"
          }
        }
      }
    },
    "execution_records": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "artifact_type",
              "record"
            ],
            "properties": {
              "artifact_id": {
                "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
              },
              "artifact_type": {
                "const": "af/TaskExecutionRecord@1"
              },
              "record": {
                "$ref": "urn:af:schema:task-execution-record:1"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "artifact_type",
              "record"
            ],
            "properties": {
              "artifact_id": {
                "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
              },
              "artifact_type": {
                "const": "af/TaskExecutionRecord@3"
              },
              "record": {
                "$ref": "urn:af:schema:task-execution-record:3"
              },
              "diagnostic": {
                "$comment": "Exact referenced CAS JSON, intentionally opaque: a Failed record may point at any JSON value."
              }
            }
          }
        ]
      }
    },
    "run_reports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "report",
          "diagnostics"
        ],
        "properties": {
          "artifact_id": {
            "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
          },
          "report": {
            "$ref": "urn:af:schema:task-run-report:1"
          },
          "diagnostics": {
            "type": "object",
            "additionalProperties": {
              "$ref": "urn:af:schema:task-diagnostic:1"
            }
          }
        }
      }
    },
    "delivery": {
      "$ref": "#/$defs/deliveryReceipt"
    },
    "result": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/taskResult"
    },
    "planning_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "plan_id",
        "reason"
      ],
      "properties": {
        "schema": {
          "const": "af.planning-diagnostic/1"
        },
        "plan_id": {
          "anyOf": [
            {
              "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 8192
        }
      }
    },
    "repair_assessments": {
      "type": "array",
      "items": {
        "$ref": "urn:af:schema:task-contracts:1#/$defs/repairAssessment"
      },
      "minItems": 1
    },
    "review_rounds": {
      "type": "array",
      "items": {
        "$ref": "urn:af:schema:task-review-round:1"
      }
    },
    "graph": {
      "$ref": "urn:af:schema:compiled-task:1"
    },
    "plan": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/executionPlan"
    }
  },
  "$defs": {
    "deliveryReceipt": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "delivery_id",
            "task_id",
            "result_id",
            "source_snapshot_id",
            "derived_snapshot_id",
            "target",
            "source_revision"
          ],
          "properties": {
            "schema": {
              "const": "af/task-delivery-prepared@1"
            },
            "delivery_id": {
              "type": "string"
            },
            "task_id": {
              "type": "string"
            },
            "result_id": {
              "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
            },
            "source_snapshot_id": {
              "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
            },
            "derived_snapshot_id": {
              "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
            },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository",
                "repository_id",
                "branch",
                "worktree"
              ],
              "properties": {
                "repository": {
                  "type": "string"
                },
                "repository_id": {
                  "type": "string"
                },
                "branch": {
                  "type": "string"
                },
                "worktree": {
                  "type": "string"
                }
              }
            },
            "source_revision": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "delivery_id",
            "task_id",
            "result_id",
            "source_snapshot_id",
            "derived_snapshot_id",
            "target",
            "outcome",
            "ignored_paths",
            "remote_actions"
          ],
          "properties": {
            "schema": {
              "const": "af/task-delivery@1"
            },
            "delivery_id": {
              "type": "string"
            },
            "task_id": {
              "type": "string"
            },
            "result_id": {
              "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
            },
            "source_snapshot_id": {
              "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
            },
            "derived_snapshot_id": {
              "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
            },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository",
                "repository_id",
                "branch",
                "worktree"
              ],
              "properties": {
                "repository": {
                  "type": "string"
                },
                "repository_id": {
                  "type": "string"
                },
                "branch": {
                  "type": "string"
                },
                "worktree": {
                  "type": "string"
                }
              }
            },
            "outcome": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "delivered"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "reason"
                  ],
                  "properties": {
                    "kind": {
                      "const": "failed"
                    },
                    "reason": {
                      "type": "string"
                    }
                  }
                }
              ]
            },
            "ignored_paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "remote_actions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  },
  "dependentRequired": {
    "graph": [
      "plan"
    ],
    "plan": [
      "graph"
    ],
    "delivery": [
      "result"
    ],
    "planning_diagnostic": [
      "result"
    ],
    "repair_assessments": [
      "result"
    ],
    "review_rounds": [
      "result"
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "properties": {
              "kind": {
                "const": "finished"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "result"
        ]
      },
      "else": {
        "not": {
          "required": [
            "result"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "graph"
        ]
      },
      "then": {
        "properties": {
          "plan_id": {
            "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
          }
        }
      }
    }
  ]
}
