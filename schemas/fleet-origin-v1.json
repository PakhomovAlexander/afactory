{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:fleet-origin:1",
  "title": "Authenticated Project origin observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "scope", "observed_unix_ms", "origin"],
  "properties": {
    "schema": {"const": "af/fleet-origin@1"},
    "scope": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
    "observed_unix_ms": {"type": "integer", "minimum": 0},
    "origin": {"$ref": "#/$defs/project_origin"}
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "subject", "revision", "observed_unix_ms", "age_ms", "freshness"],
      "properties": {
        "source": {"type": "string"},
        "subject": {"type": "string"},
        "revision": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "observed_unix_ms": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "age_ms": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "freshness": {
          "enum": [
            "fresh",
            "stale",
            "unavailable",
            "denied",
            "identity_mismatch",
            "missing_credential",
            "invalid_response"
          ]
        }
      }
    },
    "project_origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "project_id", "store_id", "principal", "tasks"],
      "properties": {
        "origin": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
        "project_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "store_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "principal": {"type": "string"},
        "tasks": {"type": "array", "items": {"$ref": "#/$defs/waiting_task"}}
      }
    },
    "waiting_task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "placement", "phase", "reason", "decision", "observation"],
      "properties": {
        "task_id": {"type": "string"},
        "placement": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "phase": {"enum": ["waiting"]},
        "reason": {"enum": ["needs_resources", "needs_input", "needs_human", "needs_plan_review"]},
        "decision": {"anyOf": [{"$ref": "#/$defs/decision"}, {"type": "null"}]},
        "observation": {"$ref": "#/$defs/observation"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_revision_id", "plan_id", "developer", "prepared_id"],
      "properties": {
        "task_revision_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "plan_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "developer": {"type": "string"},
        "prepared_id": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
