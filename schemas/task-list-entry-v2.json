{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-list-entry:2",
  "title": "Task list entry af/task-list-entry@2",
  "$comment": "One common Task entry in the CLI list. Unfinished outcome, absent snapshot and absent delivery are explicit nulls. phase/result/delivery identity and charge consistency are checked by Store projection, not by this structural schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "kind",
    "phase",
    "outcome",
    "chargeable_tokens",
    "derived_snapshot_id",
    "delivery"
  ],
  "properties": {
    "schema": {
      "const": "af/task-list-entry@2"
    },
    "task_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/name"
    },
    "kind": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/package"
    },
    "phase": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/taskPhase"
    },
    "outcome": {
      "anyOf": [
        {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/text"
        },
        {
          "type": "null"
        }
      ]
    },
    "chargeable_tokens": {
      "$ref": "urn:af:schema:task-token-usage:3#/$defs/decimalU128"
    },
    "unknown_usage_attempts": {
      "description": "Settled Attempts whose Provider reported no usage: each was charged zero and its usage is unknown (ADR-0143), so `chargeable_tokens` is not their spend. Absent when every usage is known. A collected Task's count is the one its tombstone retained.",
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "derived_snapshot_id": {
      "anyOf": [
        {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "delivery": {
      "anyOf": [
        {
          "$ref": "urn:af:schema:task-inspection:11#/$defs/deliveryReceipt"
        },
        {
          "type": "null"
        }
      ]
    },
    "collected": {
      "description": "Present exactly when the Task was collected by `af task gc --apply` (ADR-0135): its retained tombstone. Such an entry is finished, carries no derived Snapshot or delivery, has a zero footprint under `--sizes`, and its phase names the result its log recorded.",
      "$ref": "urn:af:schema:task-collected:1"
    },
    "sizes": {
      "description": "`af task list --sizes` only (ADR-0135): the CAS objects only this Task reaches, and those it shares with another Task or Campaign record; all zero for a collected Task.",
      "$ref": "#/$defs/footprint"
    }
  },
  "$defs": {
    "footprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exclusive_objects",
        "exclusive_bytes",
        "shared_objects",
        "shared_bytes"
      ],
      "properties": {
        "exclusive_objects": {
          "$ref": "#/$defs/count"
        },
        "exclusive_bytes": {
          "$ref": "#/$defs/count"
        },
        "shared_objects": {
          "$ref": "#/$defs/count"
        },
        "shared_bytes": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "collected"
        ]
      },
      "then": {
        "properties": {
          "phase": {
            "properties": {
              "kind": {
                "const": "finished"
              }
            }
          },
          "derived_snapshot_id": {
            "type": "null"
          },
          "delivery": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "properties": {
              "kind": {
                "const": "finished"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "$ref": "urn:af:schema:task-contracts:1#/$defs/text"
          }
        }
      },
      "else": {
        "properties": {
          "outcome": {
            "type": "null"
          },
          "derived_snapshot_id": {
            "type": "null"
          },
          "delivery": {
            "type": "null"
          }
        }
      }
    }
  ]
}
