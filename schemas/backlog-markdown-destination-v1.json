{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:backlog-markdown-destination:1",
  "title": "Receiver-owned Markdown backlog destination",
  "type": "object",
  "required": [
    "schema",
    "project_id"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "af/backlog-markdown-destination@1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
