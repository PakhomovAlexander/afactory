{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:performance-comparison-overview:1",
  "title": "af.perf-comparison-overview/1",
  "description": "Independent performance executor: comparison-overview (ADR-0240).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "af.perf-comparison-overview/1"
    },
    "journal_id": {
      "$ref": "#/$defs/id"
    },
    "machine_id": {
      "$ref": "#/$defs/id"
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseline_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "candidate_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "control_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "authority_sha": {
          "$ref": "#/$defs/git_sha"
        }
      },
      "required": [
        "baseline_sha",
        "candidate_sha",
        "control_sha",
        "authority_sha"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4096
      },
      "minItems": 0,
      "maxItems": 1024
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "request_id": {
            "$ref": "#/$defs/id"
          },
          "work": {
            "type": "string",
            "enum": [
              "core",
              "telemetry",
              "profile"
            ]
          },
          "submission": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "manual",
                  "main",
                  "pr",
                  "release",
                  "calibration"
                ]
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "kind",
              "key"
            ]
          },
          "plan_sha256": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/digest"
              }
            ]
          },
          "parent": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/id"
              }
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "claimed",
              "complete",
              "failed",
              "interrupted",
              "uncertain",
              "submitted",
              "expired"
            ]
          },
          "state_detail": {
            "type": "string",
            "maxLength": 4096
          },
          "started_unix_ms": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740992
              }
            ]
          },
          "ended_unix_ms": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740992
              }
            ]
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "verified",
                  "refused",
                  "not_terminal"
                ]
              },
              "detail": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "required": [
              "status",
              "detail"
            ]
          },
          "measurement_status": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "maxLength": 128
              }
            ]
          },
          "coverage": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "required": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483648
                  },
                  "observed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483648
                  },
                  "failed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483648
                  },
                  "missing": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2147483648
                  }
                },
                "required": [
                  "required",
                  "observed",
                  "failed",
                  "missing"
                ]
              }
            ]
          },
          "performance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "verdict": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "maxLength": 32
                  }
                ]
              },
              "regressions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                },
                "minItems": 0,
                "maxItems": 4096
              }
            },
            "required": [
              "verdict",
              "regressions"
            ]
          },
          "links": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/relative_path"
            },
            "minItems": 0,
            "maxItems": 16
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 4096
            },
            "minItems": 0,
            "maxItems": 64
          }
        },
        "required": [
          "request_id",
          "work",
          "submission",
          "plan_sha256",
          "parent",
          "state",
          "state_detail",
          "started_unix_ms",
          "ended_unix_ms",
          "verification",
          "measurement_status",
          "coverage",
          "performance",
          "links",
          "reasons"
        ]
      },
      "minItems": 1,
      "maxItems": 16
    }
  },
  "required": [
    "schema",
    "journal_id",
    "machine_id",
    "sources",
    "status",
    "reasons",
    "members"
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "git_sha": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "relative_path": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    }
  }
}
