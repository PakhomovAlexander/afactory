{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:store-writer:1",
  "title": "af/store-writer@1",
  "description": "One af release that opened a Store for writing, kept beside its event log in the store_writers table (release column, record column). A release that cannot replay a Store names its writer from it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "af_version",
    "first_unix_ms"
  ],
  "properties": {
    "schema": {
      "const": "af/store-writer@1"
    },
    "af_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9][0-9A-Za-z.+-]*$"
    },
    "first_unix_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
