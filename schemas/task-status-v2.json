{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-status:2",
  "title": "Task status af/task-status@2",
  "$comment": "What `af task status ID --json` and `af task wait ID --json` print (ADR-0245): the Task's state, the node whose Attempt runs now, the time since the Task's clock started, exact decimal tokens reserved, charged and remaining, Attempts with unknown usage, the last recorded comparable Gate duration when available, the run process holding its last lease and its cancel request. Read-only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "state",
    "node",
    "elapsed_ms",
    "charged_tokens",
    "reserved_tokens",
    "remaining_tokens",
    "unknown_usage_attempts",
    "last_gate",
    "run",
    "cancel"
  ],
  "properties": {
    "schema": {
      "const": "af/task-status@2"
    },
    "task_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/name"
    },
    "state": {
      "$ref": "urn:af:schema:task-state:1#/$defs/state"
    },
    "node": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "elapsed_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "charged_tokens": {
      "$ref": "urn:af:schema:task-token-usage:3#/$defs/decimalU128"
    },
    "reserved_tokens": {
      "$ref": "urn:af:schema:task-token-usage:3#/$defs/decimalU128"
    },
    "remaining_tokens": {
      "$ref": "urn:af:schema:task-token-usage:3#/$defs/decimalU128"
    },
    "unknown_usage_attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "last_gate": {
      "anyOf": [
        {"type": "string", "minLength": 1, "maxLength": 65536, "pattern": "\\S"},
        {"type": "null"}
      ]
    },
    "run": {
      "anyOf": [
        {
          "$ref": "urn:af:schema:task-run-process:1"
        },
        {
          "type": "null"
        }
      ]
    },
    "cancel": {
      "anyOf": [
        {
          "$ref": "urn:af:schema:task-cancel-request:1"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
