{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:scenario-impl-source:1",
  "title": "scenario-impl-source v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_digest",
    "repository_id",
    "source_snapshot",
    "candidate_snapshot",
    "predecessor_snapshot",
    "source_content_digest",
    "source_commit",
    "candidate_tree",
    "transport_commit",
    "repository"
  ],
  "properties": {
    "schema": {
      "const": "af/scenario-impl-source@1"
    },
    "request_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "repository_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "source_snapshot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "candidate_snapshot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "predecessor_snapshot": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "source_content_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_commit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_tree": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^[0-9a-f]{40}$"
    },
    "transport_commit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^[0-9a-f]{40}$"
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/[^\\x00]+$"
    }
  }
}
