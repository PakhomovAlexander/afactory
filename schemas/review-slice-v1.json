{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:review-kernel:schema:review-slice:1",
  "title": "ReviewSlice@1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["slice_id", "runtime_node_id", "paths"],
  "properties": {
    "slice_id": { "$ref": "#/$defs/digest" },
    "runtime_node_id": { "type": "string", "minLength": 1 },
    "paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "overlaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/digest" }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
