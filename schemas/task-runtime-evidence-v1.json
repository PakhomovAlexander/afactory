{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-runtime-evidence:1",
  "title": "Task runtime evidence af/TaskRuntimeEvidence@1",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "attempt_id", "node", "context_id"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "node": {"type": "string", "minLength": 1, "maxLength": 256},
    "context_id": {"$ref": "#/$defs/digest"},
    "spans": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/span"}},
    "caches": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/cache"}}
  },
  "anyOf": [{"required": ["spans"]}, {"required": ["caches"]}],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"},
    "safe": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "u128": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,38})$", "maxLength": 39},
    "usage": {
      "type": "object", "additionalProperties": false, "required": ["chargeable_tokens"],
      "properties": {
        "input_tokens": {"$ref": "#/$defs/u128"}, "output_tokens": {"$ref": "#/$defs/u128"},
        "cache_read_tokens": {"$ref": "#/$defs/u128"}, "cache_write_tokens": {"$ref": "#/$defs/u128"},
        "reasoning_tokens": {"$ref": "#/$defs/u128"}, "chargeable_tokens": {"$ref": "#/$defs/u128"}
      }
    },
    "span": {
      "type": "object", "additionalProperties": false,
      "required": ["span_id", "kind", "label", "started_unix_ms", "elapsed_ms"],
      "properties": {
        "span_id": {"$ref": "#/$defs/digest"},
        "kind": {"enum": ["check", "dependency_preparation"]},
        "label": {"$ref": "#/$defs/name"},
        "started_unix_ms": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "elapsed_ms": {"$ref": "#/$defs/safe"}
      }
    },
    "cache": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_id", "kind", "eligible", "source_digest", "bytes_available", "lookup_ms", "materialization_ms"],
      "properties": {
        "observation_id": {"$ref": "#/$defs/digest"},
        "kind": {"$ref": "#/$defs/name"},
        "eligible": {"type": "boolean"},
        "source_digest": {"$ref": "#/$defs/digest"},
        "toolchain_id": {"$ref": "#/$defs/digest"},
        "bytes_available": {"$ref": "#/$defs/safe"},
        "lookup_ms": {"$ref": "#/$defs/safe"},
        "materialization_ms": {"$ref": "#/$defs/safe"}
      }
    }
  }
}
