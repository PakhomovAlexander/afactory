{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:nightly-job-v1",
  "title": "nightly-job-v1",
  "description": "Native nightly asynchronous service; admission binds exact provenance.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "af/nightly-job@1"
    },
    "nightly_tag": {
      "type": "string",
      "minLength": 18,
      "maxLength": 18,
      "pattern": "^nightly-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}$"
    },
    "configuration_digest": {
      "$ref": "#/$defs/digest"
    },
    "created_unix_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "deadline_unix_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "phases": {
      "type": "object",
      "minProperties": 0,
      "maxProperties": 4,
      "patternProperties": {
        "^(nightly_build_v1|nightly_compare_v1|nightly_report_v1|publish_nightly_v1)$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "intent_id": {
              "$ref": "#/$defs/digest"
            },
            "input_digest": {
              "$ref": "#/$defs/digest"
            },
            "inputs_digest": {
              "$ref": "#/$defs/digest"
            },
            "state": {
              "type": "string",
              "enum": [
                "queued",
                "running",
                "done",
                "failed",
                "uncertain"
              ]
            },
            "started_unix_ms": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              ]
            },
            "detail": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "evidence": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/digest"
                }
              ]
            }
          },
          "required": [
            "intent_id",
            "input_digest",
            "inputs_digest",
            "state",
            "started_unix_ms",
            "detail",
            "evidence"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "nightly_tag",
    "configuration_digest",
    "created_unix_ms",
    "deadline_unix_ms",
    "phases"
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
