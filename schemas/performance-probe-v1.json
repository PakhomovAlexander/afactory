{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:performance-probe:1",
  "title": "af.perf-probe/1",
  "description": "The native perf-probe's control message: case, contract, fixture and parameter identity, metrics and the correctness facts checked against golden entries.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "af.perf-probe/1"
    },
    "case_id": {
      "$ref": "#/$defs/id"
    },
    "instance_id": {
      "$ref": "#/$defs/id"
    },
    "contract_id": {
      "$ref": "#/$defs/id"
    },
    "fixture_digest": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/digest"
        }
      ]
    },
    "parameters": {
      "type": "object",
      "minProperties": 0,
      "maxProperties": 4,
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,63}$": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000000
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "patternProperties": {
        "^[a-z][a-z0-9_]{0,63}$": {
          "$ref": "#/$defs/metric"
        }
      },
      "additionalProperties": false
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed"
          ]
        },
        "digest": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        },
        "count": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            }
          ]
        },
        "detail": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "status",
        "digest",
        "count",
        "detail"
      ]
    }
  },
  "required": [
    "schema",
    "case_id",
    "instance_id",
    "contract_id",
    "fixture_digest",
    "parameters",
    "metrics",
    "correctness"
  ],
  "$defs": {
    "decimal": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
      "description": "Canonical nonnegative decimal, at most 38 significant digits."
    },
    "digest": {
      "type": "string",
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "#/$defs/decimal"
        },
        "unit": {
          "$ref": "#/$defs/unit"
        }
      },
      "required": [
        "value",
        "unit"
      ]
    },
    "unit": {
      "type": "string",
      "enum": [
        "ms",
        "bytes",
        "count",
        "ratio"
      ]
    }
  }
}
