{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:pi-provider-setup:2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "kind",
    "backend",
    "outcome",
    "detail"
  ],
  "properties": {
    "schema": {
      "const": "af/pi-provider-setup@2"
    },
    "id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "minLength": 1,
      "not": {
        "enum": [
          "codex-ambient",
          "claude-ambient"
        ]
      }
    },
    "kind": {
      "const": "pi"
    },
    "backend": {
      "enum": [
        "openai-codex",
        null
      ]
    },
    "outcome": {
      "enum": [
        "registered",
        "already_registered",
        "registry_conflict",
        "human_action_required"
      ]
    },
    "detail": {
      "type": "string",
      "minLength": 1
    }
  },
  "title": "Pi Provider setup @2",
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "registered",
              "already_registered",
              "registry_conflict"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "id": {
            "type": "string"
          },
          "backend": {
            "const": "openai-codex"
          }
        }
      }
    }
  ]
}
