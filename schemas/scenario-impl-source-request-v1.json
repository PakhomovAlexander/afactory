{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:scenario-impl-source-request:1",
  "title": "scenario-impl-source-request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "receipt",
    "source_commit",
    "candidate_snapshot_id",
    "predecessor_snapshot_id"
  ],
  "properties": {
    "schema": {
      "const": "af/scenario-impl-source-request@1"
    },
    "receipt": {
      "$ref": "urn:af:schema:scenario:4#/$defs/TaskReceipt"
    },
    "source_commit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "predecessor_snapshot_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      ]
    }
  }
}
