{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-inspection:11",
  "title": "Task inspection af/task-inspection@11",
  "$comment": "The one read-only projection of a common Task. Sections beyond the required core appear only when the Task recorded them: owned children, Review handoffs and Integration phases, measured Attempt walls with their runtime evidence, experiments and adoption observations. History, execution, report and handoff entries keep their exact artifact types and payloads. The Store validates cross-artifact identities, histories, selected results and cumulative accounting; a JSON schema cannot authenticate CAS or recompute a history. These records grant no admission or dispatch authority. Explain adds graph and plan together.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "revision_id",
    "phase",
    "plan_id",
    "chargeable_tokens",
    "attempts",
    "history",
    "execution_records",
    "run_reports"
  ],
  "properties": {
    "schema": {
      "const": "af/task-inspection@11"
    },
    "task_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/name"
    },
    "revision_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    },
    "phase": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/taskPhase"
    },
    "plan_id": {
      "anyOf": [
        {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "chargeable_tokens": {
      "$ref": "urn:af:schema:task-token-usage:2#/$defs/decimalU128"
    },
    "attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "request_revision_id",
        "assessment"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
        },
        "request_revision_id": {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
        },
        "assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "requested",
            "no_match",
            "candidates",
            "decision"
          ],
          "properties": {
            "schema": {
              "const": "af.pipeline-selection/1"
            },
            "requested": {
              "anyOf": [
                {
                  "$ref": "urn:af:schema:task-contracts:1#/$defs/choice"
                },
                {
                  "type": "null"
                }
              ]
            },
            "no_match": {
              "enum": [
                "refuse",
                "generate"
              ]
            },
            "candidates": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pipeline",
                  "preferred",
                  "priority",
                  "state"
                ],
                "properties": {
                  "pipeline": {
                    "type": "string"
                  },
                  "preferred": {
                    "type": "boolean"
                  },
                  "priority": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "state": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind"
                        ],
                        "properties": {
                          "kind": {
                            "const": "fit"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind"
                        ],
                        "properties": {
                          "kind": {
                            "const": "compatible"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "reasons"
                        ],
                        "properties": {
                          "kind": {
                            "const": "no_fit"
                          },
                          "reasons": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "facts"
                        ],
                        "properties": {
                          "kind": {
                            "const": "unknown_facts"
                          },
                          "facts": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            },
                            "uniqueItems": true
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "reason"
                        ],
                        "properties": {
                          "kind": {
                            "const": "unavailable"
                          },
                          "reason": {
                            "type": "string"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "reason"
                        ],
                        "properties": {
                          "kind": {
                            "const": "infeasible"
                          },
                          "reason": {
                            "type": "string"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "kind",
                          "reason"
                        ],
                        "properties": {
                          "kind": {
                            "const": "invalid"
                          },
                          "reason": {
                            "type": "string"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            },
            "decision": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "unavailable"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "infeasible"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "invalid"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "refused"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "needs_generation"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "pipeline"
                  ],
                  "properties": {
                    "kind": {
                      "const": "selected"
                    },
                    "pipeline": {
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "pipelines"
                  ],
                  "properties": {
                    "kind": {
                      "const": "ambiguous"
                    },
                    "pipelines": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "uniqueItems": true
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "facts"
                  ],
                  "properties": {
                    "kind": {
                      "const": "needs_facts"
                    },
                    "facts": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "uniqueItems": true
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "planning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bootstrap_plan_id",
        "proposal_id",
        "request_revision_id"
      ],
      "properties": {
        "bootstrap_plan_id": {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
        },
        "proposal_id": {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
        },
        "request_revision_id": {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
        }
      }
    },
    "plan_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "decision",
          "valid_until_unix_ms"
        ],
        "properties": {
          "artifact_id": {
            "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
          },
          "decision": {
            "$ref": "urn:af:schema:task-contracts:1#/$defs/planDecision"
          },
          "valid_until_unix_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "minItems": 1
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "transition"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "transition": {
            "oneOf": [
              {
                "$ref": "urn:af:schema:task-transition:1"
              },
              {
                "$ref": "urn:af:schema:task-transition:2"
              },
              {
                "$ref": "urn:af:schema:task-transition:3"
              },
              {
                "$ref": "urn:af:schema:task-transition:4"
              },
              {
                "$ref": "urn:af:schema:task-transition:5"
              }
            ]
          }
        }
      }
    },
    "execution_records": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "artifact_type",
              "record"
            ],
            "properties": {
              "artifact_id": {
                "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
              },
              "artifact_type": {
                "const": "af/TaskExecutionRecord@1"
              },
              "record": {
                "$ref": "urn:af:schema:task-execution-record:1"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "artifact_type",
              "record"
            ],
            "properties": {
              "artifact_id": {
                "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
              },
              "artifact_type": {
                "const": "af/TaskExecutionRecord@3"
              },
              "record": {
                "$ref": "urn:af:schema:task-execution-record:3"
              },
              "diagnostic": {
                "$comment": "The exact CAS JSON a Failed settlement's diagnostic_id names: an af.task-diagnostic/1 object that no published schema types.",
                "type": "object"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "artifact_type",
              "record"
            ],
            "properties": {
              "artifact_id": {
                "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
              },
              "artifact_type": {
                "const": "af/TaskExecutionRecord@4"
              },
              "record": {
                "$ref": "urn:af:schema:task-execution-record:4"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "artifact_type",
              "record"
            ],
            "properties": {
              "artifact_id": {
                "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
              },
              "artifact_type": {
                "const": "af/TaskExecutionRecord@5"
              },
              "record": {
                "$ref": "urn:af:schema:task-execution-record:5"
              }
            }
          }
        ]
      }
    },
    "run_reports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "report",
          "diagnostics"
        ],
        "properties": {
          "artifact_id": {
            "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
          },
          "report": {
            "oneOf": [
              {
                "$ref": "urn:af:schema:task-run-report:1"
              },
              {
                "$ref": "urn:af:schema:task-run-report:2"
              }
            ]
          },
          "diagnostics": {
            "type": "object",
            "additionalProperties": {
              "$ref": "urn:af:schema:task-diagnostic:1"
            }
          }
        }
      }
    },
    "delivery": {
      "$ref": "#/$defs/deliveryReceipt"
    },
    "result": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/taskResult"
    },
    "planning_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "plan_id",
        "reason"
      ],
      "properties": {
        "schema": {
          "const": "af.planning-diagnostic/1"
        },
        "plan_id": {
          "anyOf": [
            {
              "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 8192
        }
      }
    },
    "repair_assessments": {
      "type": "array",
      "items": {
        "$ref": "urn:af:schema:task-contracts:1#/$defs/repairAssessment"
      },
      "minItems": 1
    },
    "review_rounds": {
      "type": "array",
      "items": {
        "$ref": "urn:af:schema:task-review-round:1"
      }
    },
    "graph": {
      "$ref": "urn:af:schema:compiled-task:1"
    },
    "plan": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/executionPlan"
    },
    "owned_child_sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "artifact_type",
          "record"
        ],
        "properties": {
          "artifact_id": {
            "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
          },
          "artifact_type": {
            "const": "af/TaskOwnedChildSet@1"
          },
          "record": {
            "$ref": "urn:af:schema:task-owned-child-set:1"
          }
        }
      }
    },
    "review_handoffs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "artifact_type",
              "record"
            ],
            "properties": {
              "artifact_id": {
                "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
              },
              "artifact_type": {
                "const": "af/TaskReviewHandoff@1"
              },
              "record": {
                "$ref": "urn:af:schema:task-review-handoff:1"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "artifact_type",
              "record"
            ],
            "properties": {
              "artifact_id": {
                "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
              },
              "artifact_type": {
                "const": "af/TaskReviewHandoff@2"
              },
              "record": {
                "$ref": "urn:af:schema:task-review-handoff:2"
              }
            }
          }
        ]
      }
    },
    "review_integrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "artifact_type",
          "record",
          "node",
          "requires_checks",
          "finished",
          "report_id",
          "integration_committed_event_id"
        ],
        "properties": {
          "artifact_id": {
            "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
          },
          "artifact_type": {
            "const": "af/TaskReviewIntegrationPhase@1"
          },
          "record": {
            "$ref": "urn:af:schema:task-review-integration-phase:1"
          },
          "node": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(\\.[A-Za-z0-9][A-Za-z0-9_-]{0,127})*$"
          },
          "requires_checks": {
            "type": "boolean"
          },
          "finished": {
            "type": "boolean"
          },
          "report_id": {
            "oneOf": [
              {
                "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
              },
              {
                "type": "null"
              }
            ]
          },
          "integration_committed_event_id": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9]{26}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "record": {
                  "properties": {
                    "selection": {
                      "properties": {
                        "kind": {
                          "const": "prepared"
                        }
                      }
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "requires_checks": {
                  "const": true
                }
              }
            },
            "else": {
              "properties": {
                "requires_checks": {
                  "const": false
                },
                "finished": {
                  "const": true
                },
                "report_id": {
                  "type": "null"
                },
                "integration_committed_event_id": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "finished": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "report_id": {
                  "type": "null"
                },
                "integration_committed_event_id": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "requires_checks": {
                  "const": true
                },
                "finished": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "report_id": {
                  "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "integration_committed_event_id": {
                  "type": "string"
                }
              }
            },
            "then": {
              "properties": {
                "requires_checks": {
                  "const": true
                },
                "finished": {
                  "const": true
                },
                "report_id": {
                  "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
                }
              }
            }
          }
        ]
      }
    },
    "attempt_walls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "attempt_id",
          "node_id",
          "round",
          "epoch",
          "started_unix_ms",
          "elapsed_ms"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "attempt_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "node_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "round": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "epoch": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "started_unix_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "elapsed_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "usage": {
            "$ref": "urn:af:schema:task-runtime-evidence:1#/$defs/usage"
          }
        }
      }
    },
    "runtime_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "artifact_type",
          "record"
        ],
        "properties": {
          "artifact_id": {
            "$ref": "urn:af:schema:task-runtime-evidence:1#/$defs/digest"
          },
          "artifact_type": {
            "const": "af/TaskRuntimeEvidence@1"
          },
          "record": {
            "$ref": "urn:af:schema:task-runtime-evidence:1"
          }
        }
      }
    },
    "experiments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "artifact_id",
          "artifact_type",
          "record"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "prepared",
              "decision",
              "registered"
            ]
          },
          "artifact_id": {
            "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
          },
          "artifact_type": {
            "enum": [
              "af/ExperimentPrepared@1",
              "af/ExperimentPlanDecision@1",
              "af/ExperimentExecutionPlan@1"
            ]
          },
          "prepared_id": {
            "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
          },
          "decision_id": {
            "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
          },
          "record": {
            "oneOf": [
              {
                "$ref": "urn:af:schema:experiment-prepared:1"
              },
              {
                "$ref": "urn:af:schema:experiment-plan-decision:1"
              },
              {
                "$ref": "urn:af:schema:experiment-execution-plan:1"
              }
            ]
          }
        }
      }
    },
    "adoption_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "record",
          "task_evidence"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "record": {
            "$ref": "urn:af:schema:optimization-adoption-observation:1"
          },
          "task_evidence": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifact_id",
                "record"
              ],
              "properties": {
                "artifact_id": {
