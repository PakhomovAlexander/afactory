{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-check-layer:1",
  "title": "af/TaskCheckLayer@1",
  "description": "What a warm Task check node observed of its Warm Check Cache layer, retained beside its `af/TaskCheckReceipt@1` (ADR-0207), per local check that started: the key (`<project>/<toolchain>`), whether its lock was held at once, waited for, cloned around (`[warm] clone_when_busy`), busy for the whole wait, unavailable or without a key because the toolchain did not resolve; the holder it waited for; whether the layer held a build at the start (`warm`) or not (`cold`); how many source groups the content rule made stale and kept fresh; the build phase (until the check reported its `build` step) and the tests after it, against `[warm] build_wall_ms` (when the policy declares one; absent, the whole check had `check_wall_ms`) and `check_wall_ms`, with the phase whose deadline ended the check; and an eviction with its phase, cause and time. Recorded only under `[warm]`; it never decides a check's status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_id",
    "checks"
  ],
  "properties": {
    "receipt_id": {
      "$ref": "#/$defs/digest"
    },
    "checks": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
        "maxLength": 128
      },
      "additionalProperties": {
        "$ref": "#/$defs/run"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "wall": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*[^\\s\\u0000-\\u001f\\u007f-\\u009f][^\\u0000-\\u001f\\u007f-\\u009f]*$"
    },
    "phase": {
      "enum": [
        "build",
        "tests",
        "after"
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lock",
        "waited_ms",
        "start",
        "sources",
        "phases"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}/[0-9a-f]{64}$"
        },
        "lock": {
          "enum": [
            "held",
            "waited",
            "cloned",
            "busy",
            "unavailable",
            "unresolved"
          ]
        },
        "waited_ms": {
          "$ref": "#/$defs/ms"
        },
        "holder": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pid",
            "host",
            "since_unix_ms"
          ],
          "properties": {
            "pid": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            },
            "host": {
              "$ref": "#/$defs/text"
            },
            "since_unix_ms": {
              "$ref": "#/$defs/ms"
            }
          }
        },
        "start": {
          "enum": [
            "warm",
            "cold"
          ]
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stale",
            "fresh"
          ],
          "properties": {
            "stale": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "fresh": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          }
        },
        "phases": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "check_wall_ms",
            "elapsed_ms"
          ],
          "properties": {
            "build_wall_ms": {
              "$ref": "#/$defs/wall"
            },
            "check_wall_ms": {
              "$ref": "#/$defs/wall"
            },
            "build_ms": {
              "$ref": "#/$defs/ms"
            },
            "tests_ms": {
              "$ref": "#/$defs/ms"
            },
            "elapsed_ms": {
              "$ref": "#/$defs/ms"
            },
            "deadline": {
              "enum": [
                "build",
                "tests"
              ]
            }
          },
          "dependentRequired": {
            "tests_ms": [
              "build_ms"
            ]
          },
          "if": {
            "required": [
              "deadline"
            ]
          },
          "then": {
            "required": [
              "build_wall_ms"
            ]
          },
          "allOf": [
            {
              "if": {
                "required": [
                  "deadline"
                ],
                "properties": {
                  "deadline": {
                    "const": "tests"
                  }
                }
              },
              "then": {
                "required": [
                  "build_ms"
                ]
              }
            }
          ]
        },
        "evicted": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "by",
            "at_unix_ms"
          ],
          "properties": {
            "phase": {
              "$ref": "#/$defs/phase"
            },
            "by": {
              "enum": [
                "storage_sweep",
                "another_process",
                "bound",
                "suspect"
              ]
            },
            "at_unix_ms": {
              "$ref": "#/$defs/ms"
            }
          },
          "oneOf": [
            {
              "properties": {
                "phase": {
                  "const": "after"
                },
                "by": {
                  "enum": [
                    "bound",
                    "suspect"
                  ]
                }
              }
            },
            {
              "properties": {
                "phase": {
                  "enum": [
                    "build",
                    "tests"
                  ]
                },
                "by": {
                  "enum": [
                    "storage_sweep",
                    "another_process"
                  ]
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "lock": {
                "enum": [
                  "held",
                  "waited",
                  "cloned",
                  "busy"
                ]
              }
            }
          },
          "then": {
            "required": [
              "key"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "lock": {
                "const": "unresolved"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "key"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "holder"
            ]
          },
          "then": {
            "properties": {
              "lock": {
                "enum": [
                  "waited",
                  "cloned",
                  "busy"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
