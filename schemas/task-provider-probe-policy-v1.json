{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-provider-probe-policy:1",
  "title": "TaskProviderProbePolicy@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authority_policy_id",
    "execution",
    "credential_mode",
    "probe_protocol",
    "operations"
  ],
  "properties": {
    "authority_policy_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    },
    "execution": {
      "allOf": [
        {
          "$ref": "urn:af:schema:task-contracts:1#/$defs/workerExecution"
        },
        {
          "properties": {
            "kind": {
              "const": "model"
            }
          }
        }
      ]
    },
    "credential_mode": {
      "const": "brokered"
    },
    "probe_protocol": {
      "const": "af.provider-ok/1"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:af:schema:task-broker-binding:1#/$defs/operationPolicy"
      }
    }
  },
  "$comment": "Rust admission additionally checks unique operation names, checked aggregate operation authority, exact captured execution and the original Provider Attempt reservation."
}
