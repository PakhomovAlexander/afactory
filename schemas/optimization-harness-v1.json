{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:af:schema:optimization-harness:1","type":"object","additionalProperties":false,
  "required":["schema","oracle_id","checks","transitive_dependencies","candidate_writable_paths","cache_read_scopes","cache_write_scopes"],
  "properties":{"schema":{"const":"af.optimization-harness/1"},"oracle_id":{"$ref":"#/$defs/id"},"checks":{"$ref":"#/$defs/names"},"transitive_dependencies":{"$ref":"#/$defs/paths"},"candidate_writable_paths":{"$ref":"#/$defs/paths"},"cache_read_scopes":{"$ref":"#/$defs/paths"},"cache_write_scopes":{"$ref":"#/$defs/paths"}},
