{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-engine:4",
  "title": "Captured Task engine identity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "binary_digest",
    "version",
    "graph"
  ],
  "properties": {
    "schema": {
      "const": "af.task-engine/4"
    },
    "binary_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "graph": {
      "const": "af.compiled-task/6"
    }
  }
}
