{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:implementation-test-evidence:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "snapshot_id",
    "status",
    "reason",
    "commands"
  ],
  "properties": {
    "schema": {
      "const": "af/implementation-test-evidence@1"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "unavailable"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S",
      "not": {
        "pattern": "\\u0000"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "purpose",
          "command",
          "exit_code",
          "evidence"
        ],
        "properties": {
          "purpose": {
            "enum": [
              "build",
              "install",
              "test"
            ]
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S",
            "not": {
              "pattern": "\\u0000"
            }
          },
          "exit_code": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              }
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S",
            "not": {
              "pattern": "\\u0000"
            }
          }
        }
      },
      "maxItems": 32
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "commands": {
            "minItems": 3,
            "items": {
              "properties": {
                "exit_code": {
                  "const": 0
                }
              }
            },
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "purpose": {
                      "const": "build"
                    }
                  }
                }
              },
              {
                "contains": {
                  "properties": {
                    "purpose": {
                      "const": "install"
                    }
                  }
                }
              },
              {
                "contains": {
                  "properties": {
                    "purpose": {
                      "const": "test"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "title": "Implementation test evidence v1"
}
