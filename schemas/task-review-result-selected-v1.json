{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-review-result-selected:1",
  "title": "task-review-result-selected@1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_revision_id",
    "plan_id",
    "invocation_id",
    "output_id",
    "context_id",
    "result_envelope_id",
    "metadata_envelope_id",
    "result_artifact_id",
    "provenance_artifact_id",
    "task_id",
    "task_node"
  ],
  "properties": {
    "task_revision_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    },
    "plan_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    },
    "invocation_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    },
    "output_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    },
    "context_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    },
    "result_envelope_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    },
    "metadata_envelope_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    },
    "result_artifact_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    },
    "provenance_artifact_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
    },
    "task_id": {
      "$ref": "urn:af:schema:task-contracts:1#/$defs/name"
    },
    "task_node": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}(\\.[A-Za-z0-9][A-Za-z0-9_-]{0,127})*$"
    }
  }
}
