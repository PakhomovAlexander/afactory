{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:performance-comparison-aggregate:1",
  "title": "af.perf-comparison-aggregate/1",
  "description": "Independent performance executor: comparison-aggregate (ADR-0240).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "af.perf-comparison-aggregate/1"
    },
    "comparison_id": {
      "$ref": "#/$defs/id"
    },
    "comparison_digest": {
      "$ref": "#/$defs/digest"
    },
    "plan_sha256": {
      "$ref": "#/$defs/digest"
    },
    "builds_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/digest"
        }
      ]
    },
    "partitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "request_id": {
            "$ref": "#/$defs/id"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "claimed",
              "complete",
              "failed",
              "interrupted",
              "uncertain",
              "submitted",
              "expired"
            ]
          },
          "verification": {
            "type": "string",
            "enum": [
              "verified",
              "refused",
              "not_complete"
            ]
          },
          "result_sha256": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/digest"
              }
            ]
          },
          "shards": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true
          },
          "included": {
            "type": "boolean"
          },
          "detail": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "required": [
          "index",
          "request_id",
          "state",
          "verification",
          "result_sha256",
          "shards",
          "included",
          "detail"
        ]
      },
      "minItems": 1,
      "maxItems": 16
    },
    "verdict_sha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/digest"
        }
      ]
    },
    "result": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "incomplete"
          ]
        }
      ]
    },
    "coverage": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483648
            },
            "observed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483648
            },
            "failed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483648
            },
            "missing": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483648
            }
          },
          "required": [
            "required",
            "observed",
            "failed",
            "missing"
          ]
        }
      ]
    },
    "regressions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "created_unix_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740992
    }
  },
  "required": [
    "schema",
    "comparison_id",
    "comparison_digest",
    "plan_sha256",
    "builds_sha256",
    "partitions",
    "verdict_sha256",
    "result",
    "coverage",
    "regressions",
    "created_unix_ms"
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    }
  }
}
