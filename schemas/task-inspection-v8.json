{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "dependentRequired": {
    "graph": [
      "plan"
    ],
    "plan": [
      "graph"
    ],
    "delivery": [
      "result"
    ],
    "planning_diagnostic": [
      "result"
    ],
    "repair_assessments": [
      "result"
    ],
    "review_rounds": [
      "result"
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "properties": {
              "kind": {
                "const": "finished"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "result"
        ]
      },
      "else": {
        "not": {
          "required": [
            "result"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "graph"
        ]
      },
      "then": {
        "properties": {
          "plan_id": {
            "$ref": "urn:af:schema:task-contracts:1#/$defs/digest"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "history": {
            "contains": {
              "$ref": "urn:af:schema:task-inspection:7#/properties/history/items/oneOf/1"
            }
          }
        }
      },
      "then": {
        "required": ["review_integrations"]
      }
    }
  ],
  "required": [
    "schema",
    "task_id",
    "revision_id",
    "phase",
    "plan_id",
    "chargeable_tokens",
    "attempts",
    "history",
    "execution_records",
    "run_reports"
  ],
  "$id": "urn:af:schema:task-inspection:8",
  "title": "Task inspection af/task-inspection@8",
  "$comment": "Exact historical recording-recovery transition alongside frozen earlier histories. Optional owned-child, handoff and Integration histories keep their original shape; no Integration is implied by recording recovery.",
  "properties": {
    "schema": {
      "const": "af/task-inspection@8"
    },
    "task_id": {
      "$ref": "urn:af:schema:task-inspection:7#/properties/task_id"
    },
    "revision_id": {
      "$ref": "urn:af:schema:task-inspection:7#/properties/revision_id"
    },
    "phase": {
      "$ref": "urn:af:schema:task-inspection:7#/properties/phase"
    },
    "plan_id": {
      "$ref": "urn:af:schema:task-inspection:7#/properties/plan_id"
    },
    "chargeable_tokens": {
      "$ref": "urn:af:schema:task-inspection:7#/properties/chargeable_tokens"
    },
    "attempts": {
      "$ref": "urn:af:schema:task-inspection:7#/properties/attempts"
    },
    "selection": {
      "$ref": "urn:af:schema:task-inspection:7#/properties/selection"
    },
    "planning": {
      "$ref": "urn:af:schema:task-inspection:7#/properties/planning"
    },
    "plan_decisions": {
      "$ref": "urn:af:schema:task-inspection:7#/properties/plan_decisions"
    },
    "history": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "urn:af:schema:task-inspection:7#/properties/history/items"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sequence",
              "transition"
            ],
            "properties": {
              "sequence": {
                "$ref": "urn:af:schema:task-inspection:6#/properties/history/items/oneOf/1/properties/sequence"
              },
              "transition": {
                "$ref": "urn:af:schema:task-transition:4"
              }
            }
          }
        ]
      },
      "contains": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "transition"
        ],
        "properties": {
          "sequence": {
            "$ref": "urn:af:schema:task-inspection:6#/properties/history/items/oneOf/1/properties/sequence"
          },
          "transition": {
            "$ref": "urn:af:schema:task-transition:4"
          }
        }
      }
    },
    "execution_records": {
      "$ref": "urn:af:schema:task-inspection:7#/properties/execution_records"
    },
    "run_reports": {
      "$ref": "urn:af:schema:task-inspection:7#/properties/run_reports"
    },
    "delivery": {
      "$ref": "urn:af:schema:task-inspection:7#/properties/delivery"
    },
    "result": {
      "$ref": "urn:af:schema:task-inspection:7#/properties/result"
    },
    "planning_diagnostic": {
      "$ref": "urn:af:schema:task-inspection:7#/properties/planning_diagnostic"
    },
    "repair_assessments": {
      "$ref": "urn:af:schema:task-inspection:7#/properties/repair_assessments"
    },
    "review_rounds": {
      "$ref": "urn:af:schema:task-inspection:7#/properties/review_rounds"
    },
    "graph": {
      "$ref": "urn:af:schema:task-inspection:7#/properties/graph"
    },
    "plan": {
      "$ref": "urn:af:schema:task-inspection:7#/properties/plan"
    },
    "owned_child_sets": {
      "$ref": "urn:af:schema:task-inspection:7#/properties/owned_child_sets"
    },
    "review_handoffs": {
      "$ref": "urn:af:schema:task-inspection:7#/properties/review_handoffs"
    },
    "review_integrations": {
      "$ref": "urn:af:schema:task-inspection:7#/properties/review_integrations"
    }
  }
}
