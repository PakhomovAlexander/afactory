{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-wake-route-traversal:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "route_id",
    "extraction_after",
    "expires_unix_ms"
  ],
  "properties": {
    "schema": {
      "const": "af/task-wake-route-traversal@1"
    },
    "route_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    },
    "extraction_after": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "minLength": 71,
      "maxLength": 71
    },
    "expires_unix_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
