{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:scenario-impl-config:1",
  "title": "scenario-impl-config v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository",
    "repository_id",
    "actor",
    "token_file",
    "state_dir",
    "repo",
    "task_store",
    "worktree_root",
    "base",
    "branch_prefix",
    "source_commit",
    "source_content_digest",
    "af",
    "af_digest",
    "git",
    "git_digest",
    "ssh_config",
    "ssh_config_digest",
    "author_name",
    "author_email",
    "required_checks",
    "reviewers"
  ],
  "properties": {
    "schema": {
      "const": "af/scenario-impl-config@1"
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9_][A-Za-z0-9_.-]{0,99}$"
    },
    "repository_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "login"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "login": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})(?:\\[bot\\])?$"
        }
      }
    },
    "token_file": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/[^\\x00]+$"
    },
    "state_dir": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/[^\\x00]+$"
    },
    "repo": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/[^\\x00]+$"
    },
    "task_store": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/[^\\x00]+$"
    },
    "worktree_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/[^\\x00]+$"
    },
    "base": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "branch_prefix": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "source_commit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_content_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "af": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/[^\\x00]+$"
    },
    "af_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "git": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/[^\\x00]+$"
    },
    "git_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ssh_config": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/[^\\x00]+$"
    },
    "ssh_config_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "author_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "author_email": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "required_checks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "name",
              "app_id"
            ],
            "properties": {
              "kind": {
                "const": "check"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "app_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "context",
              "creator_id"
            ],
            "properties": {
              "kind": {
                "const": "status"
              },
              "context": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "creator_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            }
          }
        ]
      },
      "maxItems": 32,
      "uniqueItems": true,
      "minItems": 1
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "login"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "login": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})(?:\\[bot\\])?$"
          }
        }
      },
      "maxItems": 15,
      "uniqueItems": true
    }
  }
}
