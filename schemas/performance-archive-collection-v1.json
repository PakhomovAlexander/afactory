{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:performance-archive-collection:1",
  "title": "af.perf-archive-collection/1",
  "description": "One collection attempt of an archive (ADR-0172): its source, outcome, the run it collected, capacity when it was exhausted and every transport artifact it saw with its expiry.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "af.perf-archive-collection/1"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999999999999
    },
    "started_unix_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740992
    },
    "ended_unix_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740992
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "actions"
            },
            "repository": {
              "type": "string",
              "maxLength": 201,
              "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$"
            },
            "actions_run_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740992
            },
            "artifacts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740992
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  },
                  "created_unix_ms": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740992
                      }
                    ]
                  },
                  "expires_unix_ms": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740992
                      }
                    ]
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "downloaded",
                      "expired",
                      "refused",
                      "not_collected"
                    ]
                  },
                  "sha256": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "$ref": "#/$defs/digest"
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "name",
                  "size",
                  "created_unix_ms",
                  "expires_unix_ms",
                  "state",
                  "sha256"
                ]
              },
              "minItems": 0,
              "maxItems": 1000
            }
          },
          "required": [
            "kind",
            "repository",
            "actions_run_id",
            "artifacts"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "local"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "imported",
        "already_archived",
        "refused",
        "capacity_exhausted",
        "transport_failed"
      ]
    },
    "run_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/id"
        }
      ]
    },
    "run_ended_unix_ms": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740992
        }
      ]
    },
    "needed_bytes": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      ]
    },
    "available_bytes": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      ]
    },
    "detail": {
      "type": "string",
      "maxLength": 4096
    }
  },
  "required": [
    "schema",
    "sequence",
    "started_unix_ms",
    "ended_unix_ms",
    "source",
    "status",
    "run_id",
    "run_ended_unix_ms",
    "needed_bytes",
    "available_bytes",
    "detail"
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    }
  }
}
