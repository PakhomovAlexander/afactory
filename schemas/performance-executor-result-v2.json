    "required_check",
    "started_unix_ms",
    "ended_unix_ms",
    "evidence",
    "actions",
    "detail"
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "git_sha": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "relative_path": {
      "type": "string",
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    }
  }
