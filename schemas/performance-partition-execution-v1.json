{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:performance-partition-execution:1",
  "title": "af.perf-partition-execution/1",
  "description": "Independent performance executor: partition-execution (ADR-0240).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "af.perf-partition-execution/1"
    },
    "comparison_id": {
      "$ref": "#/$defs/id"
    },
    "plan_digest": {
      "$ref": "#/$defs/digest"
    },
    "builds_sha256": {
      "$ref": "#/$defs/digest"
    },
    "build_from": {
      "$ref": "#/$defs/id"
    },
    "build_run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "started_unix_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740992
        },
        "deadline_unix_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740992
        },
        "total_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 180
        }
      },
      "required": [
        "started_unix_ms",
        "deadline_unix_ms",
        "total_minutes"
      ]
    },
    "partitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15
          },
          "request_id": {
            "$ref": "#/$defs/id"
          },
          "shards": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true
          },
          "run": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "started_unix_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740992
              },
              "deadline_unix_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740992
              },
              "total_minutes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 180
              }
            },
            "required": [
              "started_unix_ms",
              "deadline_unix_ms",
              "total_minutes"
            ]
          }
        },
        "required": [
          "index",
          "request_id",
          "shards",
          "run"
        ]
      },
      "minItems": 1,
      "maxItems": 15
    }
  },
  "required": [
    "schema",
    "comparison_id",
    "plan_digest",
    "builds_sha256",
    "build_from",
    "build_run",
    "partitions"
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    }
  }
}
