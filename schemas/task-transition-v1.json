{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:schema:task-transition:1",
  "title": "TaskTransition@1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "writer",
    "epoch",
    "now_unix_ms",
    "change"
  ],
  "properties": {
    "writer": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "maxLength": 128
    },
    "epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "now_unix_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "change": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "revision_id",
            "lease_until_unix_ms"
          ],
          "properties": {
            "kind": {
              "const": "opened"
            },
            "revision_id": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "lease_until_unix_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "lease_until_unix_ms"
          ],
          "properties": {
            "kind": {
              "const": "lease_taken"
            },
            "lease_until_unix_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "lease_until_unix_ms"
          ],
          "properties": {
            "kind": {
              "const": "lease_renewed"
            },
            "lease_until_unix_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "revision_id"
          ],
          "properties": {
            "kind": {
              "const": "revision_recorded"
            },
            "revision_id": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "plan_id"
          ],
          "properties": {
            "kind": {
              "const": "plan_proposed"
            },
            "plan_id": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "decision_id",
            "valid_until_unix_ms"
          ],
          "properties": {
            "kind": {
              "const": "plan_decided"
            },
            "decision_id": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "valid_until_unix_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "decision_id",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "approval_revoked"
            },
            "decision_id": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 65536
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "plan_id"
          ],
          "properties": {
            "kind": {
              "const": "plan_admitted"
            },
            "plan_id": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reason"
          ],
          "properties": {
            "kind": {
              "const": "waiting"
            },
            "reason": {
              "enum": [
                "needs_input",
                "needs_human",
                "needs_plan_review"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "resumed",
                "lease_released"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "result_id"
          ],
          "properties": {
            "kind": {
              "const": "finished"
            },
            "result_id": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "record_id"
          ],
          "properties": {
            "kind": {
              "const": "execution_recorded"
            },
            "record_id": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "record_id"
          ],
          "properties": {
            "kind": {
              "const": "delivery_recorded"
            },
            "record_id": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      ]
    }
  }
}
