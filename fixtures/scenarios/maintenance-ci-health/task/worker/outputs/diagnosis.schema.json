{
  "additionalProperties": false,
  "properties": {
    "category": {
      "enum": [
        "transient",
        "product_bug",
        "test_bug",
        "ci_infra",
        "unknown"
      ]
    },
    "evidence": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "reference": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[^\\u0000]+$",
            "type": "string"
          },
          "snapshot_id": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "source_sha": {
            "pattern": "^[0-9a-f]{40}$",
            "type": "string"
          }
        },
        "required": [
          "snapshot_id",
          "source_sha",
          "reference"
        ],
        "type": "object"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "occurrence_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "rationale": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "^[^\\u0000]+$",
      "type": "string"
    },
    "schema": {
      "const": "af.ci-diagnosis/1"
    },
    "signature_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "snapshot_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "source_artifact_ids": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "source_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "snapshot_id",
    "source_artifact_ids",
    "occurrence_id",
    "signature_id",
    "source_sha",
    "category",
    "rationale",
    "evidence"
  ],
  "title": "Ci diagnosis v1",
  "type": "object"
}
