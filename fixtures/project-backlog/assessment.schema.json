{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:af:portable-project-backlog:assessment:1",
  "title": "Private Project backlog assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "batch_id", "source_revision", "decisions"],
  "properties": {
    "schema": { "const": "af/backlog-assessment@2" },
    "batch_id": { "$ref": "urn:af:schema:task-contracts:4#/$defs/digest" },
    "source_revision": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "decisions": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["members", "evidence_ids", "citations", "disposition", "claim", "reason", "tracked_id", "provider_match", "proposed"],
        "properties": {
          "members": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^(?:[a-zA-Z0-9_-]{1,64}|sha256:[0-9a-f]{64})$" }
          },
          "evidence_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "urn:af:schema:task-contracts:4#/$defs/digest" }
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "line": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "disposition": { "enum": ["verified", "already_tracked", "needs_evidence", "dismissed", "held"] },
          "claim": { "type": "string", "minLength": 1, "maxLength": 8192 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 8192 },
          "tracked_id": {
            "anyOf": [
              { "$ref": "urn:af:schema:task-contracts:4#/$defs/digest" },
              { "type": "null" }
            ]
          },
          "provider_match": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["issue_id", "quote"],
            "properties": {
              "issue_id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
              "quote": { "type": "string", "minLength": 1, "maxLength": 512 }
            }
          },
          "proposed": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["title", "body"],
            "properties": {
              "title": { "type": "string", "minLength": 1, "maxLength": 256 },
              "body": { "type": "string", "minLength": 1, "maxLength": 8192 }
            }
          }
        }
      }
    }
  }
}
