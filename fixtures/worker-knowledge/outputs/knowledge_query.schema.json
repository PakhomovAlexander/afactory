{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "index_id",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "af/KnowledgeQuery@1"
    },
    "index_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "entries": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 64,
      "items": {
