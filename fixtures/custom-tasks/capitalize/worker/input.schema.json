{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requirements",
    "note"
  ],
  "properties": {
    "requirements": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "artifact_type",
          "payload"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "artifact_type": {
            "const": "af/Requirements@1"
          },
          "payload": {
            "type": "object"
          }
        }
      },
      "minItems": 1
    },
    "note": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "artifact_type",
          "payload"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "artifact_type": {
            "const": "custom/Note@1"
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 256
              }
            }
          }
        }
      },
      "minItems": 1
    }
  }
}
