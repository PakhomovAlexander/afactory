{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_artifact_ids",
    "class",
    "size",
    "pipeline",
    "confidence",
    "rationale",
    "needs_info",
    "disposition",
    "source_identity",
    "adr"
  ],
  "properties": {
    "schema": {
      "const": "custom.issue-triage/2"
    },
    "source_artifact_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "class": {
      "enum": [
        null,
        "bug",
        "perf",
        "feature",
        "aix",
        "uix",
        "sdlc",
        "security",
        "docs",
        "research",
        "decision"
      ]
    },
    "size": {
      "enum": [
        null,
        "S",
        "M",
        "L",
        "XL"
      ]
    },
    "pipeline": {
      "enum": [
        null,
        "light",
        "default",
        "design",
        "hand"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rationale": {
      "type": "string",
      "maxLength": 4096
    },
    "needs_info": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "disposition": {
      "enum": [
        "proposed",
        "needs_info",
        "held"
      ]
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "captured_at",
        "body_sha256"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "maxLength": 128
        },
        "captured_at": {
          "type": "string",
          "maxLength": 64
        },
        "body_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "adr": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "proposed"
          }
        }
      },
      "then": {
        "properties": {
          "class": {
            "type": "string",
            "not": {
              "const": "security"
            }
          },
          "size": {
            "type": "string"
          },
          "pipeline": {
            "type": "string"
          },
          "confidence": {
            "minimum": 0.6
          },
          "needs_info": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "needs_info"
          }
        }
      },
      "then": {
        "properties": {
          "class": {
            "type": "null"
          },
          "size": {
            "type": "null"
          },
          "pipeline": {
            "type": "null"
          },
          "needs_info": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "held"
          }
        }
      },
      "then": {
        "properties": {
          "size": {
            "type": "null"
          },
          "pipeline": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "class": {
            "const": "security"
          }
        }
      },
      "then": {
        "properties": {
          "disposition": {
            "const": "held"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "size": {
            "const": "S"
          }
        }
      },
      "then": {
        "properties": {
          "pipeline": {
            "const": "light"
          },
          "adr": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "size": {
            "const": "M"
          }
        }
      },
      "then": {
        "properties": {
          "pipeline": {
            "const": "default"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "size": {
            "enum": [
              "L",
              "XL"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "pipeline": {
            "const": "design"
          }
        }
      }
    }
  ]
}
