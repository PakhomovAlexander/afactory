{
  "required": [
    "verdict",
    "summary",
    "reports",
    "benchmark_demands",
    "dispositions"
  ],
  "properties": {
    "verdict": {
      "enum": [
        "approve",
        "request-changes",
        "block"
      ]
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "file",
          "title",
          "body",
          "fix"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "file": {
                  "enum": [
                    "",
                    "(change-wide)"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "line": {
                  "type": "null"
                }
              }
            }
          }
        ],
        "properties": {
          "severity": {
            "enum": [
              "blocker",
              "major",
              "minor"
            ]
          },
          "file": {
            "type": "string",
            "anyOf": [
              {
                "enum": [
                  "",
                  "(change-wide)"
                ]
              },
              {
                "allOf": [
                  {
                    "pattern": "^(?:[^/.\\u0000][^/\\u0000]*|\\.[^./\\u0000][^/\\u0000]*|\\.\\.[^/\\u0000][^/\\u0000]*)(?:/(?:[^/.\\u0000][^/\\u0000]*|\\.[^./\\u0000][^/\\u0000]*|\\.\\.[^/\\u0000][^/\\u0000]*))*$"
                  },
                  {
                    "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
                  }
                ]
              }
            ]
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 4294967295
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "fix": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "rule_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.]*/[^/@]+@[^/@]+$"
          },
          "occurrence_key": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "benchmark_demands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim",
          "why",
          "suggested_method"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "suggested_method": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "position",
          "reason"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "position": {
            "enum": [
              "corroborate",
              "not_reproduced",
              "dispute"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    }
  },
  "title": "ReviewerResult@2 payload",
  "description": "Additive reviewer result contract with one explicit disposition for every assigned prior Finding. Assignment coverage is checked against the exact input FindingSet@1 by the kernel.",
  "type": "object",
  "additionalProperties": false
}