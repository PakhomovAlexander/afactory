+        let p = Prepared {
+            schema: "af/scenario-impl-prepared@1".into(),
+            owner: digest(b"owner"),
+            previous_owner: None,
+            config_digest: digest(b"machine"),
+            repository: "octo/project".into(),
+            repository_id: 17,
